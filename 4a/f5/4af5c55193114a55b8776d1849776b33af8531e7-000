// 2026-09-11: Render independent layers and verify the final composition.
const fs = require('fs');
const path = require('path');
const { chromium } = require('/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/node_modules/playwright');
(async () => {
 const root=path.resolve(__dirname,'..');
 const config=JSON.parse(fs.readFileSync(path.join(root,'_params.json'),'utf8'));
 const browser=await chromium.launch({headless:true});
 const page=await browser.newPage({viewport:{width:config.canvas.width,height:config.canvas.height},deviceScaleFactor:config.canvas.scale});
 const errors=[];page.on('pageerror',e=>errors.push(e.message));
 await page.goto('file://'+root+'/infographic.html');await page.evaluate(()=>document.fonts.ready);
 const report=await page.evaluate(()=>{
  const canvas=document.querySelector('.canvas').getBoundingClientRect();
  const overflow=[...document.querySelectorAll('.layer,.grid,p,h1,h2,.result')].filter(el=>{const r=el.getBoundingClientRect();return r.bottom>canvas.bottom||r.right>canvas.right||el.scrollWidth>el.clientWidth+1||el.scrollHeight>el.clientHeight+1}).map(el=>el.textContent);
  return {overflow,fonts:[...document.fonts].map(f=>({family:f.family,status:f.status})),size:{width:canvas.width,height:canvas.height}};
 });
 if(report.overflow.length) throw new Error(JSON.stringify(report));
 fs.mkdirSync(root+'/assets/layers',{recursive:true});
 const layers=await page.locator('.layer').all();const boxes=[];
 for(let i=0;i<layers.length;i++){
  const box=await layers[i].boundingBox();const file=String(i+1).padStart(2,'0')+'-layer.png';
  await layers[i].screenshot({path:root+'/assets/layers/'+file,omitBackground:true});
  boxes.push({...box,file});
 }
 // Compose only the independently rendered assets at their measured positions.
 const images=boxes.map(b=>`<img alt="" src="assets/layers/${b.file}" style="position:absolute;left:${b.x}px;top:${b.y}px;width:${b.width}px;height:${b.height}px">`).join('');
 fs.writeFileSync(root+'/composition.html',`<!doctype html><meta charset="utf-8"><link rel="stylesheet" href="tokens.css"><style>body{margin:0;background:var(--paper);width:var(--width);height:var(--height)}</style>${images}`);
 await page.goto('file://'+root+'/composition.html');await page.evaluate(()=>Promise.all([...document.images].map(im=>im.decode())));
 await page.screenshot({path:root+'/out/01-roadmap.png'});
 report.layers=boxes.length;report.errors=errors;report.output={width:config.canvas.width*config.canvas.scale,height:config.canvas.height*config.canvas.scale,bytes:fs.statSync(root+'/out/01-roadmap.png').size};
 fs.writeFileSync(root+'/verification.json',JSON.stringify(report,null,2));
 console.log(JSON.stringify(report));await browser.close();
})().catch(e=>{console.error(e);process.exit(1)});
