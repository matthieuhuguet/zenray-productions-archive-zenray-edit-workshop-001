}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font: 400 14px/1.45 var(--font-ui); }
button, input { font: inherit; }
button { color: inherit; }
.page { width: min(1640px, calc(100% - 56px)); margin: 0 auto; padding: 44px 0 72px; }
.topline { display: flex; justify-content: space-between; align-items: center; gap: 18px; color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
.date { font-family: var(--font-title); font-size: 12px; letter-spacing: 0; text-transform: none; color: var(--ink); }
h1 { max-width: 950px; margin: 18px 0 8px; font: 400 clamp(38px, 5vw, 68px)/.98 var(--font-title); letter-spacing: -.035em; }
.lead { max-width: 840px; margin: 0; color: #514d46; font: 400 16px/1.55 var(--font-body); }
.note { margin: 12px 0 0; color: var(--muted); font: 400 12px/1.5 var(--font-body); }
.num { font-family: var(--font-title); font-variant-numeric: lining-nums; }
.summary { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 24px; }
.pill { display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px; border: 1px solid var(--line); border-radius: 99px; background: rgba(255,253,248,.7); color: var(--muted); font-size: 12px; }
.pill strong { color: var(--ink); font-weight: 400; }
.toolbar { display: grid; grid-template-columns: minmax(220px, 1.3fr) minmax(260px, 1.7fr) auto; align-items: end; gap: 12px; margin: 0 0 16px; padding: 14px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,253,248,.75); }
.control { min-width: 0; }
.control label { display: block; margin: 0 0 6px; color: var(--muted); font-size: 11px; }
.search, .sample-input { width: 100%; height: 38px; border: 1px solid var(--line); border-radius: 9px; padding: 0 11px; outline: 0; background: var(--surface); color: var(--ink); }
.search:focus, .sample-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(169,103,67,.12); }
.size-row { display: flex; align-items: center; gap: 9px; height: 38px; }
.size-row input { width: 100%; accent-color: var(--accent); }
.size-value { min-width: 44px; text-align: right; color: var(--muted); font: 400 13px var(--font-title); }
.filters { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }
.filter { min-height: 36px; padding: 0 11px; border: 1px solid var(--line); border-radius: 9px; background: transparent; color: var(--muted); cursor: pointer; white-space: nowrap; }
.filter[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--surface); }
.filter .num { margin-left: 4px; }
.results { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 0 2px 10px; color: var(--muted); font-size: 12px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: var(--card-gap); align-items: start; }
.card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--card-radius); background: var(--surface); box-shadow: 0 4px 16px rgba(43,37,27,.035); }
.card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; padding: 14px 15px 10px; border-bottom: 1px solid var(--line); }
.family-name { overflow-wrap: anywhere; font-size: 13px; font-weight: 500; }
.tag { flex: none; color: var(--muted); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
.specimen { padding: 15px 15px 12px; font-family: var(--sample-font), serif; font-weight: 400; }
.specimen-main { min-height: 74px; font-size: var(--sample-size); line-height: 1.13; overflow-wrap: anywhere; }
.specimen-detail { padding-top: 9px; color: #5f5a52; font-size: 15px; line-height: 1.35; overflow-wrap: anywhere; }
.card-foot { display: flex; flex-direction: column; gap: 4px; padding: 10px 15px 13px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; }
.file { font: 10px/1.4 var(--font-code); overflow-wrap: anywhere; }
.variants { display: flex; flex-direction: column; gap: 0; padding: 0 15px; }
.variant { padding: 11px 0 12px; border-bottom: 1px solid var(--line); }
.variant:last-child { border-bottom: 0; }
.variant-label { margin: 0 0 6px; color: var(--muted); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
.variant .specimen { padding: 0; }
.variant .specimen-main { min-height: 0; font-size: 24px; }
.variant .specimen-detail { padding-top: 5px; font-size: 13px; }
.empty { grid-column: 1/-1; padding: 36px; border: 1px dashed var(--line); border-radius: 14px; text-align: center; color: var(--muted); font-family: var(--font-body); }
footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px 24px; margin-top: 22px; padding-top: 13px; border-top: 1px solid var(--line); color: var(--muted); font-size: 11px; }
footer .source { font-family: var(--font-code); }
@media (max-width: 900px) { .toolbar { grid-template-columns: 1fr 1fr; } .filters { grid-column: 1/-1; justify-content: flex-start; } }
@media (max-width: 600px) { .page { width: min(100% - 28px, 520px); padding-top: 26px; } .topline { align-items: flex-start; } .toolbar { grid-template-columns: 1fr; } .filters { grid-column: auto; } h1 { font-size: 42px; } }
</style>
</head>
<body>
