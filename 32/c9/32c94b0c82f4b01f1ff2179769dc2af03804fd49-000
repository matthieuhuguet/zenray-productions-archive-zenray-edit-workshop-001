y dog.", "detail": "AaBbCc   0123456789   € @ &", "language": "en", "direction": "ltr", "variants": []}, {"name": "Anthropic Sans", "cssFamily": "AnthropicSans", "group": "extra", "manufacturer": "BSPK LLC", "file": "AnthropicSans-Regular.ttf", "sample": "The quick brown fox jumps over the lazy dog.", "detail": "AaBbCc   0123456789   € @ &", "language": "en", "direction": "ltr", "variants": []}, {"name": "Anthropic Mono", "cssFamily": "AnthropicMono", "group": "extra", "manufacturer": "BSPK LLC", "file": "AnthropicMono-Regular.ttf", "sample": "const type = \"clear\";", "detail": "AaBbCc   0123456789   {} []", "language": "en", "direction": "ltr", "variants": []}];
const FILTER_LABELS = { all: 'familles affichées', gt: 'familles Grilli Type affichées', extra: 'familles de comparaison affichées' };
const elements = {
  search: document.getElementById('searchInput'),
  sample: document.getElementById('sampleInput'),
  size: document.getElementById('sizeInput'),
  sizeOutput: document.getElementById('sizeOutput'),
  grid: document.getElementById('fontGrid'),
  resultCount: document.getElementById('resultCount'),
};
let activeFilter = 'all';
function createSpecimen(variant, editable) {
  const box = document.createElement('div');
  box.className = 'specimen';
  box.style.setProperty('--sample-font', JSON.stringify(variant.cssFamily));
  const primary = document.createElement('div');
  primary.className = 'specimen-main';
  primary.lang = variant.language || 'en';
  primary.dir = variant.direction || 'ltr';
  primary.dataset.defaultText = variant.sample;
  primary.dataset.editable = editable ? 'true' : 'false';
  primary.textContent = editable && elements.sample.value ? elements.sample.value : variant.sample;
  const detail = document.createElement('div');
  detail.className = 'specimen-detail';
  detail.lang = variant.language || 'en';
  detail.dir = variant.direction || 'ltr';
  detail.textContent = variant.detail;
  box.append(primary, detail);
  return box;
}
function createCard(font) {
  const card = document.createElement('article');
  card.className = 'card';
  card.dataset.group = font.group;
  const head = document.createElement('div');
  head.className = 'card-head';
  const name = document.createElement('div');
  name.className = 'family-name';
  name.textContent = font.name;
  const tag = document.createElement('div');
  tag.className = 'tag';
  tag.textContent = font.group === 'gt' ? 'Grilli Type' : 'Comparaison';
  head.append(name, tag);
  card.append(head);
  const mainVariant = { cssFamily: font.cssFamily, sample: font.sample, detail: font.detail, language: font.language, direction: font.direction };
  card.append(createSpecimen(mainVariant, true));
  if (font.variants.length) {
    const variants = document.createElement('div');
    variants.className = 'variants';
    for (const variant of font.variants) {
      const item = document.createElement('div');
      item.className = 'variant';
      const label = document.createElement('div');
      label.className = 'variant-label';
      label.textContent = variant.label;
      item.append(label, createSpecimen(variant, false));
      variants.append(item);
    }
    card.append(variants);
  }
  const foot = document.createElement('div');
  foot.className = 'card-foot';
  const maker = document.createElement('span');
  maker.textContent = font.manufacturer;
  const file = document.createElement('span');
  file.className = 'file';
  file.textContent = font.file;
  foot.append(maker, file);
  for (const variant of font.variants) {
    const variantFile = document.createElement('span');
    variantFile.className = 'file';
    variantFile.textContent = variant.file;
    foot.append(variantFile);
  }
  card.append(foot);
  return card;
}
function render() {
  const query = elements.search.value.trim().toLowerCase();
  const visible = FONT_DATA.filter(font => {
    const filterMatch = activeFilter === 'all' || font.group === activeFilter;
    const searchMatch = !query || JSON.stringify(font).toLowerCase().includes(query);
    return filterMatch && searchMatch;
  });
  elements.grid.replaceChildren(...visible.map(createCard));
  elements.resultCount.textContent = `${visible.length} ${FILTER_LABELS[activeFilter]}`;
  const customText = elements.sample.value.trim();
  for (const specimen of elements.grid.querySelectorAll('[data-editable="true"]')) {
    specimen.textContent = customText || specimen.dataset.defaultText;
  }
}
document.querySelector('.filters').addEventListener('click', event => {
  const button = event.target.closest('[data-filter]');
  if (!button) return;
  activeFilter = button.dataset.filter;
  document.querySelectorAll('[data-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
  render();
});
elements.search.addEventListener('input', render);
elements.sample.addEventListener('input', render);
elements.size.addEventListener('input', () => {
  document.documentElement.style.setProperty('--sample-size', `${elements.size.value}px`);
  elements.sizeOutput.textContent = `${elements.size.value} px`;
});
render();
</script>
</body>
