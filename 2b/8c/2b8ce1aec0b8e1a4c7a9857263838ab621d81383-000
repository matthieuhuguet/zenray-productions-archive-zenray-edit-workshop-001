#!/usr/bin/env python3
"""Plafonne le poids de photos a la crete autorisee par Instagram, et rien d'autre.

CONSIGNE MATTHIEU (2026-08-06), non negociable :
  - une seule contrainte, le poids maximal, 8 Mo par photo ;
  - AUCUNE autre transformation : pas de redimensionnement, pas de conversion
    d'espace colorimetrique, pas de changement de sous-echantillonnage chroma,
    pas de passage en WebP, pas de qualite fixee a la main ;
  - un fichier deja sous la crete est copie a l'identique, octet pour octet ;
  - les originaux ne sont jamais touches, la sortie va dans un sous-dossier.

Un JPEG n'a pas de debit, seulement un poids, et le seul moyen de le faire baisser
est de re-quantifier. ImageMagick vise directement la taille cible avec
`-define jpeg:extent`, en cherchant lui-meme le palier de quantification le plus
haut qui tienne sous la crete. Le sous-echantillonnage de l'original est releve puis
re-impose, sans quoi ImageMagick applique son propre defaut ; les metadonnees et le
profil couleur sont conserves, aucun -strip n'est employe.

Usage :
    python3 instagram_maxq.py <dossier_source> [--max-mb 8] [--out instagram] [--jobs 16]
"""

import argparse
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

EXTENSIONS = {".jpg", ".jpeg", ".png", ".tif", ".tiff", ".heic"}


def sampling_of(path):
    out = subprocess.run(
        ["magick", "identify", "-format", "%[jpeg:sampling-factor]", str(path)],
        capture_output=True, text=True,
    ).stdout.strip()
    return out or None


def dimensions_of(path):
    out = subprocess.run(
        ["magick", "identify", "-format", "%wx%h", str(path)],
        capture_output=True, text=True,
    ).stdout.strip()
    return out


def process(job):
    src, out_dir, max_bytes = job
    dst = out_dir / src.name
    before = src.stat().st_size

    if before <= max_bytes:                      # deja sous la crete, copie exacte
        shutil.copy2(src, dst)
        return {"src": src.name, "before": before, "after": dst.stat().st_size,
                "px": dimensions_of(src), "touched": False}

    cmd = ["magick", str(src)]
    sampling = sampling_of(src)
    if sampling:                                 # re-imposer le chroma de l'original
        cmd += ["-sampling-factor", sampling]
    cmd += ["-define", f"jpeg:extent={max_bytes}", str(dst)]
    subprocess.run(cmd, check=True)

    return {"src": src.name, "before": before, "after": dst.stat().st_size,
            "px": dimensions_of(dst), "touched": True}


def mb(n):
    return f"{n / 1024 / 1024:.2f} Mo"


def main():
    p = argparse.ArgumentParser()
    p.add_argument("source")
    p.add_argument("--max-mb", type=float, default=8.0,
                   help="crete de poids par photo, limite Instagram")
    p.add_argument("--out", default="instagram")
    p.add_argument("--jobs", type=int, default=16)
    a = p.parse_args()

    src_dir = Path(a.source).expanduser().resolve()
    out_dir = src_dir / a.out
    out_dir.mkdir(exist_ok=True)

    files = sorted(f for f in src_dir.iterdir()
                   if f.is_file() and f.suffix.lower() in EXTENSIONS)
    if not files:
        sys.exit(f"aucune image dans {src_dir}")

    max_bytes = int(a.max_mb * 1024 * 1024)
    with ThreadPoolExecutor(max_workers=a.jobs) as pool:
        results = list(pool.map(process, [(f, out_dir, max_bytes) for f in files]))

    print(f"{'fichier':<12}{'pixels':<14}{'avant':>10}{'apres':>10}{'crete':>9}  etat")
    for r in sorted(results, key=lambda r: r["src"]):
        pct = 100 * r["after"] / max_bytes
        etat = "recompresse" if r["touched"] else "copie a l'identique"
        print(f"{r['src']:<12}{r['px']:<14}{mb(r['before']):>10}{mb(r['after']):>10}"
              f"{pct:>8.1f}%  {etat}")
    print(f"\n{len(results)} photos dans {out_dir}")


if __name__ == "__main__":
    main()
