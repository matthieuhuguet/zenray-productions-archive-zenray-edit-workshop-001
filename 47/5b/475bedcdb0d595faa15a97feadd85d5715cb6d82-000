  --sleep-width: 360px;
  --sleep-height: 96px;
  --sleep-dock-gap: 8px;
  --sleep-padding: 14px;
  --sleep-header-height: 22px;
  --sleep-row-gap: 10px;
  --sleep-radius: 16px;
  --sleep-header-size: 12px;
  --sleep-title-size: 16px;
