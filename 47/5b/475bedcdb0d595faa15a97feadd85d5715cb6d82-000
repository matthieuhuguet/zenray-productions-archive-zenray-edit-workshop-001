  height: 96,
  dockGap: 8,
  padding: 14,
  headerHeight: 22,
  rowGap: 10,
  radius: 16,
  headerSize: 12,
  titleSize: 16,
  bodyWeight: 400,
  buttonDiameter: 30,
  buttonIconSize: 13,
  accent: '#0a84ff',
  moon: '#8b78ff'
} as const;
```

