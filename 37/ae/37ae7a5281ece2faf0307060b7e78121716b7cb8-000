  <script>
    // ── Live State ──
    const state = {
      uiFont: 'GT Ultra',
      numberFont: 'GT Ultra',
      numberWeight: 400,
      terminalVariant: 'minimal',
      terminalExpanded: true
    };

    // ── Presets Definition ──
    const presets = {
      'pure-ultra': {
        ui: 'GT Ultra',
        num: 'GT Ultra',
        weight: 400,
        term: 'minimal'
      },
      'ultra-standard': {
        ui: 'GT Ultra',
        num: 'GT Standard L',
        weight: 400,
        term: 'minimal'
      },
      'america-tech': {
        ui: 'GT America',
        num: 'GT America',
        weight: 400,
        term: 'pipeline'
      },
      'sectra-editorial': {
        ui: 'GT Sectra',
        num: 'GT Sectra',
        weight: 400,
        term: 'minimal'
      },
      'pressura-hud': {
        ui: 'GT Pressura',
        num: 'GT Pressura',
        weight: 400,
        term: 'console'
      },
      'cinetype-mono': {
        ui: 'GT Cinetype',
        num: 'GT Cinetype',
        weight: 400,
        term: 'console'
      }
    };

    function applyPreset(key) {
      document.querySelectorAll('.preset-card').forEach(c => c.classList.remove('active'));
      event.currentTarget.classList.add('active');

      const p = presets[key];
      if (!p) return;

      state.uiFont = p.ui;
      state.numberFont = p.num;
      state.numberWeight = p.weight;
      state.terminalVariant = p.term;

      document.getElementById('uiFontSelect').value = p.ui;
      document.getElementById('numberFontSelect').value = (p.ui === p.num) ? 'harmonized' : p.num;

      // Update weight buttons
      document.querySelectorAll('#weightControl .seg-btn').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.includes(String(p.weight)));
      });

      // Update terminal cards
      setTerminalVariant(p.term);

      applyStyles();
    }

    function updateCustomFont() {
      // Clear preset selection
      document.querySelectorAll('.preset-card').forEach(c => c.classList.remove('active'));

      const uiVal = document.getElementById('uiFontSelect').value;
      const numVal = document.getElementById('numberFontSelect').value;

      state.uiFont = uiVal;
      state.numberFont = (numVal === 'harmonized') ? uiVal : numVal;

      applyStyles();
    }

    function setWeight(w) {
      state.numberWeight = w;
      document.querySelectorAll('#weightControl .seg-btn').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.includes(String(w)));
      });
      applyStyles();
    }

    function setTerminalVariant(variant) {
      state.terminalVariant = variant;
      document.querySelectorAll('.terminal-choice-card').forEach(c => c.classList.remove('active'));
      const activeCard = document.getElementById('termChoice-' + variant);
      if (activeCard) activeCard.classList.add('active');
      renderTerminal();
      updateJson();
    }

    function toggleTerminal() {
      state.terminalExpanded = !state.terminalExpanded;
      const box = document.getElementById('terminalBox');
      const icon = document.getElementById('termIcon');
      const text = document.getElementById('termBtnText');

      if (state.terminalExpanded) {
        box.classList.remove('collapsed');
        icon.textContent = '▾';
        text.textContent = 'replier';
      } else {
        box.classList.add('collapsed');
        icon.textContent = '▸';
        text.textContent = 'terminal';
      }
    }

    function renderTerminal() {
      const box = document.getElementById('terminalBox');
      box.className = 'terminal-box terminal-style-' + state.terminalVariant;
      if (!state.terminalExpanded) box.classList.add('collapsed');

      if (state.terminalVariant === 'minimal') {
        box.innerHTML = `
          <div class="term-head">
            <span class="term-title">⌘ File Git & Commandes</span>
            <span class="term-badge">1 en cours · 44 en attente</span>
          </div>
          <div class="term-cmd">$ git -C ~/Create/.../ZenRay-Edit add . &amp;&amp; git commit</div>
          <div class="term-phase">↳ Transfert des shards LFS en cours…</div>
          <div class="term-queue-item">1. [archive] ZenRay Assets Tube View</div>
          <div class="term-queue-item">2. [archive] ZenRayPostKit</div>
          <div class="term-queue-item">3. [archive] Vegatations Assets ZenRay Collection 01</div>
          <div class="term-queue-item">4. [archive] ZenRay Motion Design</div>
          <div class="term-queue-item">5. [archive] ZenRay Plan</div>
          <div class="term-queue-more">   ... +39 autres projets en file</div>
        `;
      } else if (state.terminalVariant === 'pipeline') {
        box.innerHTML = `
          <div class="pipeline-steps">
            <div class="pipeline-step done">
              <span style="font-weight: 600;">1. Nettoyage ✓</span>
              <span style="opacity: 0.8;">Branches locales</span>
            </div>
            <div class="pipeline-step active">
              <span style="font-weight: 600;">2. Shards LFS ⚡</span>
              <span style="opacity: 0.8;">Transfert 928 KB/s</span>
            </div>
            <div class="pipeline-step pending">
              <span style="font-weight: 600;">3. Push Cloud</span>
              <span style="opacity: 0.8;">En attente de relai</span>
            </div>
          </div>
          <div class="pipeline-details">
            <span style="color: var(--accent-purple);">$ git lfs push --all origin main</span>
            <span style="color: var(--accent-orange);">44 en file d'attente</span>
          </div>
        `;
      } else if (state.terminalVariant === 'console') {
        box.innerHTML = `
          <div class="console-header">
            <div class="traffic-dots">
              <span class="traffic-dot td-red"></span>
              <span class="traffic-dot td-yellow"></span>
              <span class="traffic-dot td-green"></span>
            </div>
            <span class="console-title">zsh · Assets Fallback Daemon (PID 12854)</span>
          </div>
          <div class="console-body">
            <div><span class="console-line-time">[01:32:04]</span><span class="console-line-cmd">$ git -C ~/Create/.../ZenRay-Edit status</span></div>
            <div><span class="console-line-time">[01:32:06]</span><span class="console-line-info">lfs: uploading 2 large blobs (17.4 MB)</span></div>
            <div><span class="console-line-time">[01:32:10]</span><span style="color:#C9D1D9;">gdrive: runner sync 12 MB/s · fallback actif</span></div>
            <div style="color: var(--accent-orange); margin-top: 4px;">↳ 44 projets en file de relai séquentiel</div>
          </div>
        `;
      }
    }

    function applyStyles() {
      const root = document.documentElement;
      root.style.setProperty('--ui-font', `'${state.uiFont}', -apple-system, BlinkMacSystemFont, sans-serif`);
      root.style.setProperty('--number-font', `'${state.numberFont}', -apple-system, BlinkMacSystemFont, sans-serif`);
      root.style.setProperty('--number-weight', state.numberWeight);

      updateJson();
    }

    function updateJson() {
      // Resolve exact Swift PostScript font names
      const fontMap = {
        'GT Ultra': 'GTUltra-Regular',
        'GT Standard L': 'GTStandardL-Regular',
        'GT America': 'GT-America-LCGV-Standard-Regular',
        'GT Alpina': 'GT-Alpina-Standard-Regular',
        'GT Cinetype': 'GT-Cinetype-Regular',
        'GT Pressura': 'GT-Pressura-LCGV-Standard-Regular',
        'GT Sectra': 'GT-Sectra-LCGV-Regular',
        'GT Flexa': 'GT-Flexa-Standard-Regular',
        'GT Maru': 'GT-Maru-Regular',
        'GT Planar': 'GT-Planar-Regular',
        'GT Walsheim': 'GT-Walsheim-LC-Regular',
        'GT Zirkon': 'GT-Zirkon-Regular',
        'GT Canon L': 'GT-Canon-L-Standard-Regular'
      };

      const out = {
        fontName: fontMap[state.uiFont] || state.uiFont,
        serifFontName: fontMap[state.numberFont] || state.numberFont,
        numberWeight: state.numberWeight,
        terminalStyle: state.terminalVariant === 'minimal' ? 'minimal-hud' : state.terminalVariant === 'pipeline' ? 'queue-pipeline' : 'cli-console'
      };

      document.getElementById('jsonOutput').textContent = JSON.stringify(out, null, 2);
    }

    function setTab(btn, scope) {
      document.querySelectorAll('.filter-tabs .tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const tiles = document.querySelectorAll('.project-tile');
      tiles.forEach(tile => {
        if (scope === 'all') tile.style.display = 'flex';
        else if (scope === 'mac') tile.style.display = (tile.dataset.mac > 0) ? 'flex' : 'none';
        else if (scope === 'github') tile.style.display = (tile.dataset.gh > 0) ? 'flex' : 'none';
        else if (scope === 'gdrive') tile.style.display = (tile.dataset.gd > 0) ? 'flex' : 'none';
      });
    }

    function copyConfig() {
      const code = document.getElementById('jsonOutput').textContent;
      navigator.clipboard.writeText(code).then(() => {
        const toast = document.getElementById('toast');
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      });
    }

    // Initial Render
    renderTerminal();
    applyStyles();
  </script>
</body>
</html>
