.btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 99px; background: var(--ink); color: var(--bg); }
.pathbar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 8px 12px; border-radius: 9px; background: var(--hover); margin-bottom: 12px; }
.pathbar .serif { font-size: 15px; }
.pathbar .sep { color: var(--ink-3); }

/* ===== 4. SOURCES ===== */
.shelf { margin-top: 22px; }
.shelf h3 { font: 350 18px var(--zr-police-serif); display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; }
.shelf h3 small { font: 400 var(--small) var(--zr-police-sans); color: var(--ink-2); }
.row { display: grid; grid-auto-flow: column; grid-auto-columns: 132px; gap: 12px; overflow-x: auto; padding-bottom: 6px; }
.split { display: grid; grid-template-columns: 190px 1fr; gap: 22px; }
.side { border-right: 1px solid var(--line); padding-right: 14px; }
.side .lbl { font-size: 11px; color: var(--ink-3); margin: 4px 8px 6px; }
