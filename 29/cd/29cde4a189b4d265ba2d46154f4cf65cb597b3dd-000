.ring-wrap { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 4px 10px 4px 4px; border-radius: 99px; background: var(--hover); cursor: pointer; }
.ring-pop { position: absolute; top: calc(100% + 8px); left: 0; width: 280px; padding: 12px; border-radius: 12px; background: var(--surface); box-shadow: 0 18px 40px -12px rgb(0 0 0 / .35); z-index: 5; display: none; }
.ring-wrap:hover .ring-pop, .ring-wrap:focus-within .ring-pop { display: block; }
.ring-pop .r { display: grid; grid-template-columns: 10px 1fr auto; gap: 8px; align-items: center; padding: 5px 0; }
.ring-pop .bar { grid-column: 2 / -1; height: 3px; border-radius: 3px; background: var(--hover); overflow: hidden; } .ring-pop .bar i { display: block; height: 100%; }
