<aside class="panel closed" id="panel"></aside>
<script>
// 12 October 2026: definition = render functions; interface = PARAMS, SOURCES, FILES; instances = 4 topics x 3 proposals.
const PARAMS = {
  Layout: [['--file-min', 'Taille des icônes', 90, 260, 1, 'px'], ['--gap', 'Espacement', 2, 40, 1, 'px'], ['--radius', 'Arrondi', 0, 24, 1, 'px'], ['--row-h', 'Hauteur de ligne', 24, 56, 1, 'px'], ['--col-w', 'Largeur des colonnes', 160, 320, 1, 'px']],
  Type: [['--ui', 'Interface', 11, 16, 0.5, 'px'], ['--serif-title', 'Titre du projet', 18, 44, 1, 'px'], ['--folder-serif', 'Nom du dossier', 13, 28, 0.5, 'px']],
  Storage: [['--bar-h', 'Épaisseur de la barre', 2, 16, 1, 'px'], ['--ring', 'Taille de l’anneau', 18, 48, 1, 'px']],
  Colour: [['--accent-h', 'Teinte d’accent', 0, 360, 1, '']],
}
// Sources: technical id, plain-language name, what it holds, colour token.
const SOURCES = [
  { id: 'tmp', label: 'TMP', plain: 'Brouillons', what: 'travail en cours, essais, captures', color: 'var(--c-tmp)' },
  { id: 'memory', label: 'Memory', plain: 'Notes', what: 'feedback, décisions, règles', color: 'var(--c-memory)' },
  { id: 'houdini', label: 'Houdini', plain: 'Scènes Houdini', what: 'fichiers .hip, HDA, rendus', color: 'var(--c-houdini)' },
  { id: 'unreal', label: 'Unreal', plain: 'Jeu', what: 'contenu Unreal du projet', color: 'var(--c-unreal)' },
  { id: 'cloud', label: 'Cloud', plain: 'Archive', what: 'déjà sauvegardé, absent du Mac', color: 'var(--c-cloud)' },
]
const PROJECT = { name: 'Roof Tiles, Copernicus to Unreal Short', slug: 'roof-tiles-copernicus-short' }
// Mock inventory shaped like the real Roof Tiles project (names seen in the live view).
const RAW = [
  ['tmp', 'workshop/scripts/BuildLookDevCyclorama.py', 18e3], ['tmp', 'workshop/scripts/BuildLookDevDenseMesh.py', 21e3], ['tmp', 'workshop/scripts/BuildRoofTilesV2.py', 64e3], ['tmp', 'workshop/scripts/ColorZoneStats.py', 9e3], ['tmp', 'workshop/scripts/CompareHeightAligned.py', 12e3], ['tmp', 'workshop/scripts/LayerWalkthroughRoofTilesV2.py', 15e3],
  ['tmp', 'workshop/captures/houdini_graph_tidy.png', 2.4e6], ['tmp', 'workshop/captures/houdini_layers_walkthrough.mov', 182e6], ['tmp', 'workshop/captures/layers_full_window.mov', 96e6], ['tmp', 'workshop/captures/layers_viewer_1x.mov', 54e6], ['tmp', 'workshop/captures/layers_viewer_2x.mov', 61e6],
  ['tmp', 'workshop/renders/lookdev_unreal_dense_60cm.png', 5.1e6], ['tmp', 'workshop/renders/lookdev_unreal_disp_8cm_cam.png', 4.8e6], ['tmp', 'workshop/renders/lookdev_unreal_disp_8cm.png', 4.6e6], ['tmp', 'workshop/renders/lookdev_unreal_mma_60cm.png', 5.3e6], ['tmp', 'workshop/renders/turntable_2k.mp4', 240e6],
  ['memory', 'FEEDBACK.md', 41e3], ['memory', 'Rules.md', 3e3], ['memory', 'Project1.md', 22e3],
  ['houdini', 'scenes/roof_tiles_v012.hiplc', 88e6], ['houdini', 'scenes/roof_tiles_v013.hiplc', 91e6], ['houdini', 'otls/zr_roof_tiles.hda', 3.2e6], ['houdini', 'maps/height_4k.exr', 64e6], ['houdini', 'maps/basecolor_4k.png', 38e6], ['houdini', 'maps/normal_4k.png', 41e6],
  ['unreal', 'Content/RoofTiles/M_RoofTiles.uasset', 2.1e6], ['unreal', 'Content/RoofTiles/SM_RoofPanel.uasset', 14e6], ['unreal', 'Content/RoofTiles/T_Height.uasset', 22e6], ['unreal', 'Content/RoofTiles/SM_RoofPanel.fbx', 9e6],
  ['cloud', 'archive/short_edit_v03.mp4', 310e6], ['cloud', 'archive/comparison_sheet.png', 6e6],
]
const KIND = n => /\.(png|jpe?g|exr)$/i.test(n) ? 'image' : /\.(mov|mp4)$/i.test(n) ? 'video' : /\.(md|txt)$/i.test(n) ? 'doc' : /\.(py)$/i.test(n) ? 'code' : /\.(hiplc|hip|hda|fbx|uasset)$/i.test(n) ? '3d' : 'other'
const FILES = RAW.map(([src, path, size], i) => ({ id: i, src, path, size, name: path.split('/').pop(), kind: KIND(path), hue: (i * 37 + 18) % 360, pending: i % 9 === 4 }))
const SRC = Object.fromEntries(SOURCES.map(s => [s.id, s]))
const bytes = b => b >= 1e9 ? (b / 1e9).toFixed(1).replace('.', ',') + ' Go' : b >= 1e6 ? Math.round(b / 1e6) + ' Mo' : Math.max(1, Math.round(b / 1e3)) + ' Ko'
const total = FILES.reduce((a, f) => a + f.size, 0)
const bySrc = SOURCES.map(s => ({ ...s, files: FILES.filter(f => f.src === s.id) })).map(s => ({ ...s, size: s.files.reduce((a, f) => a + f.size, 0) })).filter(s => s.files.length)

// Thumbnail: the shape tells the type (same language as the live Tube view).
function thumb(f, cls = '') {
  if (f.kind === 'image') return `<div class="thumb ${cls}"><div class="art" style="background:linear-gradient(135deg,hsl(${f.hue} 35% 55%),hsl(${(f.hue + 30) % 360} 30% 28%)),repeating-linear-gradient(90deg,#0000 0 7px,#fff1 7px 9px);background-blend-mode:overlay"></div></div>`
  if (f.kind === 'video') return `<div class="thumb ${cls}"><div class="art" style="background:linear-gradient(160deg,hsl(${f.hue} 25% 30%),#111)"></div><span class="play"></span></div>`
  if (f.kind === '3d') return `<div class="thumb ${cls}"><div class="g"><svg width="40%" viewBox="0 0 100 100"><path d="M50 14 84 32v36L50 86 16 68V32z M50 50 84 32 M50 50v36 M50 50 16 32" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg></div></div>`
  const tag = f.name.split('.').pop().toUpperCase()
  return `<div class="thumb ${cls}"><div class="g"><span class="page">${tag}</span></div></div>`
}
const head = (extra = '') => `<div class="p-title">${PROJECT.name}</div><div class="p-meta"><span class="num">${FILES.length}</span> fichiers · <span class="num">24 September 2026</span>${extra}</div>`

// ===== Topic 1: storage, compact, at the top =====
const storageBar = () => `<div class="stbar">${bySrc.map(s => `<span title="${s.plain} ${bytes(s.size)}" style="flex:${s.size};background:${s.color}"></span>`).join('')}</div>`
function ring() {
  let off = 0, r = 15.9
  const segs = bySrc.map(s => { const p = s.size / total * 100, seg = `<circle r="${r}" cx="18" cy="18" fill="none" stroke="${s.color}" stroke-width="5" pathLength="100" stroke-dasharray="${p - .8} ${100 - p + .8}" stroke-dashoffset="${-off}" transform="rotate(-90 18 18)"/>`; off += p; return seg }).join('')
  return `<svg width="var(--ring)" viewBox="0 0 36 36" style="width:var(--ring);height:var(--ring)">${segs}</svg>`
}
const STORAGE = [
  ['A · Barre de stockage', 'Comme « Stockage » dans Réglages de macOS : une barre fine sous le titre, survol = détail, clic = filtre.',
    () => `${head()}${storageBar()}<div class="stlegend">${bySrc.map(s => `<span><i class="dot" style="background:${s.color}"></i>${s.plain} <span class="num">${bytes(s.size)}</span></span>`).join('')}<span style="margin-left:auto"><span class="num">${bytes(total)}</span> au total</span></div>`],
  ['B · Anneau discret', 'Un petit anneau à côté du nombre de fichiers. Le détail n’apparaît qu’au survol, la page reste vide de chiffres.',
    () => `<div class="p-title">${PROJECT.name}</div><div class="p-meta" style="display:flex;align-items:center;gap:12px;margin-top:10px"><span class="ring-wrap" tabindex="0">${ring()}<span class="num">${bytes(total)}</span><div class="ring-pop">${bySrc.map(s => `<div class="r"><i class="dot" style="background:${s.color}"></i><span>${s.plain} <small style="color:var(--ink-3)">${s.files.length}</small></span><span class="num">${bytes(s.size)}</span><span class="bar"><i style="width:${s.size / total * 100}%;background:${s.color}"></i></span></div>`).join('')}</div></span><span><span class="num">${FILES.length}</span> fichiers · <span class="num">24 September 2026</span></span></div>`],
  ['C · Filtres qui pèsent', 'L’espace et les filtres ne font qu’un : chaque source est un bouton avec sa taille et une jauge colorée en bas.',
    () => `${head()}<div class="chips" style="margin-top:16px">${[{ plain: 'Tout', size: total, color: 'var(--ink)', files: FILES, on: 1 }, ...bySrc].map(s => `<button class="gchip ${s.on ? 'on' : ''}"><b>${s.plain}</b><small><span class="num">${s.files.length}</span> · <span class="num">${bytes(s.size)}</span></small><i style="width:${s.size / total * 100}%;background:${s.color}"></i></button>`).join('')}</div>`],
]

// ===== Topic 2: icon / list / columns / gallery, three macOS-inspired families =====
const VIEW_ICONS = {
  icons: '<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1.5"/><rect x="9" y="1" width="6" height="6" rx="1.5"/><rect x="1" y="9" width="6" height="6" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx="1.5"/></svg>',
  list: '<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="2" width="14" height="2" rx="1"/><rect x="1" y="7" width="14" height="2" rx="1"/><rect x="1" y="12" width="14" height="2" rx="1"/></svg>',
  columns: '<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="2" width="14" height="12" rx="2"/><path d="M6 2v12M10.5 2v12"/></svg>',
  gallery: '<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="14" height="9" rx="1.5"/><rect x="1" y="12" width="4" height="3" rx="1"/><rect x="6" y="12" width="4" height="3" rx="1"/><rect x="11" y="12" width="4" height="3" rx="1"/></svg>',
}
const VIEW_LABELS = { icons: 'Icônes', list: 'Liste', columns: 'Colonnes', gallery: 'Galerie' }
const state = { side: 'all', view: 'icons', sheet: false, topic: 'storage', views: { 0: 'icons', 1: 'icons', 2: 'icons' }, colPath: { 0: ['tmp', 'workshop', 'renders'], 1: ['tmp', 'workshop', 'renders'], 2: ['tmp', 'workshop', 'renders'] }, gal: 12, srcA: 'all', colFile: {} }
function renderView(view, i) {
  const fs = VIEW_FILES
  if (view === 'icons') return `<div class="v-icons">${fs.map(f => `<div>${thumb(f)}<div class="fname">${f.name}</div></div>`).join('')}</div>`
  if (view === 'list') return `<div class="v-list"><div class="lr h"><span></span><span>Nom</span><span>Emplacement</span><span>Modifié</span><span>Taille</span></div>${fs.map((f, k) => `<div class="lr ${k === 2 ? 'sel' : ''}"><span class="mini">${thumb(f)}</span><span class="name">${f.name}</span><span><i class="dot" style="background:${SRC[f.src].color}"></i> ${SRC[f.src].plain}</span><span class="num">24 Sep</span><span class="num">${bytes(f.size)}</span></div>`).join('')}</div>`
  if (view === 'columns') {
    const path = state.colPath[i]
    const level = (prefix) => { const kids = new Map(); VIEW_FILES.filter(f => [f.src, ...f.path.split('/')].slice(0, prefix.length).join('/') === prefix.join('/')).forEach(f => { const parts = [f.src, ...f.path.split('/')]; const k = parts[prefix.length]; if (k) kids.set(k, parts.length > prefix.length + 1 ? 'dir' : f) }); return [...kids] }
    const cols = [[]].concat(path.map((_, d) => path.slice(0, d + 1)))
    const leaves = level(path).filter(([, v]) => v !== 'dir').map(([, v]) => v)
    const leafFile = leaves.find(f => f.id === state.colFile[i]) || leaves[0]
    return `<div class="v-cols">${cols.map((pre, d) => `<div class="c">${level(pre).map(([k, v]) => `<div class="ci ${path[d] === k || (v !== 'dir' && state.colFile[i] === v.id) ? 'on' : ''}" data-col="${i}" data-depth="${d}" data-key="${k}" ${v !== 'dir' ? `data-leaf="${v.id}"` : ''}>${v === 'dir' ? (d === 0 ? `<i class="dot" style="background:${SRC[k].color}"></i>${SRC[k].plain}` : `📁 ${k}`) : k}${v === 'dir' ? '<span class="chev">›</span>' : ''}</div>`).join('')}</div>`).join('')}<div class="preview">${leafFile ? `${thumb(leafFile)}<div>${leafFile.name}</div><small class="num">${bytes(leafFile.size)}</small>` : 'Choisis un dossier'}</div></div>`
  }
  const cur = FILES[state.gal]
  return `<div class="v-gal"><div class="stage"><div class="art" style="background:linear-gradient(135deg,hsl(${cur.hue} 35% 50%),hsl(${(cur.hue + 30) % 360} 30% 18%))"></div></div><div class="cap"><span>${cur.name}</span><span><i class="dot" style="background:${SRC[cur.src].color}"></i> ${SRC[cur.src].plain} · <span class="num">${bytes(cur.size)}</span></span></div><div class="strip">${VIEW_FILES.map(f => `<div data-gal="${f.id}">${thumb(f, f.id === state.gal ? 'on' : '')}</div>`).join('')}</div></div>`
}
const VIEWS = [
  ['A · Finder', 'Fidèle au Finder : segmenté gris, lignes alternées, sélection bleue système, noms centrés sous les icônes.', 'fam-finder'],
  ['B · Photos', 'Inspiré de Photos : barre de vue en verre, icônes collées en mosaïque sans nom, grandes vignettes en liste.', 'fam-photos'],
  ['C · Silencieux', 'Sans cadre : les vues sont des mots soulignés d’orange, noms en serif dans la liste, arrondis généreux.', 'fam-quiet'],
]
const viewsBlock = (i, fam) => `<div class="${fam}"><div class="toolbar"><div class="search">⌕ Rechercher un fichier</div><div class="seg">${Object.keys(VIEW_ICONS).map(v => `<button class="${state.views[i] === v ? 'on' : ''}" data-view="${v}" data-i="${i}" title="${VIEW_LABELS[v]}">${fam === 'fam-quiet' ? VIEW_LABELS[v] : VIEW_ICONS[v]}</button>`).join('')}</div></div>${renderView(state.views[i], i)}</div>`

// ===== Topic 3: how the folder looks once downloaded =====
function tree() {
  const root = {}
  FILES.forEach(f => { let n = root; [SRC[f.src].label, ...f.path.split('/')].forEach((p, k, a) => { n = n[p] ??= k === a.length - 1 ? f : {} }) })
  return root
}
const sizeOf = n => n.size !== undefined && typeof n.size === 'number' && n.name ? n.size : Object.values(n).reduce((a, c) => a + sizeOf(c), 0)
const countOf = n => n.name ? 1 : Object.values(n).reduce((a, c) => a + countOf(c), 0)
function treeRows(node, depth, openDepth) {
  return Object.entries(node).map(([k, v]) => v.name ? `<div class="tr" style="padding-left:${depth * 18}px"><span class="tw"></span>${thumb(v).replace('class="thumb ', 'style="width:18px;height:18px;border-radius:4px" class="thumb ')}<span>${k}</span><span class="sz num">${bytes(v.size)}</span></div>`
    : `<div class="tr folder" style="padding-left:${depth * 18}px"><span class="tw">${depth < openDepth ? '▾' : '▸'}</span>📁 <span class="n">${k}</span><span class="sz"><span class="num">${countOf(v)}</span> · <span class="num">${bytes(sizeOf(v))}</span></span></div>${depth < openDepth ? treeRows(v, depth + 1, openDepth) : ''}`).join('')
}
const T = tree()
const DOWNLOAD = [
  ['A · Arbre Finder', 'La liste du Finder avec triangles. Le dossier racine et les sous-dossiers en serif, les fichiers en sans.',
    () => `<div class="tree"><div class="tr folder"><span class="tw">▾</span>📁 <span class="rootname">tmp-${PROJECT.slug}</span><span class="sz"><span class="num">${FILES.length}</span> · <span class="num">${bytes(total)}</span></span></div>${treeRows(T, 1, 2)}</div>`],
  ['B · Carte du ZIP', 'Avant de télécharger, une carte montre le dossier qui arrivera dans Téléchargements, avec ses sous-dossiers.',
    () => `<div class="zipcard"><div class="zipicon"><span class="tab"></span><span class="back"></span><span class="front"></span></div><div><div class="rootname" style="font-size:calc(var(--folder-serif) * 1.5)">tmp-${PROJECT.slug}</div><div class="p-meta"><span class="num">${FILES.length}</span> fichiers · <span class="num">${bytes(total)}</span> · arrive dans <span class="mono">~/Downloads</span></div><div class="subs">${Object.entries(T).map(([k, v]) => `<div class="sub"><span class="serif">${k}</span><small><span class="num">${countOf(v)}</span> fichiers · <span class="num">${bytes(sizeOf(v))}</span></small></div>`).join('')}</div><div style="margin-top:16px"><button class="btn">↓ Télécharger le dossier</button></div></div></div>`],
  ['C · Barre de chemin', 'Comme la barre de chemin du Finder (⌥⌘P) : le chemin complet en serif en haut, les fichiers dessous en colonnes.',
    () => `<div class="pathbar">💻 <span>Téléchargements</span><span class="sep">›</span>📁 <span class="serif">tmp-${PROJECT.slug}</span><span class="sep">›</span><span class="serif">TMP</span><span class="sep">›</span><span class="serif">workshop</span><span class="sep">›</span><span class="serif">renders</span></div>${renderView('columns', 0)}`],
]

// ===== Topic 4: sources (Cloud, TMP, Memory, Houdini, Unreal) =====
const SOURCES_P = [
  ['A · Filtres en mots simples', 'On garde les filtres, mais renommés selon leur usage et seulement ceux que le projet utilise. Sans Unreal, pas de bouton Unreal.',
    () => { const fs = state.srcA === 'all' ? FILES : FILES.filter(f => f.src === state.srcA); return `<div class="chips"><button class="chip ${state.srcA === 'all' ? 'on' : ''}" data-src="all">Tout <span class="num">${FILES.length}</span></button>${bySrc.map(s => `<button class="chip ${state.srcA === s.id ? 'on' : ''}" data-src="${s.id}" title="${s.label} : ${s.what}"><i class="dot" style="background:${s.color}"></i>${s.plain} <span class="num">${s.files.length}</span></button>`).join('')}</div><div class="v-icons" style="margin-top:16px">${fs.slice(0, 12).map(f => `<div>${thumb(f)}<div class="fname">${f.name}</div></div>`).join('')}</div><p class="note">Au survol, le nom technique reste visible : « Brouillons » = TMP.</p>` }],
  ['B · Étagères par source', 'Pas de filtre du tout : la page Tout montre une rangée par source, comme YouTube. Une source vide ne crée pas de rangée.',
    () => bySrc.map(s => `<div class="shelf"><h3><i class="dot" style="background:${s.color}"></i>${s.plain}<small>${s.what} · <span class="num">${s.files.length}</span> · <span class="num">${bytes(s.size)}</span></small><small style="margin-left:auto">Tout voir ›</small></h3><div class="row">${s.files.map(f => `<div>${thumb(f)}<div class="fname">${f.name}</div></div>`).join('')}</div></div>`).join('')],
  ['C · Barre latérale Finder', 'Une petite barre « Emplacements » à gauche, comme le Finder. Les sources absentes sont grisées, et elle disparaît s’il n’y en a qu’une.',
    () => `<div class="split"><div class="side"><div class="lbl">Emplacements</div><button class="on">◎ Tout <span class="ct num">${FILES.length}</span></button>${SOURCES.map(s => { const n = FILES.filter(f => f.src === s.id).length; return `<button class="${n ? '' : 'off'}"><i class="dot" style="background:${s.color}"></i>${s.plain}<span class="ct num">${n || ''}</span></button>` }).join('')}<div class="lbl" style="margin-top:14px">Récents</div><button>🕘 Modifiés cette semaine</button><button>☁︎ Pas encore sauvegardés</button></div><div><div class="v-icons">${FILES.slice(0, 12).map(f => `<div>${thumb(f)}<div class="fname">${f.name}</div></div>`).join('')}</div></div></div>`],
]


let VIEW_FILES = FILES
function page() {
  const files = state.side === 'all' ? FILES : FILES.filter(f => f.src === state.side)
  VIEW_FILES = files
  if (state.side !== 'all' && state.colPath[0][0] !== state.side) state.colPath[0] = [state.side]
  const ringA = `<span class="ring-wrap" tabindex="0">${ring()}<span class="num">${bytes(total)}</span><div class="ring-pop">${bySrc.map(s => `<div class="r"><i class="dot" style="background:${s.color}"></i><span>${s.plain} <small style="color:var(--ink-3)">${s.files.length}</small></span><span class="num">${bytes(s.size)}</span><span class="bar"><i style="width:${s.size / total * 100}%;background:${s.color}"></i></span></div>`).join('')}</div></span>`
  const barA = `<div class="bar-wrap"><div class="stbar">${bySrc.map(s => `<span data-side="${s.id}" title="${s.plain} ${bytes(s.size)}" style="flex:${s.size};background:${s.color};opacity:${state.side === 'all' || state.side === s.id ? 1 : .3}"></span>`).join('')}</div><div class="stlegend">${bySrc.map(s => `<span data-side="${s.id}"><i class="dot" style="background:${s.color}"></i>${s.plain} <span class="num">${bytes(s.size)}</span></span>`).join('')}</div></div>`
  const side = `<div class="side"><div class="lbl">Emplacements</div><button class="${state.side === 'all' ? 'on' : ''}" data-side="all">◎ Tout <span class="ct num">${FILES.length}</span></button>${SOURCES.map(s => { const n = FILES.filter(f => f.src === s.id).length; return `<button class="${n ? '' : 'off'} ${state.side === s.id ? 'on' : ''}" ${n ? `data-side="${s.id}"` : 'disabled'} title="${s.label} : ${s.what}"><i class="dot" style="background:${s.color}"></i>${s.plain}<span class="ct num">${n || ''}</span></button>` }).join('')}</div>`
  const tools = `<div class="toolbar"><div class="search">⌕ Rechercher un fichier</div><div class="seg">${Object.keys(VIEW_ICONS).map(v => `<button class="${state.view === v ? 'on' : ''}" data-v="${v}" title="${VIEW_LABELS[v]}">${VIEW_ICONS[v]}</button>`).join('')}</div><button class="dl" data-sheet="1">↓ Télécharger</button></div>`
  const sheet = !state.sheet ? '' : `<div class="sheet-back" data-sheet="0"><div class="sheet" data-stop="1"><button class="close" data-sheet="0">Fermer</button>${DOWNLOAD[1][2]()}<div class="tree"><div class="tr folder"><span class="tw">▾</span>📁 <span class="rootname">tmp-${PROJECT.slug}</span><span class="sz"><span class="num">${FILES.length}</span> · <span class="num">${bytes(total)}</span></span></div>${treeRows(T, 1, 2)}</div></div></div>`
  return `<div class="window proj fam-finder"><div class="crumb"><span>‹ Projets</span><span>Classique · <b style="font-weight:400;color:var(--ink)">Tube</b></span></div><div class="p-title">${PROJECT.name}</div><div class="p-meta"><span class="num">${FILES.length}</span> fichiers · <span class="num">24 September 2026</span> · 3D</div><div class="storage-row">${ringA}${barA}</div><div class="split">${side}<div>${tools}${renderView(state.view, 0)}</div></div></div>${sheet}`
}
function render() { document.getElementById('app').innerHTML = page() }
document.addEventListener('click', e => {
  if (e.target.closest('[data-stop]') && !e.target.closest('[data-sheet]')) return
  const t = e.target.closest('[data-side],[data-v],[data-sheet],[data-col],[data-gal]'); if (!t) return
  if (t.dataset.side) state.side = t.dataset.side
  else if (t.dataset.v) state.view = t.dataset.v
  else if (t.dataset.sheet) state.sheet = t.dataset.sheet === '1'
  else if (t.dataset.leaf) state.colFile[t.dataset.col] = +t.dataset.leaf
  else if (t.dataset.col) { const i = t.dataset.col, d = +t.dataset.depth; state.colPath[i] = [...state.colPath[i].slice(0, d), t.dataset.key]; delete state.colFile[i] }
  else if (t.dataset.gal) state.gal = +t.dataset.gal
  render()
})

// Parameter panel: writes only :root variables, copy line for the prompt.
const root = document.documentElement, panel = document.getElementById('panel')
const css = getComputedStyle(root)
panel.innerHTML = `<header><strong>Paramètres</strong><span><button id="theme">◐</button> <button id="fold">+</button></span></header><div class="body">${Object.entries(PARAMS).map(([cat, list]) => `<h4>${cat}</h4>${list.map(([v, l, mn, mx, st, u]) => { const val = parseFloat(css.getPropertyValue(v)); return `<label>${l}<output id="o${v}">${val}${u}</output><input type="range" min="${mn}" max="${mx}" step="${st}" value="${val}" data-var="${v}" data-unit="${u}"></label>` }).join('')}`).join('')}<button class="copy" id="copy">Copier les valeurs pour le prompt</button></div>`
panel.addEventListener('input', e => { const s = e.target.closest('[data-var]'); if (!s) return; root.style.setProperty(s.dataset.var, s.value + s.dataset.unit); document.getElementById('o' + s.dataset.var).textContent = s.value + s.dataset.unit })
panel.addEventListener('click', e => {
  if (e.target.id === 'fold') { panel.classList.toggle('closed'); e.target.textContent = panel.classList.contains('closed') ? '+' : '–' }
  if (e.target.id === 'theme') root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark'
  if (e.target.id === 'copy') { navigator.clipboard?.writeText(':root { ' + [...panel.querySelectorAll('[data-var]')].map(s => `${s.dataset.var}: ${s.value}${s.dataset.unit}`).join('; ') + ' }'); e.target.textContent = 'Copié' }
})
render()
</script>
