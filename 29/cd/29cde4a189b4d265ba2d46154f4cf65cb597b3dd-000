.thumb .play { position: absolute; right: 8px; bottom: 8px; border-style: solid; border-width: 5px 0 5px 9px; border-color: transparent transparent transparent #fff; filter: drop-shadow(0 1px 2px rgb(0 0 0 / .5)); }
.fname { margin-top: 7px; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

