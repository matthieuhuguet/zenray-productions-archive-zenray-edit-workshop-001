.panel { position: fixed; right: 14px; bottom: 14px; width: 270px; z-index: 60; padding: 12px 14px; border-radius: 14px; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); box-shadow: 0 20px 60px -20px rgb(0 0 0 / .35); font-size: 12px; max-height: 70vh; overflow: auto; }
.panel.closed .body { display: none; }
.panel header { display: flex; justify-content: space-between; }
