.panel label { display: grid; grid-template-columns: 1fr 56px; color: var(--ink-2); margin: 4px 0; }
.panel input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
.panel output { text-align: right; color: var(--ink); }
.panel .copy { width: 100%; margin-top: 10px; padding: 8px; border-radius: 9px; background: var(--ink); color: var(--bg); }
@media (max-width: 760px) { body { padding: 70px 16px 80px; } .split, .zipcard { grid-template-columns: 1fr; } .side { border-right: 0; } .v-list .lr { grid-template-columns: 28px 1fr 70px; } .v-list .lr span:nth-child(3), .v-list .lr span:nth-child(4) { display: none; } }

/* Assembled page (12 October 2026) */
body.assembled { padding-top: 32px; }
.proj { max-width: 1240px; margin: 0 auto; }
.crumb { color: var(--ink-2); margin-bottom: 12px; display: flex; justify-content: space-between; }
.storage-row { display: flex; align-items: center; gap: 16px; margin: 14px 0 22px; }
.storage-row .bar-wrap { flex: 1; min-width: 0; }
.storage-row .stbar { margin-top: 0; cursor: pointer; }
.storage-row .stlegend span[data-src] { cursor: pointer; }
.proj .split { grid-template-columns: 180px 1fr; }
.proj .toolbar { margin-top: 0; }
.dl { margin-left: auto; display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 8px; background: var(--hover); }
.sheet-back { position: fixed; inset: 0; background: rgb(0 0 0 / .28); display: grid; place-items: start center; padding-top: 6vh; z-index: 40; }
.sheet { width: min(720px, calc(100% - 32px)); max-height: 84vh; overflow: auto; background: var(--surface); border-radius: 16px; box-shadow: 0 30px 80px -20px rgb(0 0 0 / .5); padding: 24px 26px; }
.sheet .tree { margin-top: 22px; border-top: 1px solid var(--line); padding-top: 14px; }
