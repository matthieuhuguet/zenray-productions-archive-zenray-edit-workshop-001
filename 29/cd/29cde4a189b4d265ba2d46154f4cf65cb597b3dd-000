.v-icons { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--file-min), 1fr)); gap: var(--gap); }
.v-list { border-radius: 10px; overflow: hidden; }
.v-list .lr { display: grid; grid-template-columns: 28px 1fr 120px 90px 70px; gap: 12px; align-items: center; height: var(--row-h); padding: 0 10px; }
