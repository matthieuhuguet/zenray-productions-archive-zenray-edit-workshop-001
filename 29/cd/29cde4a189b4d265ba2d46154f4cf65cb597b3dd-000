.fam-quiet .seg { background: none; gap: 2px; } .fam-quiet .seg button { width: auto; padding: 0 10px; font-size: 12px; } .fam-quiet .seg button.on { box-shadow: none; background: none; color: var(--ink); text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
.fam-quiet .v-icons .thumb { border-radius: 16px; } .fam-quiet .v-list .lr:hover { background: var(--hover); border-radius: 8px; }
.fam-quiet .v-list .lr .name { font-family: var(--zr-police-serif); font-weight: 350; font-size: 14px; }

/* ===== 3. DOWNLOAD TREE ===== */
.rootname { font: 350 var(--folder-serif)/1.2 var(--zr-police-serif); }
.tree .tr { display: flex; align-items: center; gap: 8px; padding: 4px 0; }
.tree .tr .tw { width: 12px; color: var(--ink-3); font-size: 10px; }
.tree .tr .sz { margin-left: auto; color: var(--ink-2); }
.tree .tr.folder .n { font-family: var(--zr-police-serif); font-weight: 350; font-size: 15px; }
.zipcard { display: grid; grid-template-columns: 120px 1fr; gap: 24px; align-items: center; }
.zipicon { width: 120px; aspect-ratio: 1.15; position: relative; }
.zipicon .back { position: absolute; inset: 10% 0 0 0; border-radius: 10px; background: linear-gradient(#7fb3f0, #5a95e0); }
.zipicon .tab { position: absolute; left: 0; top: 2%; width: 42%; height: 18%; border-radius: 8px 8px 0 0; background: #6fa6ea; }
.zipicon .front { position: absolute; inset: 22% 0 0 0; border-radius: 10px; background: linear-gradient(#a8cdf7, #78acee); }
.subs { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; margin-top: 14px; }
.sub { padding: 10px 12px; border-radius: 10px; background: var(--hover); }
