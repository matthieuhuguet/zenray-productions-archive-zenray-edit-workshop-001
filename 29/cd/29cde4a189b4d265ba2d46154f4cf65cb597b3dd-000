:root[data-theme="dark"] { --bg: #111214; --surface: #1d1e21; --ink: #f2f2f3; --ink-2: #a0a3a9; --ink-3: #6a6d73; --line: rgb(255 255 255 / .09); --hover: rgb(255 255 255 / .05); }
* { box-sizing: border-box; margin: 0; }
body { background: var(--bg); color: var(--ink); font: 400 var(--ui)/1.4 var(--zr-police-sans); -webkit-font-smoothing: antialiased; padding: 70px 32px 80px; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
.num { font-family: var(--zr-police-serif); font-weight: 400; }
.serif { font-family: var(--zr-police-serif); font-weight: 350; }
.mono { font-family: var(--zr-police-mono); font-size: .92em; }

nav.top { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; gap: 4px; padding: 4px; border-radius: 99px; background: color-mix(in srgb, var(--surface) 80%, transparent); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); box-shadow: 0 6px 24px rgb(0 0 0 / .12); }
