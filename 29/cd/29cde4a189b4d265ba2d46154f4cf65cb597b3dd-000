.v-cols .preview { flex: 1; min-width: 240px; padding: 18px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; color: var(--ink-2); }
.v-cols .preview .thumb { width: 180px; }
.v-gal .stage { position: relative; aspect-ratio: 16 / 7; border-radius: 12px; overflow: hidden; background: #000; }
.v-gal .stage .art { position: absolute; inset: 0; }
.v-gal .cap { display: flex; justify-content: space-between; margin: 10px 0; color: var(--ink-2); }
.v-gal .strip { display: flex; gap: 6px; overflow-x: auto; padding: 4px 2px; }
.v-gal .strip .thumb { flex: none; width: 64px; border-radius: 7px; }
.v-gal .strip .thumb.on { outline: 2px solid var(--sel); outline-offset: 1px; }
/* Style families for the three file-view proposals */
.fam-finder .v-list .lr:nth-child(even):not(.h) { background: var(--hover); }
.fam-finder .v-list .lr.sel { background: var(--sel) !important; color: #fff; } .fam-finder .v-list .lr.sel span { color: #fff !important; }
.fam-finder .v-icons .thumb { border-radius: 6px; background: transparent; } .fam-finder .v-icons .fname { text-align: center; }
.fam-photos .toolbar { padding: 6px; border-radius: 14px; background: var(--hover); }
