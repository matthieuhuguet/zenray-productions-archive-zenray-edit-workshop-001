  // ---------- actions ----------

  document.getElementById("applyAllBtn").addEventListener("click", function () {
    applyEverythingToAll();
    flash(document.getElementById("applyAllBtn"));
  });

  function duplicateSelected() {
    var original = byId[selectedId];
    var sourceId = original.sourceId || original.id;
    var number = 2;
    var duplicateId = sourceId + "-v" + number;
    while (byId[duplicateId]) duplicateId = sourceId + "-v" + (++number);
    var duplicate = {
      id: duplicateId,
      sourceId: sourceId,
      file: original.file,
      w: original.w,
      h: original.h,
      variant: original.file + " · variation " + number
    };
    byId[duplicateId] = duplicate;
    settings[duplicateId] = JSON.parse(JSON.stringify(settings[selectedId]));
    layers[duplicateId] = JSON.parse(JSON.stringify(layers[selectedId]));
    crops[duplicateId] = JSON.parse(JSON.stringify(crops[selectedId]));
    // Jamais de bordure heritee : un lien est pose entre deux voisins precis,
    // et la variation s'intercale entre l'original et son ancien voisin.
    borders[duplicateId] = defaultBorder();
    order.splice(order.indexOf(selectedId) + 1, 0, duplicateId);
    updateCountLabel();
    renderStrip();
    select(duplicateId);
  }

  function deleteSelectedVariation() {
    if (!isVariation(selectedId)) return;
    var removedAt = order.indexOf(selectedId);
    var removedId = selectedId;
    if (borders[removedId] && borders[removedId].openSide !== "none") {
      var side = borders[removedId].openSide;
      var partner = neighborId(side === "left" ? -1 : 1);
      var expected = side === "left" ? "right" : "left";
      if (partner && borders[partner] && borders[partner].openSide === expected) {
        borders[partner].enabled = false;
        borders[partner].openSide = "none";
      }
    }
    order.splice(removedAt, 1);
    delete byId[removedId];
    delete settings[removedId];
    delete layers[removedId];
    delete crops[removedId];
    delete borders[removedId];
    selectedId = order[Math.max(0, removedAt - 1)];
    updateCountLabel();
    renderStrip();
    select(selectedId);
  }

  document.getElementById("duplicateImageBtn").addEventListener("click", duplicateSelected);
  document.getElementById("deleteVariationBtn").addEventListener("click", deleteSelectedVariation);

  // 2026-09-10 : Discard / Rétablir d'une photo vers le sous-dossier _deprecated avec grillage Cyberpunk 2077
  function discardImage(id) {
    var img = byId[id];
    if (!img) return;
    if (isVariation(id)) {
      deleteSelectedVariation();
      return;
    }
    var discardBtn = document.getElementById("discardImageBtn");
    if (discardBtn) discardBtn.disabled = true;

    fetch("/zr-discard", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: id, file: img.file })
    }).then(function (r) { return r.ok ? r.json() : null; })
      .finally(function () {
        setDiscarded(id, true);
        if (selectedId === id) {
          frame.classList.add("is-discarded");
        }
        renderStrip();
        updateCurrentLabel();
        if (discardBtn) discardBtn.disabled = false;
        showBorderWarning(img.file + " écartée vers _deprecated");
      });
  }

  function restoreImage(id) {
    var img = byId[id];
    if (!img) return;
    var discardBtn = document.getElementById("discardImageBtn");
    if (discardBtn) discardBtn.disabled = true;

    fetch("/zr-restore", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: id, file: img.file })
    }).then(function (r) { return r.ok ? r.json() : null; })
      .finally(function () {
        setDiscarded(id, false);
        if (selectedId === id) {
          frame.classList.remove("is-discarded");
        }
        renderStrip();
        updateCurrentLabel();
        if (discardBtn) discardBtn.disabled = false;
        showBorderWarning(img.file + " rétablie depuis _deprecated");
      });
  }

  function toggleDiscard(id) {
    if (isDiscarded(id)) {
      restoreImage(id);
    } else {
      discardImage(id);
    }
  }

  // Discard tout le reste : deplace toutes les autres photos dans _deprecated pour ne garder que la selection
  function discardRest() {
    var currentImg = byId[selectedId];
    var currentSourceId = currentImg ? (currentImg.sourceId || currentImg.id) : selectedId;
    var othersToDiscard = [];
    order.forEach(function (oid) {
      var oImg = byId[oid];
      if (!oImg) return;
      var oSourceId = oImg.sourceId || oImg.id;
      if (oSourceId !== currentSourceId && !isVariation(oid) && !isDiscarded(oid)) {
        othersToDiscard.push({ id: oid, file: oImg.file });
      }
    });
    if (!othersToDiscard.length) {
      alert("Aucune autre photo active à écarter.");
      return;
    }
    if (!confirm("Écarter les " + othersToDiscard.length + " autres photos dans _deprecated ?")) {
      return;
    }

    fetch("/zr-discard", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items: othersToDiscard })
    }).then(function (r) { return r.ok ? r.json() : null; })
      .finally(function () {
        othersToDiscard.forEach(function (item) {
          setDiscarded(item.id, true);
        });
        renderStrip();
        updateCurrentLabel();
        if (selectedId && isDiscarded(selectedId)) {
          frame.classList.add("is-discarded");
        }
        showBorderWarning(othersToDiscard.length + " photo(s) écartée(s) vers _deprecated");
      });
  }

  document.getElementById("discardImageBtn").addEventListener("click", function () {
    if (selectedId) toggleDiscard(selectedId);
  });
  document.getElementById("discardRestBtn").addEventListener("click", discardRest);

  window.addEventListener("keydown", function (e) {
    if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA" || e.target.isContentEditable) return;
    if (e.key === "Delete" || e.key === "Backspace") {
      if (selectedId) {
        e.preventDefault();
        toggleDiscard(selectedId);
      }
    }
  });

  // Grille 3x3, cachee par defaut : un seul toggle sur <body>, la regle CSS
  // body.zr-grid-on .zr-grid decide seule de l'affichage, jamais un style pose
  // ligne par ligne. Le rendu final (le cook) ne lit jamais ce toggle : la
  // grille est un outil d'atelier, elle ne part jamais dans le JPEG.
  document.getElementById("gridToggle").addEventListener("change", function (e) {
