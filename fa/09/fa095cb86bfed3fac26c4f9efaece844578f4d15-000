  function renderStrip() {
    strip.innerHTML = "";
    order.forEach(function (id, index) {
      var img = byId[id];
      var tile = document.createElement("div");
      tile.className = "tile";
      tile.draggable = true;
      tile.dataset.id = id;

      var thumb = document.createElement("div");
      thumb.className = "thumb";
      var el = document.createElement("img");
      el.src = srcUrl(img.file, img.sourceId || img.id);
      el.alt = img.file;
      thumb.append(el);

      var meta = document.createElement("div");
      meta.className = "meta";
      var pos = document.createElement("span");
      pos.className = "pos";
      pos.textContent = String(index + 1).padStart(2, "0");
      var nm = document.createElement("span");
      nm.className = "nm";
      nm.textContent = img.variant || img.file;
      meta.append(pos, nm);

      var dot = document.createElement("span");
      dot.className = "edited";

      var disc = isDiscarded(id);
      tile.classList.toggle("discarded", disc);

      var discardTileBtn = document.createElement("button");
      discardTileBtn.type = "button";
      discardTileBtn.className = "tile-discard";
      discardTileBtn.textContent = disc ? "↺" : "×";
      discardTileBtn.title = disc ? "Rétablir cette photo depuis _deprecated" : "Écarter cette photo vers _deprecated";
      discardTileBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        toggleDiscard(id);
      });

      tile.append(thumb, meta, dot, discardTileBtn);
      tile.classList.toggle("variation", isVariation(id));

      tile.addEventListener("click", function () { select(id); });
      tile.addEventListener("dragstart", function () { dragSrcId = id; tile.classList.add("dragging"); });
      tile.addEventListener("dragend", function () { tile.classList.remove("dragging"); });
      tile.addEventListener("dragover", function (e) { e.preventDefault(); tile.classList.add("drop-target"); });
      tile.addEventListener("dragleave", function () { tile.classList.remove("drop-target"); });
      tile.addEventListener("drop", function (e) {
        e.preventDefault();
        tile.classList.remove("drop-target");
        if (!dragSrcId || dragSrcId === id) return;
        var from = order.indexOf(dragSrcId);
        var to = order.indexOf(id);
        order.splice(from, 1);
        order.splice(to, 0, dragSrcId);
        dragSrcId = null;
        renderStrip();
        updateCurrentLabel();
      });

      strip.append(tile);
    });
    refreshTileFlags();
  }

  function updateCurrentLabel() {
    var img = byId[selectedId];
    if (!img) {
      currentLabel.textContent = "Aucune image restante";
      var delBtn = document.getElementById("deleteVariationBtn");
      if (delBtn) delBtn.disabled = true;
      var discBtn = document.getElementById("discardImageBtn");
      if (discBtn) discBtn.disabled = true;
      return;
    }
    var disc = isDiscarded(selectedId);
    frame.classList.toggle("is-discarded", disc);
    currentLabel.innerHTML = "position <b>" + String(order.indexOf(selectedId) + 1).padStart(2, "0") +
      "</b> · id " + selectedId + " · " + (img.variant || img.file) +
      (disc ? ' <span class="cyber-label-badge">[ ÉCARTÉE // DISCARDED ]</span>' : "");
    document.getElementById("deleteVariationBtn").disabled = !isVariation(selectedId);
    var discBtn = document.getElementById("discardImageBtn");
    if (discBtn) {
      discBtn.disabled = false;
      if (disc) {
        discBtn.classList.add("is-restoring");
        discBtn.title = "Rétablir cette photo depuis _deprecated";
        discBtn.querySelector("span").textContent = "Rétablir";
      } else {
        discBtn.classList.remove("is-restoring");
        discBtn.title = "Écarter cette photo vers _deprecated";
        discBtn.querySelector("span").textContent = "Discard";
      }
    }
  }

  function select(id) {
    selectedId = id;
    frame.classList.toggle("is-discarded", isDiscarded(id));
    updateCurrentLabel();
    source.src = srcUrl(byId[id].file, byId[id].sourceId || id);
