      var shadowRow = document.createElement("div");
      shadowRow.className = "fx-row";
      var shadowToggle = document.createElement("button");
      shadowToggle.type = "button";
      shadowToggle.className = "fx-toggle" + (layer.shadow.enabled ? " on" : "");
      shadowToggle.textContent = "Ombre portee : " + (layer.shadow.enabled ? "activee" : "desactivee");
      var shadowGrid = document.createElement("div");
      shadowGrid.className = "fx-grid" + (layer.shadow.enabled ? "" : " disabled");
      shadowToggle.addEventListener("click", function () {
        layer.shadow.enabled = !layer.shadow.enabled;
