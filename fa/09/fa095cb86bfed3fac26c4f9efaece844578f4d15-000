  function payload() {
    var images = {};
    order.forEach(function (id, index) {
      var img = byId[id];
      images[id] = {
        position: index + 1,
        source_id: img.sourceId || img.id,
        file: img.file,
        variation: img.variant || null,
        output: String(index + 1).padStart(2, "0") + ".jpg",
        crop: crops[id],
        border: borders[id],
        photo: settings[id],
        discarded: isDiscarded(id),
        text: layers[id]
          .filter(function (l) { return l.value.trim(); })
          .map(function (l) {
            return {
              value: l.value.trim(), font: l.font, weight: l.weight,
              size_px: l.effectiveSizePx, requested_size_px: l.sizePx,
              color: l.color || "#f6cf47", anchor: l.anchor, shadow: l.shadow
            };
          })
      };
    });
    var fmt = FORMATS[state.format];
    return {
      project: PROJECT,
      format: fmt ? { key: state.format, w: fmt.w, h: fmt.h, factor: fmt.factor } : null,
      order: order,
      images: images,
      post: window.ZRPostEditor ? window.ZRPostEditor.snapshot() : null
    };
  }

  function copyText(text) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) {}
    ta.remove();
    return ok;
  }

  function outputText() {
    var data = payload();
    var f = data.format;
    var head = "ZENRAY-HTML-HDA STUDIO · " + PROJECT + " · " +
      (f ? "format " + f.key + "(" + f.w + "x" + f.h + ") ×" + f.factor +
           " → " + (f.w * f.factor) + "x" + (f.h * f.factor)
         : "format d'origine conservé");
    var lines = order.map(function (id) {
      var entry = data.images[id];
      var c = entry.crop;
      var marks = [];
      if (!isNeutralPhoto(entry.photo)) marks.push("photo retouchée");
      if (entry.text.length) marks.push(entry.text.length + " texte" + (entry.text.length > 1 ? "s" : ""));
      return String(entry.position).padStart(2, "0") + ": " + (entry.variation || entry.file) + " -> " + entry.output +
        "  zoom=" + Number(c.zoom).toFixed(2) + " rotate=" + Number(c.rotate).toFixed(1) + "deg" +
        " x=" + Math.round(c.px) + "% y=" + Math.round(c.py) + "%" +
        (marks.length ? "  (" + marks.join(", ") + ")" : "");
    });
    return head + "\n\n" + lines.join("\n") + "\n\n" + JSON.stringify(data, null, 2);
  }

  var outBox = document.getElementById("outBox");
  var outText = document.getElementById("outText");

  // Exposes pour zr-save.js : un seul constructeur de bloc, jamais deux verites.
  window.ZR_PAYLOAD = payload;
  window.ZR_OUTPUT_TEXT = outputText;
  document.getElementById("copyAllBtn").addEventListener("click", function () {
    var text = outputText();
    outText.value = text;
    outBox.classList.add("shown");
    outText.focus();
    outText.select();
    copyText(text);
  });
  document.getElementById("outCopyBtn").addEventListener("click", function () {
    var ok = copyText(outText.value);
    document.getElementById("outCopyBtn").textContent = ok ? "Copié" : "Sélectionne et copie à la main";
  });
  document.getElementById("outCloseBtn").addEventListener("click", function () {
    outBox.classList.remove("shown");
    document.getElementById("outCopyBtn").textContent = "Copier";
  });

  // ---------- demarrage ----------

  var fmtSelect = document.getElementById("fmtSelect");
  Object.keys(FORMATS).forEach(function (key) {
    var opt = document.createElement("option");
    opt.value = key;
    opt.textContent = key === "source" ? "source (sans recadrage)" : key;
    if (key === state.format) opt.selected = true;
    fmtSelect.appendChild(opt);
  });
  function applyFormat() {
    var fmt = FORMATS[state.format];
    var out = outputSize();
    document.getElementById("resLabel").textContent = fmt
      ? fmt.w + "×" + fmt.h + " ×" + fmt.factor + " → sortie " + out.w + "×" + out.h
      : "format d'origine conservé";
    var p = previewSize();
    frame.style.setProperty("--img-ratio", p.w + " / " + p.h);
    // Une ancre laterale n'a de sens qu'en format horizontal.
    order.forEach(function (id) {
      layers[id].forEach(function (l) {
        if (!isLandscape() && l.anchor.indexOf("-center") === -1) l.anchor = clampAnchorToCenter(l.anchor);
      });
    });
    buildLayerPanel();
    scheduleRender();
  }
  fmtSelect.addEventListener("change", function () {
    state.format = fmtSelect.value;
    applyFormat();
  });

  buildPhotoControls();
  renderStrip();
  select(order[0]);
  applyFormat();

  // Recharger un _params.json DEJA ecrit sur disque : un travail colle une
  // fois n'est jamais perdu, meme si l'instance est reservie ou regeneree.
  // Ne marche qu'a travers le serveur local (toujours actif en mode heavy) :
  // fetch() sur un fichier local est bloque par le navigateur en file://.
  function ensureVariationEntry(id, sourceId, variantLabel) {
    if (byId[id]) return;
    var source = byId[sourceId];
    if (!source) return;
    byId[id] = { id: id, sourceId: sourceId, file: source.file, w: source.w, h: source.h, variant: variantLabel || null };
  }

  function restoreFromParams(data) {
    if (!data || !data.images || !data.order || !data.order.length) return;
    order = data.order.filter(function (id) { return data.images[id]; });
    order.forEach(function (id) {
      var spec = data.images[id];
      var sourceId = spec.source_id || id;
      ensureVariationEntry(id, sourceId, spec.variation);
      if (!byId[id]) return;
      if (spec.discarded) setDiscarded(id, true);
      settings[id] = spec.photo ? JSON.parse(JSON.stringify(spec.photo)) : ZRPhotoAdjustments.defaults();
      crops[id] = spec.crop ? JSON.parse(JSON.stringify(spec.crop)) : { zoom: 1, px: 50, py: 50, rotate: 0 };
      borders[id] = spec.border ? JSON.parse(JSON.stringify(spec.border)) : defaultBorder();
      layers[id] = (spec.text || []).map(function (t) {
        return {
          value: t.value || "", font: t.font || "serif", weight: parseInt(t.weight, 10) || 400,
          sizePx: t.requested_size_px || t.size_px || DEFAULT_SIZE_PX,
          effectiveSizePx: t.size_px || DEFAULT_SIZE_PX,
          color: t.color || "#f6cf47", anchor: t.anchor || "bottom-center",
          shadow: t.shadow || { enabled: true, distance: 0, spread: 0, size: 10 }
        };
      });
    });
    if (data.format && data.format.key && FORMATS[data.format.key]) {
      state.format = data.format.key;
      fmtSelect.value = data.format.key;
    }
    selectedId = order[0];
    updateCountLabel();
    renderStrip();
    select(selectedId);
    applyFormat();
    status.textContent = order.length + " image(s) restaurees depuis _params.json";
  }

  if (window.ZR_PARAMS) {
    restoreFromParams(window.ZR_PARAMS);
  } else {
    fetch("_params.json").then(function (r) {
      if (!r.ok) return null;
      return r.json();
    }).then(function (data) {
      if (data) restoreFromParams(data);
    }).catch(function () { /* pas de _params.json, ou pas de serveur local : on reste sur l'etat neuf */ });
  }
})();
</script>

<script>
/* 2026-09-03 : la hauteur du header se mesure. Il enveloppe sur plusieurs lignes dans une fenetre
   etroite, et recouvrait la scene tant qu'un 56px etait ecrit en dur. */
(function topHeightObserver() {
  var head = document.querySelector("header.top");
  if (!head) return;
  var apply = function () {
    document.documentElement.style.setProperty("--top-h", Math.ceil(head.getBoundingClientRect().height) + "px");
  };
  if (window.ResizeObserver) new ResizeObserver(apply).observe(head);
  window.addEventListener("resize", apply);
  apply();
})();
</script>
<script src="_post-data.js"></script>
