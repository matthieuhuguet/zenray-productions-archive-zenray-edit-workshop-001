        { hex: "#ffffff", title: "Blanc #ffffff" },
        { hex: "#ff3b30", title: "Rouge #ff3b30" },
        { hex: "#f6cf47", title: "Jaune #f6cf47" },
        { hex: "#34c759", title: "Vert #34c759" },
        { hex: "#00c7be", title: "Cyan #00c7be" },
        { hex: "#007aff", title: "Bleu #007aff" },
        { hex: "#af52de", title: "Magenta #af52de" },
        // Ligne 2 : Roue chromatique + 6 Pales doux (RGB + CMY)
        null,
        { hex: "#ffb3b0", title: "Rouge pâle #ffb3b0" },
        { hex: "#ffefa6", title: "Jaune pâle #ffefa6" },
        { hex: "#b8f2c8", title: "Vert pâle #b8f2c8" },
        { hex: "#b2f2ef", title: "Cyan pâle #b2f2ef" },
        { hex: "#b8d7ff", title: "Bleu pâle #b8d7ff" },
        { hex: "#e5bbf8", title: "Magenta pâle #e5bbf8" }
