  // ---------- bande de vignettes, selection et reorder ----------

  var dragSrcId = null;

  function refreshTileFlags() {
    strip.querySelectorAll(".tile").forEach(function (tile) {
      tile.classList.toggle("has-edits", hasEdits(tile.dataset.id));
      tile.classList.toggle("selected", tile.dataset.id === selectedId);
    });
