      function updateActiveColor(c) {
        var isPreset = false;
        swatchButtons.forEach(function (sb) {
          var match = sb.dataset.hex.toLowerCase() === (c || "").toLowerCase();
          sb.classList.toggle("active", match);
          if (match) isPreset = true;
