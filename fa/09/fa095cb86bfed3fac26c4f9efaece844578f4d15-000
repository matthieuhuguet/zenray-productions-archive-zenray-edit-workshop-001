  // et jusqu'a trois calques de texte par image, ajoutes au bouton +.
  // Chaque image garde ses propres reglages photo ET ses propres calques de texte.

  /* @zr-instance:start */
  // BLOC D'INSTANCE : ecrit par scripts/zr-hda-instance.py, jamais a la main.
  // C'est le SEUL endroit du gabarit qui depend du projet ; tout le reste est
  // identique d'une instance a l'autre, ce qui permet de creer un nouvel outil
  // sans regenerer une ligne de HTML.
  var PROJECT = "out";
  var SOURCE_DIR = "../RepresentativePortrait/out/";
  var IMAGES = [
      {
          "id": "01",
          "file": "slide-1.png",
          "w": 3240,
          "h": 4050
      }
  ];
  var DEFAULT_FORMAT_KEY = "source";
  /* @zr-instance:end */

  // Loi de format et de resolution du skill : facteur = plus petit entier qui
  // atteint 3840 px sur le grand cote, plafonne a quatre.
  var FORMATS = {
    "4:5":  { w: 1080, h: 1350, factor: 3 },
    "1:1":  { w: 1080, h: 1080, factor: 4 },
    "9:16": { w: 1080, h: 1920, factor: 2 },
    "16:9": { w: 1920, h: 1080, factor: 2 },
    "1:2":  { w: 1080, h: 2160, factor: 2 },
    "3:4":  { w: 1080, h: 1440, factor: 3 },
    "2:3":  { w: 1080, h: 1620, factor: 3 },
    "4:3":  { w: 1440, h: 1080, factor: 3 },
    "source": null
  };

  var MAX_LAYERS = 3;
  var MIN_SIZE_PX = 6;
  var DEFAULT_SIZE_PX = 200;
  var WEIGHTS = [
    [300, "Light"], [400, "Regular"], [500, "Medium"], [600, "SemiBold"],
    [700, "Bold"], [800, "ExtraBold / UltraBold"], [900, "Black / Heavy"]
  ];
  var ANCHORS = [
    "top-left", "top-center", "top-right",
    "middle-left", "middle-center", "middle-right",
    "bottom-left", "bottom-center", "bottom-right"
  ];
  var DEFAULT_ANCHOR_BY_INDEX = ["bottom-center", "top-center", "middle-center"];

  var byId = {};
  IMAGES.forEach(function (img) {
    img.sourceId = img.sourceId || img.id;
    var p = window.ZR_PARAMS && window.ZR_PARAMS.images && window.ZR_PARAMS.images[img.id];
    if (p && p.discarded) img.discarded = true;
    byId[img.id] = img;
  });

  function isDiscarded(id) {
    var img = byId[id];
    if (img && img.discarded) return true;
    var p = window.ZR_PARAMS && window.ZR_PARAMS.images && window.ZR_PARAMS.images[id];
    if (p && p.discarded) return true;
    return false;
  }

  function setDiscarded(id, flag) {
    if (byId[id]) byId[id].discarded = !!flag;
    if (window.ZR_PARAMS && window.ZR_PARAMS.images && window.ZR_PARAMS.images[id]) {
      window.ZR_PARAMS.images[id].discarded = !!flag;
    }
  }

  var order = (window.ZR_PARAMS && Array.isArray(window.ZR_PARAMS.order) && window.ZR_PARAMS.order.length)
    ? window.ZR_PARAMS.order.slice()
    : IMAGES.map(function (i) { return i.id; });
  var initialOrder = order.slice();

  var settings = {};   // reglages photo par image
  var layers = {};     // calques de texte par image, 0 a 3
  var crops = {};      // cadrage par image : zoom, position, rotation
  var borders = {};    // bordure exterieure par image : couleur, epaisseur, cote ouvert
  function defaultBorder() { return { enabled: false, color: "#c4c3b9", thickness: 6, radius: 6, openSide: "none" }; }
  IMAGES.forEach(function (img) {
    var p = window.ZR_PARAMS && window.ZR_PARAMS.images && window.ZR_PARAMS.images[img.id];
    settings[img.id] = (p && p.photo) ? JSON.parse(JSON.stringify(p.photo)) : ZRPhotoAdjustments.defaults();
    layers[img.id] = [];
    crops[img.id] = (p && p.crop) ? JSON.parse(JSON.stringify(p.crop)) : { zoom: 1, px: 50, py: 50, rotate: 0 };
    borders[img.id] = (p && p.border) ? JSON.parse(JSON.stringify(p.border)) : defaultBorder();
  });
  var state = { format: (window.ZR_PARAMS && window.ZR_PARAMS.format && window.ZR_PARAMS.format.key) || DEFAULT_FORMAT_KEY };

  var selectedId = order[0];
  var selectedChannel = 0;
  var CHANNELS = ["Rouge", "Jaune", "Vert", "Cyan", "Bleu", "Magenta"];
  var FILTERS = ZRPhotoAdjustments.filters();

  var canvas = document.getElementById("photo");
  var frame = document.getElementById("frame");
  var textLayersEl = document.getElementById("text-layers");
  var source = document.getElementById("source");
  var strip = document.getElementById("strip");
  var status = document.getElementById("status");
  var currentLabel = document.getElementById("currentLabel");
  var layerList = document.getElementById("layer-list");
  var addLayerBtn = document.getElementById("addLayerBtn");
  var processor = new ZRPhotoAdjustments(canvas);
  var framePending = false;

  document.title = "zenray-html-hda heavy · " + PROJECT;
  document.getElementById("projectLabel").textContent = PROJECT;
  function updateCountLabel() {
    document.getElementById("countLabel").textContent = order.length + " image" + (order.length > 1 ? "s" : "");
  }
  updateCountLabel();

  function current() { return settings[selectedId]; }
  function currentLayers() { return layers[selectedId]; }
  function isVariation(id) { return byId[id] && byId[id].sourceId !== id; }

  function newLayer(index) {
    return {
      value: "", font: "serif", weight: 400,
      sizePx: DEFAULT_SIZE_PX, effectiveSizePx: DEFAULT_SIZE_PX,
      color: "#f6cf47", anchor: DEFAULT_ANCHOR_BY_INDEX[index] || "bottom-center",
      shadow: { enabled: true, size: 40, strength: 40 }
    };
  }

  function isNeutralPhoto(values) {
    return JSON.stringify(values) === JSON.stringify(ZRPhotoAdjustments.defaults());
  }
  function isNeutralCrop(c) {
    return c.zoom === 1 && c.px === 50 && c.py === 50 && c.rotate === 0;
  }
  function hasEdits(id) {
    return !isNeutralPhoto(settings[id]) || !isNeutralCrop(crops[id]) ||
      layers[id].some(function (l) { return l.value.trim(); }) ||
      (borders[id] && borders[id].enabled);
  }

  // Voisin de l'image SELECTIONNEE dans l'ordre courant, offset -1 = precedente,
  // +1 = suivante. Rend null si l'image est en bout de lot : c'est ce qui
  // declenche l'avertissement plutot qu'un lien casse.
  function neighborId(offset) {
    var i = order.indexOf(selectedId);
    var j = i + offset;
    return j >= 0 && j < order.length ? order[j] : null;
  }

  var borderWarningTimer = null;
  function showBorderWarning(msg) {
    var el = document.getElementById("borderWarning");
    if (!el) return;
    el.textContent = msg;
    el.classList.add("shown");
    clearTimeout(borderWarningTimer);
    borderWarningTimer = setTimeout(function () { el.classList.remove("shown"); }, 3200);
  }

  // Change le cote OUVERT de l'image selectionnee, et cree ou detruit le lien
  // reciproque avec le voisin : le meme mecanisme que Matthieu a demande pour
  // relier deux images sans les recadrer l'une dans l'autre. Un lien est
  // TOUJOURS a deux sens : ouvrir a droite pose la meme couleur et la meme
  // epaisseur sur le bord gauche de l'image suivante, et couper l'un des deux
  // cote coupe l'autre aussi, jamais un seul.
  function setOpenSide(side) {
    var b = borders[selectedId];
    var prevSide = b.openSide;
    function detach(fromSide) {
      if (fromSide === "none") return;
      var partner = neighborId(fromSide === "left" ? -1 : 1);
      var expected = fromSide === "left" ? "right" : "left";
      if (partner && borders[partner] && borders[partner].openSide === expected) {
        borders[partner].openSide = "none";
      }
    }
    if (side === "none") {
      detach(prevSide);
      b.openSide = "none";
      buildBorderPanel();
      scheduleRender();
      return;
    }
    var partner = neighborId(side === "left" ? -1 : 1);
    if (!partner) {
      showBorderWarning(side === "left"
        ? "Pas d'image precedente : impossible de relier a gauche."
        : "Pas d'image suivante : impossible de relier a droite.");
      return;
    }
    if (prevSide !== "none" && prevSide !== side) detach(prevSide);
    b.enabled = true;
    b.openSide = side;
    borders[partner].enabled = true;
    borders[partner].openSide = side === "left" ? "right" : "left";
    borders[partner].color = b.color;
    borders[partner].thickness = b.thickness;
    borders[partner].radius = b.radius !== undefined ? b.radius : b.thickness;
    buildBorderPanel();
    scheduleRender();
  }

  function buildBorderPanel() {
    var host = document.getElementById("border-controls");
    if (!host) return;
    host.innerHTML = "";
    var b = borders[selectedId];

    var toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "fx-toggle" + (b.enabled ? " on" : "");
    toggle.textContent = "Bordure : " + (b.enabled ? "activee" : "desactivee");
    toggle.addEventListener("click", function () {
      b.enabled = !b.enabled;
      if (!b.enabled && b.openSide !== "none") {
        var partner = neighborId(b.openSide === "left" ? -1 : 1);
        if (partner && borders[partner]) {
          borders[partner].enabled = false;
          borders[partner].openSide = "none";
        }
        b.openSide = "none";
      }
      buildBorderPanel();
      scheduleRender();
    });
    host.append(toggle);

    var grid = document.createElement("div");
    grid.className = "fx-grid" + (b.enabled ? "" : " disabled");

    var colorField = document.createElement("label");
    colorField.className = "fx-field";
    var colorName = document.createElement("span");
    colorName.textContent = "Couleur";
    var colorInput = document.createElement("input");
    colorInput.type = "text";
    colorInput.value = b.color;
    colorInput.addEventListener("input", function () {
      var v = colorInput.value.trim();
      if (!/^#[0-9a-fA-F]{3,8}$/.test(v)) return;
      b.color = v;
      updateBorderActiveColor(v);
      var partner = b.openSide !== "none" ? neighborId(b.openSide === "left" ? -1 : 1) : null;
      if (partner && borders[partner]) borders[partner].color = v;
      scheduleRender();
    });
    colorField.append(colorName, colorInput);
    grid.append(colorField);

    var thickField = document.createElement("label");
    thickField.className = "fx-field";
    var thickName = document.createElement("span");
    thickName.textContent = "Épaisseur";
    var thickInput = document.createElement("input");
    thickInput.type = "number";
    thickInput.min = "0"; thickInput.max = "80"; thickInput.step = "1";
    thickInput.value = String(b.thickness);
    thickInput.addEventListener("input", function () {
      var v = parseFloat(thickInput.value);
      if (!isFinite(v) || v < 0) return;
      b.thickness = v;
      var partner = b.openSide !== "none" ? neighborId(b.openSide === "left" ? -1 : 1) : null;
      if (partner && borders[partner]) borders[partner].thickness = v;
      scheduleRender();
    });
    var thickUnit = document.createElement("span");
    thickUnit.className = "fx-unit";
    thickUnit.textContent = "px";
    thickField.append(thickName, thickInput, thickUnit);
    grid.append(thickField);

    var radiusField = document.createElement("label");
    radiusField.className = "fx-field";
    var radiusName = document.createElement("span");
    radiusName.textContent = "Arrondi";
    var radiusInput = document.createElement("input");
    radiusInput.type = "number";
    radiusInput.min = "0"; radiusInput.max = "120"; radiusInput.step = "1";
    radiusInput.value = String(b.radius !== undefined ? b.radius : b.thickness);
    radiusInput.addEventListener("input", function () {
      var v = parseFloat(radiusInput.value);
      if (!isFinite(v) || v < 0) return;
      b.radius = v;
      var partner = b.openSide !== "none" ? neighborId(b.openSide === "left" ? -1 : 1) : null;
      if (partner && borders[partner]) borders[partner].radius = v;
      scheduleRender();
    });
    var radiusUnit = document.createElement("span");
    radiusUnit.className = "fx-unit";
    radiusUnit.textContent = "px";
    radiusField.append(radiusName, radiusInput, radiusUnit);
    grid.append(radiusField);

    host.append(grid);

    // 2026-09-10 : 12 outputs (RGB + CMY en full et pale) + Blanc + Roue chromatique Liquid Glass
    var borderSwatches = document.createElement("div");
    borderSwatches.className = "swatches-grid border-swatches" + (b.enabled ? "" : " disabled");
    borderSwatches.setAttribute("aria-label", "Palette de couleurs de bordure");

    var PALETTE = [
      // Ligne 1 : Blanc + 6 Full vifs (RGB + CMY)
      { hex: "#ffffff", title: "Blanc #ffffff" },
      { hex: "#ff3b30", title: "Rouge #ff3b30" },
      { hex: "#f6cf47", title: "Jaune #f6cf47" },
      { hex: "#34c759", title: "Vert #34c759" },
      { hex: "#00c7be", title: "Cyan #00c7be" },
      { hex: "#007aff", title: "Bleu #007aff" },
      { hex: "#af52de", title: "Magenta #af52de" },
      // Ligne 2 : Roue chromatique + 6 Pales doux (RGB + CMY)
      null,
      { hex: "#ffb3b0", title: "Rouge pâle #ffb3b0" },
      { hex: "#ffefa6", title: "Jaune pâle #ffefa6" },
      { hex: "#b8f2c8", title: "Vert pâle #b8f2c8" },
      { hex: "#b2f2ef", title: "Cyan pâle #b2f2ef" },
      { hex: "#b8d7ff", title: "Bleu pâle #b8d7ff" },
      { hex: "#e5bbf8", title: "Magenta pâle #e5bbf8" }
    ];

    var swatchButtons = [];
    var wheelBtn = null;
    var colorPickerInput = null;

    function updateBorderActiveColor(c) {
      var isPreset = false;
      swatchButtons.forEach(function (sb) {
        var match = sb.dataset.hex.toLowerCase() === c.toLowerCase();
        sb.classList.toggle("active", match);
        if (match) isPreset = true;
      });
      if (wheelBtn) {
        wheelBtn.classList.toggle("active", !isPreset);
        wheelBtn.title = "Roue chromatique : " + c;
        if (colorPickerInput && /^#[0-9a-fA-F]{6}$/.test(c)) {
          colorPickerInput.value = c;
        }
      }
    }

    PALETTE.forEach(function (item) {
      if (item === null) {
        wheelBtn = document.createElement("div");
        wheelBtn.className = "swatch-wheel" + (b.color && !PALETTE.some(function (p) { return p && p.hex.toLowerCase() === (b.color || "").toLowerCase(); }) ? " active" : "");
        wheelBtn.title = "Roue chromatique : " + (b.color || "#ffffff");
        colorPickerInput = document.createElement("input");
        colorPickerInput.type = "color";
        colorPickerInput.value = /^#[0-9a-fA-F]{6}$/.test(b.color) ? b.color : "#ffffff";
        colorPickerInput.addEventListener("input", function (e) {
          var val = e.target.value;
          b.color = val;
          colorInput.value = val;
          updateBorderActiveColor(val);
          var partner = b.openSide !== "none" ? neighborId(b.openSide === "left" ? -1 : 1) : null;
          if (partner && borders[partner]) borders[partner].color = val;
          scheduleRender();
        });
        wheelBtn.append(colorPickerInput);
        borderSwatches.append(wheelBtn);
        return;
      }

      var sw = document.createElement("button");
      sw.type = "button";
      sw.className = "swatch" + ((b.color || "").toLowerCase() === item.hex.toLowerCase() ? " active" : "");
      sw.style.background = item.hex;
      sw.dataset.hex = item.hex;
      sw.title = item.title;
      sw.addEventListener("click", function () {
        b.color = item.hex;
        colorInput.value = item.hex;
        updateBorderActiveColor(item.hex);
        var partner = b.openSide !== "none" ? neighborId(b.openSide === "left" ? -1 : 1) : null;
        if (partner && borders[partner]) borders[partner].color = item.hex;
        scheduleRender();
      });
      swatchButtons.push(sw);
      borderSwatches.append(sw);
    });

    updateBorderActiveColor(b.color);

    host.append(borderSwatches);

    var sideRow = document.createElement("div");
    sideRow.className = "border-side-row" + (b.enabled ? "" : " disabled");
    [["none", "Complet"], ["left", "Ouvert · precedente"], ["right", "Ouvert · suivante"]].forEach(function (pair) {
      var btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.side = pair[0];
      btn.textContent = pair[1];
      if (b.openSide === pair[0]) btn.classList.add("active");
      btn.addEventListener("click", function () { setOpenSide(pair[0]); });
      sideRow.append(btn);
    });
    host.append(sideRow);

    var warning = document.createElement("div");
    warning.className = "border-warning";
    warning.id = "borderWarning";
    host.append(warning);
  }

  function renderBorder() {
    var host = document.getElementById("border-layer");
    if (!host) return;
    host.innerHTML = "";
    var b = borders[selectedId];
    if (!b || !b.enabled || b.thickness <= 0) return;
    var cw = canvasWidth();
    var ch = outputSize().h;
    var t = b.thickness;
    var rawR = b.radius !== undefined ? b.radius : b.thickness;
    var r = Math.max(0, Math.min(rawR, (cw - t) / 2, (ch - 2 * t) / 2));

    var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 " + cw + " " + ch);
    svg.setAttribute("preserveAspectRatio", "none");
    svg.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none;";

    var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("fill-rule", "evenodd");
    path.setAttribute("fill", b.color);

    var d = "M 0 0 H " + cw + " V " + ch + " H 0 Z ";
    if (b.openSide === "right") {
      if (r > 0) {
        d += "M " + (t + r) + " " + t + " H " + cw + " V " + (ch - t) + " H " + (t + r) + " A " + r + " " + r + " 0 0 1 " + t + " " + (ch - t - r) + " V " + (t + r) + " A " + r + " " + r + " 0 0 1 " + (t + r) + " " + t + " Z";
      } else {
        d += "M " + t + " " + t + " H " + cw + " V " + (ch - t) + " H " + t + " Z";
      }
    } else if (b.openSide === "left") {
      if (r > 0) {
        d += "M 0 " + t + " H " + (cw - t - r) + " A " + r + " " + r + " 0 0 1 " + (cw - t) + " " + (t + r) + " V " + (ch - t - r) + " A " + r + " " + r + " 0 0 1 " + (cw - t - r) + " " + (ch - t) + " H 0 Z";
      } else {
        d += "M 0 " + t + " H " + (cw - t) + " V " + (ch - t) + " H 0 Z";
      }
    } else {
      if (r > 0) {
        d += "M " + (t + r) + " " + t + " H " + (cw - t - r) + " A " + r + " " + r + " 0 0 1 " + (cw - t) + " " + (t + r) + " V " + (ch - t - r) + " A " + r + " " + r + " 0 0 1 " + (cw - t - r) + " " + (ch - t) + " H " + (t + r) + " A " + r + " " + r + " 0 0 1 " + t + " " + (ch - t - r) + " V " + (t + r) + " A " + r + " " + r + " 0 0 1 " + (t + r) + " " + t + " Z";
      } else {
        d += "M " + t + " " + t + " H " + (cw - t) + " V " + (ch - t) + " H 0 Z";
      }
    }
    path.setAttribute("d", d);
    svg.appendChild(path);
    host.appendChild(svg);
  }

  function srcUrl(file, id) {
    // L'apercu embarque est une data URI : same-origin, donc WebGL l'accepte
    // en file:// comme en http. Le chemin relatif ne sert que de repli, et il
    // ne fonctionne alors qu'a travers un service local.
    if (id && window.ZR_PREVIEWS && window.ZR_PREVIEWS[id]) return window.ZR_PREVIEWS[id];
    return SOURCE_DIR + encodeURIComponent(file).replace(/%2F/g, "/");
  }

  // Dimensions du FICHIER FINAL, jamais celles de l'apercu reduit : une taille
  // de texte annoncee en px doit valoir ces pixels-la sur le JPEG livre. Quand
  // un format cible est choisi, c'est lui qui commande ; en mode « source », ce
  // sont les dimensions de l'image d'origine.
  function outputSize() {
    var fmt = FORMATS[state.format];
    if (fmt) return { w: fmt.w * fmt.factor, h: fmt.h * fmt.factor };
    var img = byId[selectedId];
    if (img && img.w && img.h) return { w: img.w, h: img.h };
    return { w: canvas.width || 1080, h: canvas.height || 1350 };
  }

  // Taille de la toile d'APERCU : le format cible en unites de composition,
  // suffisant a l'ecran, et sans rapport avec la resolution livree.
  function previewSize() {
    var fmt = FORMATS[state.format];
    if (fmt) return { w: fmt.w, h: fmt.h };
    var img = byId[selectedId];
    return { w: Math.min(1400, img && img.w ? img.w : 1080),
             h: img && img.w ? Math.round(Math.min(1400, img.w) * img.h / img.w) : 1350 };
  }

  // Facteur anti-coin-transparent : agrandit la couverture pour qu'une rotation
  // ne laisse jamais voir le fond. Meme formule que le cook Python, a ne jamais
  // faire diverger.
  function safeScale(angleDeg, fw, fh) {
    var rad = angleDeg * Math.PI / 180;
    var ratio = Math.max(fh / fw, fw / fh);
    return Math.abs(Math.cos(rad)) + ratio * Math.abs(Math.sin(rad));
  }

  // CADRAGE : la source est dessinee dans une toile 2D a la taille du format,
  // avec zoom, position et rotation, et c'est CETTE toile qui devient la
  // texture du module photo. Le cadrage n'est donc plus une etape separee, mais
  // le premier maillon du meme pipeline : source -> crop 2D -> photo WebGL ->
  // texte. Le cook Python rejoue exactement la meme chaine.
  var cropCanvas = document.createElement("canvas");
  var cropCtx = cropCanvas.getContext("2d");

  function buildCrop() {
    if (!source.naturalWidth) return null;
    var p = previewSize();
    cropCanvas.width = p.w; cropCanvas.height = p.h;
    var nw = source.naturalWidth, nh = source.naturalHeight;
    var c = crops[selectedId];
    var s = Math.max(p.w / nw, p.h / nh);
    var k = s * c.zoom * safeScale(c.rotate, p.w, p.h) * 1.002;
    // La fenetre visible depend du facteur EFFECTIF : sans le zoom, la marge de
    // l'axe couvrant vaut zero et Position Y ne bouge rien meme en zoomant.
    var vw = p.w / k, vh = p.h / k;
    var x0 = Math.max(0, nw - vw) * (c.px / 100);
    var y0 = Math.max(0, nh - vh) * (c.py / 100);
    cropCtx.setTransform(1, 0, 0, 1, 0, 0);
    cropCtx.clearRect(0, 0, p.w, p.h);
    cropCtx.translate(p.w / 2, p.h / 2);
    cropCtx.rotate(c.rotate * Math.PI / 180);
    cropCtx.scale(k, k);
    cropCtx.translate(-(x0 + vw / 2), -(y0 + vh / 2));
    cropCtx.drawImage(source, 0, 0);
    return cropCanvas;
  }
  function canvasWidth() { return outputSize().w; }

  function isLandscape() { var s = outputSize(); return s.w > s.h; }

  function clampAnchorToCenter(anchor) { return anchor.split("-")[0] + "-center"; }

  function paint() {
    var cropped = buildCrop();
    if (cropped) processor.setImage(cropped);   // recadre, puis retouche
    processor.set(current());
    renderBorder();
    renderTextLayers();
    refreshTileFlags();
  }

  function scheduleRender() {
    // Le rendu ne doit JAMAIS pouvoir se bloquer : c'est l'outil d'edition de
    // Matthieu, un aperçu fige lui fait perdre tout controle. Or
    // requestAnimationFrame ne tire pas toujours (onglet en arriere-plan,
    // fenetre masquee, contexte sans compositeur). Sans filet, `framePending`
    // restait vrai pour toujours apres un rAF qui n'a jamais tire, et PLUS
    // AUCUN rendu n'avait lieu ensuite, curseurs comme texte.
    // Le filet en setTimeout garantit le rendu ; `done` garde la coalescence,
    // pour que le rAF et le repli ne peignent jamais deux fois.
    if (framePending) return;
    framePending = true;
    var done = false;
    var run = function () {
      if (done) return;
      done = true;
      framePending = false;
      paint();
    };
    requestAnimationFrame(run);
    setTimeout(run, 60);
  }

  // ---------- mesure du texte, jamais la boite DOM etiree ----------
  // Leçon deja payee cote picker light : mesurer le CONTENU (Canvas 2D), pas la
  // boite `left:0;right:0` qui vaut toujours la largeur du cadre. Meme algorithme
  // que ImageDraw.textbbox() cote Python.
  var measureContext = document.createElement("canvas").getContext("2d");

  function measureText(layer, fontSizePx) {
    var family = layer.font === "serif"
      ? '"AnthropicSerif", serif'
      : '"InterVariable", sans-serif';
    measureContext.font = layer.weight + " " + fontSizePx + "px " + family;
    var metrics = measureContext.measureText(layer.value);
    var width = metrics.actualBoundingBoxLeft !== undefined
      ? metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight
      : metrics.width;
    var height = (metrics.actualBoundingBoxAscent || fontSizePx * 0.8) +
                 (metrics.actualBoundingBoxDescent || fontSizePx * 0.2);
    return { width: width, height: height };
  }

  // Auto-fit : la taille demandee est un POINT DE DEPART, jamais une valeur
  // imposee. On la reduit jusqu'a ce que le texte tienne entierement dans le
  // cadre (88 % de large, 88 % de haut), et c'est cette valeur reelle qui part
  // dans le presse-papier, jamais celle demandee.
  function fitSize(layer) {
    var out = outputSize();
    var cw = out.w, ch = out.h;
    var size = layer.sizePx;
    var maxW = cw * 0.88;
    var maxH = ch * 0.88;
    var guard = 0;
    var m = measureText(layer, size);
    while (guard++ < 200 && size > MIN_SIZE_PX && (m.width > maxW || m.height > maxH)) {
      size = Math.max(MIN_SIZE_PX, size - 2);
      m = measureText(layer, size);
    }
    return Math.round(size);
  }

  // Conversion vers l'unite cqw (pourcentage de la largeur du conteneur), la
  // MEME que celle deja utilisee pour la taille de police : le calcul reste
  // independant du zoom d'apercu et suit la resolution de sortie.
  function toCqw(px, cw) { return (px / cw * 100) + "cqw"; }

  // Ombre portee sophistiquee, sans reglage d'angle : Distance decale toujours
  // vers le bas. Spread (%) reprend le comportement Photoshop, un compromis
  // entre etalement dur et flou doux : a 0 %, un flou pur de rayon `size` ; a
  // 100 %, un tampon net de rayon `size`, sans flou. Entre les deux, le texte
  // est tamponne sur un cercle de rayon `size*spread/100`, puis floute par le
  // reste (`size*(1-spread/100)`), le meme algorithme que le cook Python, pour
  // que l'apercu ne mente jamais sur le fichier livre.
  function buildTextShadow(layer, cw) {
    var s = layer.shadow;
    if (!s || !s.enabled) return "none";
    var size = Math.max(0, s.size == null ? 40 : s.size);
    var strength = Math.max(0, Math.min(100, s.strength == null ? 40 : s.strength));
    if (strength <= 0.01) return "none";
    // Compatibilite : un ancien calque porte encore distance/spread.
    var spreadPct = Math.max(0, Math.min(100, s.spread || 0));
    var spreadPx = size * (spreadPct / 100);
    var blurPx = size * (1 - spreadPct / 100);
    var distancePx = s.distance || 0;
    var color = "rgba(0,0,0,.65)";
    var points = spreadPx > 0.05 ? 12 : 1;
    var base = [];
    for (var i = 0; i < points; i++) {
      var angle = points > 1 ? (i / points) * Math.PI * 2 : 0;
      var dx = points > 1 ? spreadPx * Math.cos(angle) : 0;
      var dy = distancePx + (points > 1 ? spreadPx * Math.sin(angle) : 0);
      base.push(toCqw(dx, cw) + " " + toCqw(dy, cw) + " " + toCqw(blurPx, cw) + " " + color);
    }
    // La densite vient de la REPETITION du meme voile, exactement comme le cook
    // recompose son calque : alpha = 1 - (1 - a)^n, degrade conserve.
    var passes = Math.max(1, Math.round(strength / 10));
    var parts = [];
    for (var p = 0; p < passes; p++) parts = parts.concat(base);
    return parts.join(", ");
  }

  function renderTextLayers() {
    textLayersEl.innerHTML = "";
    var cw = canvasWidth();
    currentLayers().forEach(function (layer) {
      var effective = fitSize(layer);
      layer.effectiveSizePx = effective;
      if (!layer.value.trim()) return;
      var parts = layer.anchor.split("-");
      var el = document.createElement("div");
      el.className = "text-layer font-" + layer.font +
        " anchor-v-" + parts[0] + " anchor-h-" + parts[1];
      el.style.fontWeight = layer.weight;
      el.style.color = layer.color;
      el.style.fontSize = (effective / cw * 100) + "cqw";
      el.style.textShadow = buildTextShadow(layer, cw);
      el.textContent = layer.value;
      textLayersEl.append(el);
    });
    refreshLayerReadouts();
  }

  // ---------- panneau photo ----------

  var controlRegistry = [];

  // Crans de pourcentage : 0, 25, 50, 75 et 100 pour cent de la PLAGE du
  // parametre, pas une valeur absolue. Un reglage qui va de -100 a 100 donne
  // donc -100, -50, 0, 50 et 100 : le cran du milieu est toujours le neutre,
  // quel que soit le parametre, ce qui rend les crans lisibles d'une ligne a
  // l'autre. Les crans 25 et 75 sont dessines plus petits que 0, 50 et 100,
  // qui sont les trois reperes principaux.
  var STEP_MARKS = [0, 25, 50, 75, 100];

  function steppedValue(min, max, percent) {
    return Number(min) + (Number(max) - Number(min)) * (percent / 100);
  }

  /* 2026-09-03 : l'affichage arrondissait a l'entier, donc un zoom de 1,09 se lisait « 1 ».
     La valeur ecrite dans le modele etait juste, seul l'affichage mentait. Le nombre de
     decimales se deduit du PAS, et les zeros inutiles tombent : 1,5 plutot que 1,50. */
  function afficherValeur(v, step) {
    var s = Number(step) || 1;
    if (s >= 1) return String(Math.round(Number(v)));
    var decimales = (String(s).split(".")[1] || "").length;
    return String(Number(Number(v).toFixed(decimales)));
  }

  function slider(parent, label, path, min, max, value, step) {
    var block = document.createElement("div");
    block.className = "control-block";

    var row = document.createElement("label");
    row.className = "zr-photo-control";
    var name = document.createElement("span");
    name.textContent = label;
    var input = document.createElement("input");
    input.type = "range";
    input.min = min; input.max = max; input.step = step || 1; input.value = value;
    var output = document.createElement("output");
    output.value = afficherValeur(value, step);

    function commit(v) {
      input.value = v;
      output.value = afficherValeur(v, step);
      writePath(path, Number(v));
      scheduleRender();
    }

    input.addEventListener("input", function () { commit(Number(input.value)); });
    row.append(name, input, output);
    block.append(row);

    var extra = document.createElement("div");
    extra.className = "control-extra";
    STEP_MARKS.forEach(function (percent) {
      var mark = document.createElement("button");
      mark.type = "button";
      mark.className = "step" + (percent === 25 || percent === 75 ? " minor" : "");
      mark.textContent = percent;
      mark.title = percent + " % de la plage";
      mark.addEventListener("click", function () {
        commit(steppedValue(min, max, percent));
      });
      extra.append(mark);
    });

    // Propagation PONCTUELLE : la valeur est recopiee dans toutes les images au
    // moment du clic, et rien n'est lie ensuite. Chaque image reste modifiable
    // seule, sans que les autres bougent.
    var toAll = document.createElement("button");
    toAll.type = "button";
    toAll.className = "apply-all";
    toAll.textContent = "à toutes";
    toAll.title = "Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.";
    toAll.addEventListener("click", function () {
      applyPathToAll(path, Number(input.value));
      flash(toAll);
    });
    extra.append(toAll);

    block.append(extra);
    parent.append(block);
    controlRegistry.push({ input: input, output: output, path: path, step: step || 1 });
    return input;
  }

  function flash(button) {
    button.classList.add("done");
    setTimeout(function () { button.classList.remove("done"); }, 700);
  }

  // Ecrit une valeur au meme chemin dans TOUTES les images. Le chemin est
  // resolu une fois (le canal Selective Color courant vaut pour tout le lot),
  // puis chaque jeu de reglages recoit sa propre copie.
  function applyPathToAll(path, value) {
    order.forEach(function (id) { writePath(path, value, id); });
    refreshTileFlags();
  }

  // Copie INTEGRALE des reglages de l'image courante vers toutes les autres,
  // photo et calques de texte compris. Copie profonde, jamais une reference
  // partagee : modifier une image ensuite ne doit toucher qu'elle.
  // La bordure n'entre JAMAIS dans cette diffusion : c'est un lien PAIRE, entre
  // deux voisins precis, jamais une valeur qui a du sens copiee sur tout le
  // lot. La propager casserait le lien de chaque image sur son propre voisin.
  function applyEverythingToAll() {
    var photo = JSON.parse(JSON.stringify(settings[selectedId]));
    var text = JSON.parse(JSON.stringify(layers[selectedId]));
    var crop = JSON.parse(JSON.stringify(crops[selectedId]));
    order.forEach(function (id) {
      if (id === selectedId) return;
      settings[id] = JSON.parse(JSON.stringify(photo));
      layers[id] = JSON.parse(JSON.stringify(text));
      crops[id] = JSON.parse(JSON.stringify(crop));
    });
    refreshTileFlags();
  }

  // `path` designe un chemin dans l'objet de reglages : "saturation",
  // "levels.midtone", ou "selective.ACTIVE.hue" (ACTIVE = canal courant).
  function resolvePath(path) {
    return path.replace("ACTIVE", String(selectedChannel)).split(".");
  }
  // Un chemin prefixe par `crop.` designe le CADRAGE, tout le reste designe les
  // reglages photo. C'est ce routage qui permet au cadrage d'etre un groupe de
  // reglages comme un autre, avec ses crans et sa propagation, sans dupliquer
  // une ligne de code d'interface.
  function rootFor(parts, id) {
    return parts[0] === "crop" ? crops[id || selectedId] : settings[id || selectedId];
  }
  function writePath(path, value, id) {
    var parts = resolvePath(path);
    var node = rootFor(parts, id);
    var start = parts[0] === "crop" ? 1 : 0;
    for (var i = start; i < parts.length - 1; i++) node = node[parts[i]];
    node[parts[parts.length - 1]] = value;
  }
  function readPath(path) {
    var parts = resolvePath(path);
    var node = rootFor(parts);
    var start = parts[0] === "crop" ? 1 : 0;
    for (var i = start; i < parts.length - 1; i++) node = node[parts[i]];
    return node[parts[parts.length - 1]];
  }

  function updateFilterAllBtn() {
    var btn = document.getElementById("applyFilterAllBtn");
    if (!btn) return;
    var f = (current() && current().filter) || "Original";
    btn.textContent = f === "Original" ? "Appliquer Original à toutes" : ("Appliquer " + f + " à toutes");
    btn.title = "Appliquer le filtre " + f + " et son intensité (" + (current() ? current().filterStrength : 100) + "%) à toutes les photos";
  }

  function syncPhotoControls() {
    controlRegistry.forEach(function (control) {
      var value = readPath(control.path);
      control.input.value = value;
      control.output.value = afficherValeur(value, control.step);
    });
    document.querySelectorAll("#filter-buttons button").forEach(function (button) {
      button.setAttribute("aria-pressed", button.dataset.filter === current().filter ? "true" : "false");
    });
    updateFilterAllBtn();
  }

  function buildPhotoControls() {
    var crop = document.getElementById("crop-controls");
    slider(crop, "Zoom", "crop.zoom", 1, 3, 1, 0.01);
    slider(crop, "Position X", "crop.px", 0, 100, 50);
    slider(crop, "Position Y", "crop.py", 0, 100, 50);
    slider(crop, "Rotation °", "crop.rotate", -45, 45, 0, 0.5);

    slider(document.getElementById("vignette-controls"), "Strength", "vignette", 0, 100, 0);
    slider(document.getElementById("grain-controls"), "Strength", "grain", 0, 100, 0);

    var tabs = document.getElementById("selective-tabs");
    CHANNELS.forEach(function (name, index) {
      var button = document.createElement("button");
      button.type = "button";
      button.dataset.channel = index;
      button.title = name;
      button.setAttribute("aria-label", name);
      button.setAttribute("aria-pressed", index === selectedChannel ? "true" : "false");
      button.addEventListener("click", function () {
        selectedChannel = index;
        tabs.querySelectorAll("button").forEach(function (b) {
          b.setAttribute("aria-pressed", Number(b.dataset.channel) === index ? "true" : "false");
        });
        syncPhotoControls();
      });
      tabs.append(button);
    });
    var selective = document.getElementById("selective-controls");
    slider(selective, "Hue", "selective.ACTIVE.hue", -100, 100, 0);
    slider(selective, "Saturation", "selective.ACTIVE.saturation", -100, 100, 0);
    slider(selective, "Luminance", "selective.ACTIVE.luminance", -100, 100, 0);

    var levels = document.getElementById("levels-controls");
    slider(levels, "Input Black", "levels.inputBlack", 0, 100, 0);
    slider(levels, "Midtone", "levels.midtone", 0, 100, 50);
    slider(levels, "Input White", "levels.inputWhite", 0, 100, 100);
    slider(levels, "Output Black", "levels.outputBlack", 0, 100, 0);
