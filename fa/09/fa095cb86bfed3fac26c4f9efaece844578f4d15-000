  source.addEventListener("load", function () {
    var cropped = buildCrop();
    processor.setImage(cropped || source);
    processor.set(current());
    var p = previewSize();
    frame.style.setProperty("--img-ratio", p.w + " / " + p.h);
    status.textContent = source.naturalWidth + " × " + source.naturalHeight + " px";
    buildLayerPanel();
    buildBorderPanel();
    renderBorder();
