<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>zenray-html-hda heavy</title>
<link rel="stylesheet" href="assets/photo-controls/zr-photo-adjustments.css">
<link rel="stylesheet" href="assets/ui/fonts.css">
<script src="assets/ui/zr-ui.js"></script>
<style>
  /* Sept graisses reelles AnthropicSerif, une seule famille CSS : le navigateur
     choisit le fichier via font-weight. InterVariable couvre nativement 100-900. */

  :root {

    --strip-height: 168px;
    --panel-gutter: 412px;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    background:
      radial-gradient(1200px 780px at 12% -8%, var(--zr-ui-line), transparent 62%),
      radial-gradient(980px 720px at 92% 108%, rgba(90,120,190,.13), transparent 60%),
      var(--bg);
    color: var(--text);
    font: 400 13px/1.45 var(--zr-police-sans);
    overflow: hidden;
  }

  header.top {
    position: fixed; top: 0; left: 0; right: var(--panel-gutter); z-index: 30;
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 12px 20px; background: var(--zr-glass-bg);
    backdrop-filter: var(--zr-glass-filter); -webkit-backdrop-filter: var(--zr-glass-filter);
    box-shadow: var(--zr-glass-shadow);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  header.top h1 {
    margin: 0; white-space: nowrap;
    font-family: var(--zr-police-serif); font-size: 20px; font-weight: var(--zr-poids-serif);
  }
  header.top .sub { color: var(--muted); font-size: 11.5px; white-space: nowrap; }
  .field { display: flex; align-items: center; gap: 6px; }
  .field label { color: var(--muted); font-size: 11.5px; }
  .field select {
    background: #0f0f11; color: var(--text); border: 1px solid rgba(255,255,255,.14);
    border-radius: 6px; padding: 4px 7px; font: inherit;
  }
  .spacer { flex: 1; }
  button.primary, button.ghost {
    border: none; border-radius: var(--zr-radius-sm); padding: 9px 15px; transition: var(--zr-transition);
    font: 500 12.5px var(--zr-police-sans); cursor: pointer; white-space: nowrap;
  }
  button.primary { background: var(--accent); color: #17140f; }
  button.ghost { background: transparent; color: var(--accent); border: 1px solid var(--zr-ui-line); }
  button.primary:active, button.ghost:active { transform: translateY(1px); }

  .stage {
    position: fixed; top: var(--top-h, 56px); left: 0; right: var(--panel-gutter); bottom: var(--strip-height);
    display: grid; place-items: center; padding: 18px; overflow: hidden;
    min-width: 0; min-height: 0;
  }
  /* Le cadre porte le RATIO de l'image et se borne au viewport ; le canvas le
     remplit. Un `max-width:100%` sur le canvas seul creait une circularite avec
     un parent inline-block dont la largeur venait du canvas : les deux tombaient
     a zero et l'image, pourtant bien chargee en texture, restait invisible. */
  .frame {
    position: relative; display: block; line-height: 0;
    container-type: inline-size;
    aspect-ratio: var(--img-ratio, 4 / 5);
    height: 100%; width: auto;
    max-width: 100%; max-height: 100%;
    border-radius: 10px; overflow: hidden;
    box-shadow: 0 18px 50px rgba(0,0,0,.5); background: #000;
  }
  .frame canvas { display: block; width: 100%; height: 100%; }
  #source { display: none; }

  /* Grille de composition 3x3, cachee par defaut, submenu Affichage.
     Aucun calcul de contraste en JS : mix-blend-mode: difference inverse
     localement la ligne blanche contre chaque pixel qu'elle recouvre, donc
     elle rend blanche sur fond sombre, noire sur fond clair et grise sur
     fond moyen, pixel par pixel, sans jamais échantillonner l'image. C'est
     le shader demandé, en CSS pur, toujours a jour meme si le cadrage bouge. */
  .zr-grid {
    position: absolute; inset: 0; pointer-events: none;
    display: none; mix-blend-mode: difference;
    background-image:
      linear-gradient(to right,
        transparent calc(33.3333% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(33.3333% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(33.3333% + var(--zr-grid-thickness, 1px) / 2),
        transparent calc(33.3333% + var(--zr-grid-thickness, 1px) / 2)),
      linear-gradient(to right,
        transparent calc(66.6667% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(66.6667% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(66.6667% + var(--zr-grid-thickness, 1px) / 2),
        transparent calc(66.6667% + var(--zr-grid-thickness, 1px) / 2)),
      linear-gradient(to bottom,
        transparent calc(33.3333% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(33.3333% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(33.3333% + var(--zr-grid-thickness, 1px) / 2),
        transparent calc(33.3333% + var(--zr-grid-thickness, 1px) / 2)),
      linear-gradient(to bottom,
        transparent calc(66.6667% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(66.6667% - var(--zr-grid-thickness, 1px) / 2),
        #fff calc(66.6667% + var(--zr-grid-thickness, 1px) / 2),
        transparent calc(66.6667% + var(--zr-grid-thickness, 1px) / 2));
  }
  body.zr-grid-on .zr-grid { display: block; }
  .zr-grid-menu { margin-left: 8px; }
  .zr-grid-menu summary { cursor: pointer; color: var(--muted); font-size: 11.5px; list-style: none; }
  .zr-grid-menu summary::-webkit-details-marker { display: none; }
  .zr-grid-menu[open] summary { color: var(--text); }
  .zr-grid-menu .field { margin-top: 6px; }

  #text-layers { position: absolute; inset: 0; pointer-events: none; }
  #border-layer { position: absolute; inset: 0; pointer-events: none; }
  .border-strip { position: absolute; }
  .text-layer {
    position: absolute; left: 0; right: 0; padding: 0 6%;
    line-height: 1.15; white-space: nowrap;
  }
  .text-layer.font-serif { font-family: AnthropicSerif, "Hiragino Mincho ProN W3", serif; }
  .text-layer.font-sans { font-family: InterVariable, "Hiragino Sans W4", sans-serif; }
  .text-layer.anchor-v-top { top: 6%; }
  .text-layer.anchor-v-middle { top: 50%; transform: translateY(-50%); }
  .text-layer.anchor-v-bottom { bottom: 6%; }
  .text-layer.anchor-h-left { text-align: left; }
  .text-layer.anchor-h-center { text-align: center; }
  .text-layer.anchor-h-right { text-align: right; }

  .strip {
    position: fixed; left: 0; right: var(--panel-gutter); bottom: 0; height: var(--strip-height);
    z-index: 30; display: flex; gap: 12px; align-items: flex-start;
    padding: 12px 20px; overflow-x: auto; overflow-y: hidden;
    background: var(--zr-glass-bg);
    backdrop-filter: var(--zr-glass-filter); -webkit-backdrop-filter: var(--zr-glass-filter);
    box-shadow: var(--zr-glass-shadow);
  }
  .tile {
    position: relative; flex: 0 0 auto; width: 104px;
    background: var(--card); border-radius: 10px; overflow: hidden;
    border: 2px solid transparent; cursor: grab; user-select: none;
    transition: opacity .12s, border-color .12s;
  }
  .tile.selected { border-color: var(--accent); }
  .tile.dragging { opacity: .3; }
  .tile.drop-target { border-color: #fff; }
  .tile .thumb { aspect-ratio: 4 / 5; overflow: hidden; background: #000; pointer-events: none; }
  .tile .thumb img { width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; }
  .tile .meta { display: flex; align-items: center; gap: 5px; padding: 5px 6px; pointer-events: none; }
  .tile .pos {
    background: var(--accent); color: #17140f; border-radius: 4px; padding: 1px 5px;
    font: 400 12px var(--zr-police-serif); flex: 0 0 auto;
  }
  .tile .nm {
    font: 400 9.5px var(--zr-police-sans); color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
  }
  .tile .edited {
    position: absolute; top: 6px; right: 6px; width: 8px; height: 8px;
    border-radius: 50%; background: var(--accent); display: none;
    box-shadow: 0 0 0 2px rgba(0,0,0,.45);
  }
  .tile.has-edits .edited { display: block; }

  .zr-photo-panel { inset: 0 0 0 auto; width: var(--panel-gutter); max-height: 100vh; border-radius: 0; border-left: 1px solid rgba(255,255,255,.1); }
  .zr-photo-panel h2 { font-size: 19px; }
  .zr-photo-panel .current {
    margin: 0 0 10px; padding: 7px 9px; border-radius: 8px;
    background: rgba(255,255,255,.05);
    font: 400 11px var(--zr-police-sans); color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .zr-photo-panel .current b { color: var(--accent); }
  .apply-everything {
    width: 100%; min-height: 30px; margin-bottom: 12px;
    border: 1px solid var(--zr-ui-line); border-radius: 8px;
    background: transparent; color: var(--accent);
    font: 600 11px InterVariable, sans-serif; cursor: pointer;
  }
  .apply-everything.done { background: var(--accent); color: #17140f; }
  .variant-actions { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; margin: -2px 0 6px; }
  .variant-action {
    display: inline-flex; min-height: 30px; align-items: center; justify-content: center; gap: 5px;
    border: 1px solid rgba(255,255,255,.18); border-radius: 8px; background: rgba(255,255,255,.04);
    color: var(--text); font: 600 11px InterVariable, sans-serif; cursor: pointer; padding: 0 4px;
  }
  .variant-action:hover { border-color: var(--zr-ui-line); color: var(--accent); }
  .variant-action.danger:hover { border-color: rgba(238,112,112,.8); color: #ff9f9f; }
  .variant-action:disabled { opacity: .35; cursor: default; }
  .variant-action svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; flex-shrink: 0; }
  .discard-rest-btn {
    display: block; width: 100%; box-sizing: border-box; margin: 0 0 10px;
    padding: 6px 10px; border-radius: 7px;
    border: 1px dashed rgba(238,112,112,.4); background: rgba(238,112,112,.06);
    color: #e57373; font: 500 11px InterVariable, sans-serif; cursor: pointer;
    transition: all .15s ease; text-align: center;
  }
  .discard-rest-btn:hover {
    background: rgba(238,112,112,.15); border-color: #ee7070; color: #ff9f9f;
  }
  .tile .tile-discard {
    position: absolute; top: 3px; right: 3px; width: 18px; height: 18px;
    border-radius: 50%; background: rgba(18,18,20,.85); color: #c4c3b9;
    border: 1px solid rgba(255,255,255,.2); font-size: 13px; line-height: 16px;
    padding: 0; cursor: pointer; display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity .15s, background .15s, color .15s; z-index: 10;
  }
  .tile:hover .tile-discard { opacity: 1; }
  .tile .tile-discard:hover { background: #e5484d; color: #fff; border-color: #e5484d; }

  /* Grillage rouge Cyberpunk 2077 pour photo écartée / discard */
  .cyber-grid-overlay {
    position: absolute; inset: 0; pointer-events: none;
    display: none; z-index: 25;
    background:
      linear-gradient(to right, rgba(255, 0, 60, 0.45) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 0, 60, 0.45) 1px, transparent 1px),
      repeating-linear-gradient(45deg, rgba(255, 0, 60, 0.12) 0, rgba(255, 0, 60, 0.12) 8px, transparent 8px, transparent 16px),
      radial-gradient(ellipse at center, rgba(255, 0, 60, 0.22) 0%, rgba(20, 0, 8, 0.82) 100%);
    background-size: 32px 32px, 32px 32px, auto, 100% 100%;
    box-shadow: inset 0 0 50px rgba(255, 0, 60, 0.65), inset 0 0 100px rgba(255, 0, 60, 0.35);
    border: 2px solid #ff003c;
    animation: cyberGlitchPulse 4s ease-in-out infinite;
  }
  .frame.is-discarded .cyber-grid-overlay {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  @keyframes cyberGlitchPulse {
    0%, 100% { opacity: 0.95; }
    50% { opacity: 0.85; }
  }
  .cyber-grid-badge {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 14px 28px;
    background: rgba(12, 2, 6, 0.92);
    border: 2px solid #ff003c;
    box-shadow: 0 0 30px rgba(255, 0, 60, 0.7), inset 0 0 18px rgba(255, 0, 60, 0.3);
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    text-transform: uppercase; user-select: none;
    line-height: 1.2;
  }
  .cyber-grid-tag {
    font: 700 11px ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #ff003c; letter-spacing: 3px; margin-bottom: 2px;
    text-shadow: 0 0 8px rgba(255, 0, 60, 0.8);
  }
  .cyber-grid-title {
    font: 900 32px ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #ffffff; letter-spacing: 5px;
    text-shadow: 0 0 12px #ff003c, 0 0 24px #ff003c;
  }
  .cyber-grid-sub {
    font: 600 11px ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: #ff859c; letter-spacing: 2px; margin-top: 4px;
    opacity: 0.9;
  }
  .cyber-grid-corners {
    position: absolute; inset: 10px; pointer-events: none;
  }
  .cyber-grid-corners span {
    position: absolute; width: 24px; height: 24px; border: 3px solid #ff003c;
    box-shadow: 0 0 10px rgba(255, 0, 60, 0.8);
  }
  .cyber-grid-corners .c-tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .cyber-grid-corners .c-tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .cyber-grid-corners .c-bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .cyber-grid-corners .c-br { bottom: 0; right: 0; border-left: none; border-top: none; }

  /* Style filmstrip pour photo écartée */
  .tile.discarded {
    border-color: rgba(255, 0, 60, 0.65) !important;
  }
  .tile.discarded .thumb {
    position: relative;
  }
  .tile.discarded .thumb::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(rgba(255, 0, 60, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 0, 60, 0.5) 1px, transparent 1px),
      repeating-linear-gradient(45deg, rgba(255, 0, 60, 0.2) 0, rgba(255, 0, 60, 0.2) 4px, transparent 4px, transparent 8px),
      rgba(255, 0, 60, 0.28);
    background-size: 10px 10px, 10px 10px, auto, 100% 100%;
    box-shadow: inset 0 0 12px rgba(255, 0, 60, 0.8);
  }
  .tile.discarded .thumb::before {
    content: "DISCARD"; position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%);
    font: 800 8px ui-monospace, monospace; color: #fff; background: #ff003c;
    padding: 1px 4px; border-radius: 2px; z-index: 5; letter-spacing: 1px;
    box-shadow: 0 0 6px rgba(255, 0, 60, 0.8);
  }
  .tile.discarded .nm {
    color: #ff003c !important; text-decoration: line-through; opacity: 0.85;
  }
  .tile.discarded .tile-discard {
    opacity: 1; background: #ff003c; color: #fff; border-color: #ff003c;
    font-size: 11px;
  }
  .tile.discarded .tile-discard:hover {
    background: #00e5ff; color: #000; border-color: #00e5ff;
  }
  .cyber-label-badge {
    display: inline-block; margin-left: 6px; padding: 1px 6px; border-radius: 4px;
    background: rgba(255, 0, 60, 0.2); border: 1px solid #ff003c;
    color: #ff003c; font: 700 9.5px ui-monospace, monospace; letter-spacing: 1px;
    text-shadow: 0 0 6px rgba(255, 0, 60, 0.6);
  }
  .variant-action.discard.is-restoring {
    background: rgba(0, 229, 255, 0.12); border-color: #00e5ff; color: #00e5ff;
  }
  .variant-action.discard.is-restoring:hover {
    background: rgba(0, 229, 255, 0.25); color: #fff;
  }

  /* Crans de pourcentage et propagation au lot */
  .control-block { margin-bottom: 9px; }
  .control-extra {
    display: flex; align-items: center; gap: 4px;
    margin: 3px 0 0 112px;
  }
  .control-extra .step {
    min-width: 22px; padding: 1px 5px; border-radius: 5px;
    border: 1px solid rgba(255,255,255,.14); background: #2f2f2f;
    color: var(--muted); font: 400 11px var(--zr-police-serif); cursor: pointer;
  }
  .control-extra .step.minor {
    min-width: 18px; padding: 0 4px; font-size: 8.5px; opacity: .62;
  }
  .control-extra .step:hover { color: var(--text); border-color: rgba(255,255,255,.3); }
  .apply-all {
    margin-left: auto; padding: 2px 8px; border-radius: 5px;
    border: 1px solid var(--zr-ui-line); background: transparent;
    color: var(--accent); font: 600 9.5px InterVariable, sans-serif; cursor: pointer;
    white-space: nowrap;
  }
  .apply-all.done { background: var(--accent); color: #17140f; }

  /* Calques de texte, jusqu'a trois par image */
  .layer-block {
    margin-bottom: 10px; padding: 9px; border-radius: 10px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07);
  }
  .layer-head {
    display: flex; align-items: center; gap: 7px; margin-bottom: 7px;
    font: 600 11px InterVariable, sans-serif; color: var(--muted);
  }
  .layer-head .idx {
    background: var(--accent); color: #17140f; border-radius: 4px; padding: 1px 6px;
    font: 400 12px var(--zr-police-serif);
  }
  .layer-head button {
    margin-left: auto; background: transparent; border: 1px solid rgba(255,255,255,.2);
    color: var(--muted); border-radius: 6px; padding: 3px 8px;
    font: 600 10.5px InterVariable, sans-serif; cursor: pointer;
  }
  .layer-block input[type=text] {
    width: 100%; margin-bottom: 7px; min-height: 32px; padding: 6px 8px;
    border: 0; border-radius: 8px; background: #3a3a3a; color: #fff;
    font: 12px InterVariable, sans-serif;
  }
  .layer-block .row2 { display: flex; gap: 7px; margin-bottom: 7px; }
  .layer-block .row2 select {
    flex: 1; min-width: 0; min-height: 30px; padding: 4px 7px;
    border: 0; border-radius: 7px; background: #3a3a3a; color: #fff;
    font: 11.5px InterVariable, sans-serif;
  }
  .layer-block .size-row { display: flex; align-items: center; gap: 7px; margin-bottom: 7px; }
  .layer-block .size-row input[type=number] {
    width: 78px; min-height: 30px; padding: 4px 7px; border: 0; border-radius: 7px;
    background: #3a3a3a; color: #fff; font: 11.5px InterVariable, sans-serif;
  }
  .layer-block .size-effective { font-size: 10px; color: var(--muted); }
  .layer-block .size-effective.adjusted { color: var(--accent); }
  .layer-block .fx-row { margin-bottom: 7px; }
  .fx-toggle {
    width: 100%; margin-bottom: 6px; padding: 5px 8px; border-radius: 7px;
    border: 1px solid rgba(255,255,255,.16); background: transparent; color: var(--muted);
    font: 600 10.5px InterVariable, sans-serif; cursor: pointer; text-align: left;
  }
  .fx-toggle.on { border-color: var(--zr-ui-line); color: var(--accent); }
  .fx-grid { display: flex; gap: 6px; }
  .fx-grid.disabled { opacity: .38; pointer-events: none; }
  .fx-field { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .fx-field span:first-child { font-size: 9.5px; color: var(--muted); }
  .fx-field input[type=number] {
    width: 100%; min-height: 26px; padding: 3px 6px; border: 0; border-radius: 6px;
    background: #3a3a3a; color: #fff; font: 11px InterVariable, sans-serif;
  }
  .fx-field .fx-unit { font-size: 9px; color: var(--muted); }
  .fx-field input[type=text] {
    width: 100%; min-height: 26px; padding: 3px 6px; border: 0; border-radius: 6px;
    background: #3a3a3a; color: #fff; font: 400 11.5px var(--zr-police-sans);
  }
  .border-side-row { display: flex; gap: 6px; margin-top: 6px; }
  .border-side-row.disabled { opacity: .38; pointer-events: none; }
  .border-side-row button {
    flex: 1; min-width: 0; padding: 6px 4px; border-radius: 7px;
    border: 1px solid rgba(255,255,255,.16); background: transparent; color: var(--muted);
    font: 600 9.5px InterVariable, sans-serif; cursor: pointer;
  }
  .border-side-row button.active { background: var(--accent); border-color: var(--accent); color: #17140f; }
  .border-warning {
    display: none; margin-top: 7px; padding: 6px 8px; border-radius: 7px;
    background: rgba(220,90,60,.18); border: 1px solid rgba(220,90,60,.4);
    color: #ffb199; font: 600 10.5px InterVariable, sans-serif;
  }
  .border-warning.shown { display: block; }
  .layer-block .bottom { display: flex; gap: 10px; align-items: center; }
  .swatches-grid {
    display: grid;
    grid-template-columns: repeat(7, 18px);
    grid-gap: 5px;
    align-items: center;
    flex: 0 0 auto;
  }
  .swatches-grid.disabled { opacity: .38; pointer-events: none; }
  .border-swatches { margin: 8px 0 3px; }
  .swatch {
    width: 18px; height: 18px; border-radius: 999px; cursor: pointer;
    box-sizing: border-box; padding: 0; margin: 0;
    border: 1px solid rgba(255,255,255,.24);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 1px 2px rgba(0,0,0,.25);
    transition: transform .12s cubic-bezier(.16,1,.3,1), box-shadow .12s ease;
    position: relative; outline: none;
  }
  .swatch:hover {
    transform: scale(1.18); border-color: rgba(255,255,255,.7); z-index: 2;
  }
  .swatch.active {
    box-shadow: 0 0 0 2px var(--accent), inset 0 1px 0 rgba(255,255,255,.5);
    transform: scale(1.08); z-index: 1;
  }
  .swatch-wheel {
    width: 18px; height: 18px; border-radius: 999px;
    background: radial-gradient(circle at center, rgba(255,255,255,.75) 0%, rgba(255,255,255,.25) 18%, transparent 22%),
                conic-gradient(from 0deg, #ff3b30, #f6cf47, #34c759, #00c7be, #007aff, #af52de, #ff3b30);
