          wheelBtn.className = "swatch-wheel" + (layer.color && !PALETTE.some(function (p) { return p && p.hex.toLowerCase() === (layer.color || "").toLowerCase(); }) ? " active" : "");
          wheelBtn.title = "Roue chromatique : " + (layer.color || "#f6cf47");
          colorPickerInput = document.createElement("input");
          colorPickerInput.type = "color";
          colorPickerInput.value = /^#[0-9a-fA-F]{6}$/.test(layer.color) ? layer.color : "#f6cf47";
          var handleColorChange = function (e) {
            layer.color = e.target.value;
            updateActiveColor(layer.color);
