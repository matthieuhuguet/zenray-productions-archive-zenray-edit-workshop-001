      ${g.items.map(it => `
        <button class="item ${NEUFS[it] ? 'neuf' : ''}"
                ${it === COURANT ? 'aria-current="page"' : ''}>
          <span>${it}</span>
          ${NEUFS[it] ? `<span class="badge">${NEUFS[it]}</span>` : ''}
        </button>`).join('')}
    `).join('');
    return `
      <div class="zone" data-open="${ouvert}" data-id="${z.id}">
        <button class="zone-tete">${z.titre}<span class="compte n">${total}</span></button>
        <div class="zone-liste">${listes}</div>
      </div>`;
  }).join('');

  hote.querySelectorAll('.zone-tete').forEach(b => {
    b.addEventListener('click', () => {
      const zone = b.closest('.zone');
      const etait = zone.dataset.open === '1';
      hote.querySelectorAll('.zone').forEach(z => z.dataset.open = '0');
      zone.dataset.open = etait ? '0' : '1';
      majRail();
    });
  });
  hote.querySelectorAll('.item').forEach(b => {
    b.addEventListener('click', () => {
      hote.querySelectorAll('.item').forEach(x => x.removeAttribute('aria-current'));
      b.setAttribute('aria-current','page');
    });
  });

  document.getElementById('railChapitres').innerHTML = NAV.map(z =>
    `<button class="rail-chapitre" data-id="${z.id}" data-on="${z.id==='create'?'1':'0'}">${z.titre}</button>`
  ).join('');
  document.querySelectorAll('.rail-chapitre').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.zone').forEach(z => z.dataset.open = z.dataset.id === b.dataset.id ? '1' : '0');
      document.getElementById('app').dataset.nav = 'sommaire';
      majRail();
    });
  });
}
function majRail(){
  const ouverte = document.querySelector('.zone[data-open="1"]');
  const id = ouverte ? ouverte.dataset.id : null;
  document.querySelectorAll('.rail-chapitre').forEach(b => b.dataset.on = b.dataset.id === id ? '1' : '0');
}

/* ══════════ Les filtres ══════════ */
let filtreActif = 'tout';
function rendreFiltres(){
  const hote = document.getElementById('filtres');
  const compte = c => c === 'tout' ? PIECES.length : PIECES.filter(p => p.fam === c).length;
  hote.innerHTML = FAMILLES.filter(f => compte(f.cle) > 0).map(f =>
    `<button class="filtre" data-cle="${f.cle}" data-on="${f.cle===filtreActif?'1':'0'}">
       ${f.nom}<span class="n">${compte(f.cle)}</span>
     </button>`).join('')
    + `<span class="vues">
         <button class="vue" data-vue="deux" data-on="1">Deux par rangée</button>
         <button class="vue" data-vue="ample" data-on="0">Pleine page</button>
       </span>`;
  hote.querySelectorAll('.filtre').forEach(b => b.addEventListener('click', () => {
    filtreActif = b.dataset.cle;
    hote.querySelectorAll('.filtre').forEach(x => x.dataset.on = x === b ? '1' : '0');
    rendreCollection();
  }));
  hote.querySelectorAll('.vue').forEach(b => b.addEventListener('click', () => {
    hote.querySelectorAll('.vue').forEach(x => x.dataset.on = x === b ? '1' : '0');
    document.getElementById('collection').dataset.vue = b.dataset.vue;
  }));
}

/* ══════════ La collection ══════════ */
function rendreCollection(){
  const hote = document.getElementById('collection');
  const lot = PIECES.filter(p => filtreActif === 'tout' || p.fam === filtreActif);
  hote.innerHTML = lot.map(p => `
    <div class="piece" data-id="${p.id}" role="button" tabindex="0" aria-label="Ouvrir la notice de ${p.titre}">
      <span class="planche">
        ${planche(p,false)}
        <span class="tampon">Emplacement</span>
        <span class="cote">${p.cote}</span>
      </span>
      <span class="legende">
        <h2>${p.titre} <em>${p.sous}</em></h2>
        <span class="cartel">
          <span>${p.famNom}</span><span class="sep">·</span>
          <span class="n">${p.annee}</span><span class="sep">·</span>
          <span>${p.format}</span><span class="sep">·</span>
          <span class="n">${p.poids}</span>
        </span>
        <span class="notice-courte">${p.court}</span>
      </span>
    </div>`).join('');
  hote.querySelectorAll('.piece').forEach(b => {
    b.addEventListener('click', () => ouvrirNotice(Number(b.dataset.id)));
    b.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ouvrirNotice(Number(b.dataset.id)); }
    });
  });
}

/* ══════════ La notice, le cartel developpe ══════════ */
function ouvrirNotice(id){
  const p = PIECES.find(x => x.id === id);
  const hote = document.getElementById('noticeDedans');
  hote.innerHTML = `
    <button class="retour" id="btnRetour">
      <span aria-hidden="true">&#8592;</span> Retour à la collection
    </button>
    <div class="notice-corps">
      <div class="notice-planche">${planche(p,true)}</div>
      <div class="notice-texte">
        <p class="sur-titre">${p.famNom} <span class="n" style="letter-spacing:.06em">${p.cote}</span></p>
        <h1>${p.titre}<em>${p.sous}</em></h1>
        ${p.long.map(t => `<p>${t}</p>`).join('')}
        <div class="caract">
          ${p.caract.map(([c,v]) => `
            <div class="ligne"><span class="cle">${c}</span>
              <span class="valeur ${/[0-9]/.test(v) ? 'n' : ''}">${v}</span></div>`).join('')}
        </div>
        <div class="actions">
          <button class="action">Ouvrir dans Unreal</button>
          <button class="action">Dupliquer comme base</button>
          <button class="action">Copier le chemin</button>
          <button class="action">Publier sur le site</button>
        </div>
        <div class="emplois">
          <span class="etq">Déjà employé dans</span>
          <ul>${p.emplois.map(e => `<li>${e}</li>`).join('')}</ul>
        </div>
      </div>
    </div>
    <div class="notice-fin"></div>`;
  document.getElementById('notice').dataset.on = '1';
  document.getElementById('notice').scrollTop = 0;
  document.getElementById('btnRetour').addEventListener('click', fermerNotice);
}
function fermerNotice(){ document.getElementById('notice').dataset.on = '0'; }

/* ══════════ Chrome ══════════ */
function basculerTheme(){ document.documentElement.classList.toggle('dark'); }
document.getElementById('btnTheme').addEventListener('click', basculerTheme);
document.getElementById('btnTheme2').addEventListener('click', basculerTheme);
document.getElementById('btnRail').addEventListener('click', () => {
  document.getElementById('app').dataset.nav = 'rail'; majRail();
});
document.getElementById('btnSommaire').addEventListener('click', () => {
  document.getElementById('app').dataset.nav = 'sommaire';
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') fermerNotice(); });

rendreNav(); rendreFiltres(); rendreCollection(); majRail();
</script>
</body>
</html>
