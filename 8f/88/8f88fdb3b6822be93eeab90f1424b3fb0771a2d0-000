<!doctype html>
<html lang="fr" class="">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZenRay Assets, direction Galerie</title>
<style>
  /* Polices SERVIES par le gabarit, jamais attendues du systeme : un repli de police
     ne se signale jamais, seul l'oeil le voit. Les deux familles sont VARIABLES, donc
     trois faces couvrent toutes les graisses employees ici. */
  @font-face{font-family:'Inter';src:url('fonts/InterVariable.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:swap;}
  @font-face{font-family:'AnthropicSerif';src:url('fonts/AnthropicSerif-Romans.woff2') format('woff2');font-weight:300 800;font-style:normal;font-display:swap;}
  @font-face{font-family:'AnthropicSerif';src:url('fonts/AnthropicSerif-Italics.woff2') format('woff2');font-weight:300 800;font-style:italic;font-display:swap;}

/* ══════════════════════════════════════════════════════════════════════════════
   MAQUETTE, direction GALERIE. Aucun fichier du produit n'est touché.
   Modele mental : catalogue d'une maison d'edition, salle d'un musee.
   Beaucoup de vide, une colonne de lecture, serif dominant sur les titres,
   tres peu d'elements d'interface visibles a la fois.
   Les jetons --zr-* reprennent le systeme reel de ZenRayProgress.
   ══════════════════════════════════════════════════════════════════════════════ */

/* ── Polices installees sur ce Mac, chargees en file:// pour un rendu juste au double clic ── */








/* ── L'interface de parametres, un seul endroit pour toutes les valeurs ── */
:root{
  /* familles et graisses, la loi du trio */
  --zr-police-sans:'Inter','Inter Variable','Hiragino Sans W4',-apple-system,Arial,sans-serif;
  --zr-police-serif:'AnthropicSerif','Hiragino Mincho ProN W3',Georgia,'Times New Roman',serif;
  --zr-poids-sans:400;
  --zr-poids-serif:350;
  --zr-poids-nombres:400;

  /* echelle d'interface, un seul nombre commande tout le chrome */
  --zr-ui-base:14px;
  --zr-ui-3xs:calc(var(--zr-ui-base)*0.69);
  --zr-ui-2xs:calc(var(--zr-ui-base)*0.77);
  --zr-ui-xs:calc(var(--zr-ui-base)*0.85);
  --zr-ui-sm:calc(var(--zr-ui-base)*0.92);
  --zr-ui-md:var(--zr-ui-base);
  --zr-ui-lg:calc(var(--zr-ui-base)*1.08);

  /* echelle editoriale, derivee du corps de lecture */
  --gal-corps:17px;
  --gal-titre-1:calc(var(--gal-corps)*2.35);
  --gal-titre-2:calc(var(--gal-corps)*1.52);
  --gal-titre-3:calc(var(--gal-corps)*1.18);

  /* surfaces, reprises du systeme ZenRayProgress */
  --zr-bg-window:#EDEDEB;
  --zr-bg-content:#FDFDFC;
  --zr-r-chip:7px;
  --zr-r-control:10px;
  --zr-r-panel:14px;
  --zr-r-window:22px;
  --zr-accent:#0A84FF;

  /* la matiere GALERIE, papier et encre, aucune surface vitree empilee */
  --gal-mur:#EFEEEA;            /* le mur de la salle, derriere la fenetre */
  --gal-papier:#FBFAF7;         /* la page */
  --gal-papier-2:#F4F2ED;       /* la colonne du sommaire */
  --gal-encre:#22211E;
  --gal-encre-2:rgba(34,33,30,0.62);
  --gal-encre-3:rgba(34,33,30,0.40);
  --gal-filet:rgba(34,33,30,0.13);
  --gal-filet-fort:rgba(34,33,30,0.24);
  --gal-marque:#9A5B3C;         /* sienne, le seul accent, employe au filet */
  --gal-survol:rgba(34,33,30,0.045);
  --gal-ombre:0 18px 60px -22px rgba(40,36,28,0.34), 0 2px 6px rgba(40,36,28,0.06);

  /* les planches, emplacements et non fausses captures */
  --plate-s:16%;
  --plate-l1:93%;
  --plate-l2:85%;
  --plate-lh:58%;
  --plate-trait:rgba(34,33,30,0.30);

  /* rythme */
  --gal-nav:262px;
  --gal-rail:56px;
  --gal-colonne:760px;
  --gal-temps:.34s;
  --gal-courbe:cubic-bezier(.16,1,.3,1);
}

html.dark{
  --zr-bg-window:#232220;
  --zr-bg-content:#1F1F1E;
  --gal-mur:#181816;
  --gal-papier:#1E1D1B;
  --gal-papier-2:#232220;
  --gal-encre:#EDEBE6;
  --gal-encre-2:rgba(237,235,230,0.62);
  --gal-encre-3:rgba(237,235,230,0.38);
  --gal-filet:rgba(237,235,230,0.13);
  --gal-filet-fort:rgba(237,235,230,0.24);
  --gal-marque:#C58A66;
  --gal-survol:rgba(237,235,230,0.055);
  --gal-ombre:0 22px 70px -24px rgba(0,0,0,0.66), 0 2px 8px rgba(0,0,0,0.30);
  --plate-s:14%;
  --plate-l1:22%;
  --plate-l2:16%;
  --plate-lh:42%;
  --plate-trait:rgba(237,235,230,0.24);
  --zr-accent:#409CFF;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--gal-mur);
  color:var(--gal-encre);
  font-family:var(--zr-police-sans);
  font-weight:var(--zr-poids-sans);
  font-size:var(--zr-ui-md);
  -webkit-font-smoothing:antialiased;
  display:grid;
  place-items:center;
  padding:26px;
  transition:background var(--gal-temps) var(--gal-courbe), color var(--gal-temps) var(--gal-courbe);
}
/* halo tres doux du mur, aucune photo, aucun reseau */
body::before{
  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,0.55), rgba(255,255,255,0) 62%);
}
html.dark body::before{background:radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,0.05), rgba(255,255,255,0) 62%)}

.n{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);font-variant-numeric:lining-nums tabular-nums}

/* ══════════════ Le cadre d'application ══════════════ */
.app{
  position:relative;z-index:1;
  width:min(1440px,100%);height:min(920px,calc(100vh - 52px));
  display:grid;grid-template-columns:var(--gal-nav) 1fr;
  background:var(--gal-papier);
  border-radius:var(--zr-r-window);
  box-shadow:var(--gal-ombre);
  overflow:hidden;
  transition:grid-template-columns var(--gal-temps) var(--gal-courbe), background var(--gal-temps) var(--gal-courbe);
}
.app[data-nav="rail"]{grid-template-columns:var(--gal-rail) 1fr}

/* ══════════════ Le sommaire, colonne de gauche ══════════════
   La sidebar n'est pas un tableau de bord, c'est le sommaire d'un catalogue.
   Elle s'efface en un filet vertical quand on ne s'en sert pas. */
.nav{
  position:relative;
  background:var(--gal-papier-2);
  border-right:1px solid var(--gal-filet);
  display:flex;flex-direction:column;
  overflow:hidden;
}
.nav-tete{
  height:64px;flex:0 0 auto;
  display:flex;align-items:center;gap:10px;
  padding:0 20px;
}
.marque{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--gal-titre-3);letter-spacing:-0.015em;line-height:1;
  color:var(--gal-encre);white-space:nowrap;
}
.marque em{font-style:italic;color:var(--gal-encre-2)}

.nav-corps{flex:1 1 auto;overflow-y:auto;padding:6px 14px 24px}
.nav-corps::-webkit-scrollbar{width:8px}
.nav-corps::-webkit-scrollbar-thumb{background:var(--gal-filet-fort);border-radius:8px;border:2px solid transparent;background-clip:content-box}
.nav-corps::-webkit-scrollbar-track{background:transparent}

/* Une rubrique, ouverte ou fermee. Une seule ouverte a la fois. */
.zone{border-top:1px solid var(--gal-filet)}
.zone:first-child{border-top:none}
.zone-tete{
  width:100%;display:flex;align-items:baseline;gap:10px;
  padding:13px 8px 12px;border:0;background:transparent;cursor:pointer;
  text-align:left;color:var(--gal-encre-2);
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--zr-ui-lg);letter-spacing:-0.01em;
  transition:color var(--gal-temps) var(--gal-courbe);
}
.zone-tete:hover{color:var(--gal-encre)}
.zone[data-open="1"] .zone-tete{color:var(--gal-encre)}
.zone-tete .compte{
  margin-left:auto;font-size:var(--zr-ui-xs);color:var(--gal-encre-3);
  transition:opacity var(--gal-temps) var(--gal-courbe);
}
.zone[data-open="1"] .zone-tete .compte{opacity:0}
.zone-liste{display:none;padding:0 0 12px}
.zone[data-open="1"] .zone-liste{display:block}

/* Le sous chapitre, la piece maitresse du redesign :
   il coupe la file de quatorze entrees en deux ensembles nommes. */
.sous-titre{
  display:flex;align-items:center;gap:9px;
  padding:11px 8px 7px;
  font-size:var(--zr-ui-3xs);text-transform:uppercase;letter-spacing:.16em;
  color:var(--gal-encre-3);
}
.sous-titre::after{content:"";flex:1;height:1px;background:var(--gal-filet)}

.item{
  position:relative;display:flex;align-items:center;gap:9px;
  width:100%;min-height:31px;padding:0 8px 0 12px;
  border:0;background:transparent;cursor:pointer;text-align:left;
  color:var(--gal-encre-2);
  font-family:var(--zr-police-sans);font-size:var(--zr-ui-md);font-weight:400;
  letter-spacing:-0.012em;border-radius:var(--zr-r-chip);
  transition:color var(--gal-temps) var(--gal-courbe), background var(--gal-temps) var(--gal-courbe);
}
.item:hover{background:var(--gal-survol);color:var(--gal-encre)}
.item::before{
  content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);
  width:2px;height:0;border-radius:2px;background:var(--gal-marque);
  transition:height var(--gal-temps) var(--gal-courbe);
}
.item[aria-current="page"]{color:var(--gal-encre);font-weight:500}
.item[aria-current="page"]::before{height:15px}
.item .badge{
  margin-left:auto;font-size:var(--zr-ui-2xs);color:var(--gal-encre-3);
}
.item.neuf .badge{color:var(--gal-marque)}

.nav-pied{
  flex:0 0 auto;padding:14px 22px 18px;border-top:1px solid var(--gal-filet);
  display:flex;align-items:center;gap:12px;
}
.bare{
  width:30px;height:30px;display:grid;place-items:center;
  border:0;border-radius:var(--zr-r-chip);background:transparent;cursor:pointer;
  color:var(--gal-encre-3);
  transition:color var(--gal-temps) var(--gal-courbe), background var(--gal-temps) var(--gal-courbe);
}
.bare:hover{background:var(--gal-survol);color:var(--gal-encre)}
.bare svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.pied-note{font-size:var(--zr-ui-2xs);color:var(--gal-encre-3);margin-left:auto}

/* Le sommaire efface : un rail de 56px, les cinq chapitres a la verticale. */
.rail{display:none;flex-direction:column;align-items:center;gap:4px;padding:18px 0;height:100%}
.app[data-nav="rail"] .nav-tete,
.app[data-nav="rail"] .nav-corps,
.app[data-nav="rail"] .nav-pied{display:none}
.app[data-nav="rail"] .rail{display:flex}
.rail-chapitre{
  writing-mode:vertical-rl;
  padding:12px 6px;border:0;background:transparent;cursor:pointer;
  color:var(--gal-encre-3);
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--zr-ui-sm);letter-spacing:.10em;
  border-radius:var(--zr-r-chip);
  transition:color var(--gal-temps) var(--gal-courbe), background var(--gal-temps) var(--gal-courbe);
}
.rail-chapitre:hover{color:var(--gal-encre);background:var(--gal-survol)}
.rail-chapitre[data-on="1"]{color:var(--gal-marque)}
.rail .bare{margin-top:auto}

/* ══════════════ La salle, colonne de droite ══════════════ */
.salle{position:relative;display:flex;flex-direction:column;min-width:0;background:var(--gal-papier)}

.barre{
  flex:0 0 auto;height:64px;display:flex;align-items:center;gap:14px;
  padding:0 30px 0 22px;border-bottom:1px solid var(--gal-filet);
}
.fil{display:flex;align-items:baseline;gap:9px;color:var(--gal-encre-3);font-size:var(--zr-ui-sm);min-width:0}
.fil b{font-weight:400;color:var(--gal-encre)}
.recherche{
  margin-left:auto;display:flex;align-items:center;gap:8px;
  min-width:180px;max-width:280px;flex:1 1 auto;
  border-bottom:1px solid var(--gal-filet);padding:5px 2px;
  transition:border-color var(--gal-temps) var(--gal-courbe);
}
.recherche:focus-within{border-bottom-color:var(--gal-encre-3)}
.recherche svg{width:14px;height:14px;flex:0 0 auto;fill:none;stroke:var(--gal-encre-3);stroke-width:1.4}
.recherche input{
  flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--gal-encre);
  font-family:var(--zr-police-sans);font-size:var(--zr-ui-sm);
}
.recherche input::placeholder{color:var(--gal-encre-3)}

.scene{flex:1 1 auto;overflow-y:auto;position:relative}
.scene::-webkit-scrollbar{width:10px}
.scene::-webkit-scrollbar-thumb{background:var(--gal-filet-fort);border-radius:8px;border:3px solid transparent;background-clip:content-box}
.scene::-webkit-scrollbar-track{background:transparent}

.dedans{padding:0 clamp(30px,5vw,72px) 96px}

/* ── Le cartouche d'ouverture, une colonne de lecture et beaucoup de vide ── */
.ouverture{max-width:var(--gal-colonne);padding:78px 0 8px}
.sur-titre{
  font-size:var(--zr-ui-3xs);text-transform:uppercase;letter-spacing:.24em;
  color:var(--gal-marque);margin:0 0 26px;
}
.ouverture h1{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--gal-titre-1);line-height:1.06;letter-spacing:-0.025em;
  margin:0 0 26px;color:var(--gal-encre);
}
.ouverture h1 em{font-style:italic;color:var(--gal-encre-2)}
.chapeau{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:calc(var(--gal-corps)*1.06);line-height:1.62;letter-spacing:-0.005em;
  color:var(--gal-encre-2);margin:0;max-width:60ch;
}
.releve{
  display:flex;flex-wrap:wrap;gap:34px;margin:44px 0 0;
  padding:20px 0 0;border-top:1px solid var(--gal-filet);
}
.releve div{display:flex;flex-direction:column;gap:5px}
.releve dt, .releve .etq{font-size:var(--zr-ui-3xs);text-transform:uppercase;letter-spacing:.16em;color:var(--gal-encre-3)}
.releve .val{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);font-size:var(--gal-titre-3);letter-spacing:-0.01em}

/* ── Le filtre, du texte, jamais des boutons ── */
.filtres{
  display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 22px;
  margin:56px 0 8px;padding-bottom:18px;border-bottom:1px solid var(--gal-filet);
}
.filtre{
  border:0;background:transparent;cursor:pointer;padding:3px 0;
  color:var(--gal-encre-3);
  font-family:var(--zr-police-sans);font-size:var(--zr-ui-sm);letter-spacing:-0.01em;
  display:inline-flex;align-items:baseline;gap:6px;
  transition:color var(--gal-temps) var(--gal-courbe);
}
.filtre:hover{color:var(--gal-encre)}
.filtre[data-on="1"]{color:var(--gal-encre);box-shadow:inset 0 -1px 0 0 var(--gal-marque)}
.filtre .n{font-size:var(--zr-ui-2xs);color:var(--gal-encre-3)}
.vues{margin-left:auto;display:flex;align-items:center;gap:16px}
.vue{
  border:0;background:transparent;cursor:pointer;padding:3px 0;
  color:var(--gal-encre-3);font-size:var(--zr-ui-sm);
  transition:color var(--gal-temps) var(--gal-courbe);
}
.vue:hover{color:var(--gal-encre)}
.vue[data-on="1"]{color:var(--gal-encre);box-shadow:inset 0 -1px 0 0 var(--gal-filet-fort)}

/* ── La collection. Deux pieces par rangee, elles respirent. ── */
.collection{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:82px 58px;margin:62px 0 0;
}
.collection[data-vue="ample"]{grid-template-columns:minmax(0,1fr);gap:96px}
.collection[data-vue="ample"] .piece{max-width:var(--gal-colonne)}

.piece{
  display:flex;flex-direction:column;gap:0;
  border:0;background:transparent;padding:0;cursor:pointer;text-align:left;
  color:inherit;
}
.planche{
  position:relative;width:100%;aspect-ratio:4/3;border-radius:6px;overflow:hidden;
  box-shadow:0 1px 0 var(--gal-filet), 0 14px 34px -20px rgba(40,36,28,0.42);
  transition:transform var(--gal-temps) var(--gal-courbe), box-shadow var(--gal-temps) var(--gal-courbe);
}
html.dark .planche{box-shadow:0 1px 0 var(--gal-filet), 0 16px 40px -22px rgba(0,0,0,0.7)}
.piece:hover .planche{transform:translateY(-4px);box-shadow:0 1px 0 var(--gal-filet), 0 26px 52px -22px rgba(40,36,28,0.44)}
.planche svg{display:block;width:100%;height:100%}
.planche .tampon{
  position:absolute;left:12px;bottom:10px;
  font-size:var(--zr-ui-3xs);text-transform:uppercase;letter-spacing:.18em;
  color:var(--gal-encre-3);
}
.planche .cote{
  position:absolute;right:12px;bottom:9px;
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);
  font-size:var(--zr-ui-xs);color:var(--gal-encre-3);
}

/* La legende, sobre, jamais une fiche technique */
.legende{padding:20px 2px 0}
.legende h2{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--gal-titre-2);line-height:1.2;letter-spacing:-0.02em;
  margin:0 0 8px;color:var(--gal-encre);
}
.legende h2 em{font-style:italic;color:var(--gal-encre-2);font-size:.82em}
.cartel{
  display:flex;flex-wrap:wrap;align-items:baseline;gap:5px 10px;
  font-size:var(--zr-ui-sm);color:var(--gal-encre-3);margin:0 0 12px;
}
.cartel .sep{opacity:.5}
.notice-courte{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:calc(var(--gal-corps)*0.94);line-height:1.6;color:var(--gal-encre-2);
  margin:0;max-width:52ch;
}

/* ══════════════ La notice, le cartel developpe ══════════════
   Surface opaque posee dans la salle, aucun verre empile, aucun ancetre filtrant. */
.notice{
  position:absolute;inset:0;z-index:5;
  background:var(--gal-papier);
  overflow-y:auto;display:none;
}
.notice[data-on="1"]{display:block;animation:monte .38s cubic-bezier(.16,1,.3,1)}
@keyframes monte{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.notice::-webkit-scrollbar{width:10px}
.notice::-webkit-scrollbar-thumb{background:var(--gal-filet-fort);border-radius:8px;border:3px solid transparent;background-clip:content-box}
.retour{
  display:inline-flex;align-items:center;gap:9px;margin:34px 0 0;
  border:0;background:transparent;cursor:pointer;padding:4px 0;
  color:var(--gal-encre-3);font-size:var(--zr-ui-sm);
  transition:color var(--gal-temps) var(--gal-courbe);
}
.retour:hover{color:var(--gal-encre)}
.notice-corps{
  display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);
  gap:clamp(34px,4vw,68px);align-items:start;margin:40px 0 0;
}
.notice-planche{border-radius:8px;overflow:hidden;box-shadow:0 20px 52px -26px rgba(40,36,28,0.5)}
.notice-planche svg{display:block;width:100%;height:auto}
.notice-texte{padding-top:4px;max-width:56ch}
.notice-texte h1{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:calc(var(--gal-corps)*2.0);line-height:1.1;letter-spacing:-0.025em;
  margin:14px 0 10px;
}
.notice-texte h1 em{font-style:italic;color:var(--gal-encre-2);font-size:.72em;display:block;margin-top:8px}
.notice-texte p{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--gal-corps);line-height:1.68;color:var(--gal-encre-2);margin:0 0 16px;
}
.caract{margin:32px 0 0;border-top:1px solid var(--gal-filet)}
.caract .ligne{
  display:flex;align-items:baseline;gap:18px;
  padding:11px 0;border-bottom:1px solid var(--gal-filet);
}
.caract .cle{
  flex:0 0 132px;font-size:var(--zr-ui-3xs);text-transform:uppercase;letter-spacing:.16em;
  color:var(--gal-encre-3);
}
.caract .valeur{font-size:var(--zr-ui-md);color:var(--gal-encre)}
.actions{display:flex;flex-wrap:wrap;gap:10px 26px;margin:32px 0 0}
.action{
  border:0;background:transparent;cursor:pointer;padding:6px 0;
  color:var(--gal-encre);font-family:var(--zr-police-sans);font-size:var(--zr-ui-sm);
  letter-spacing:-0.01em;box-shadow:inset 0 -1px 0 0 var(--gal-filet-fort);
  transition:box-shadow var(--gal-temps) var(--gal-courbe), color var(--gal-temps) var(--gal-courbe);
}
.action:hover{box-shadow:inset 0 -1px 0 0 var(--gal-marque);color:var(--gal-marque)}
.emplois{margin:36px 0 0;padding-top:18px;border-top:1px solid var(--gal-filet)}
.emplois .etq{font-size:var(--zr-ui-3xs);text-transform:uppercase;letter-spacing:.16em;color:var(--gal-encre-3)}
.emplois ul{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
.emplois li{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:calc(var(--gal-corps)*0.92);color:var(--gal-encre-2);
}
.notice-fin{height:90px}

/* Note de maquette, discrete, en bas de la salle */
.note-maquette{
  max-width:var(--gal-colonne);margin:96px 0 0;padding-top:20px;
  border-top:1px solid var(--gal-filet);
  font-size:var(--zr-ui-sm);line-height:1.7;color:var(--gal-encre-3);
}
.note-maquette b{font-weight:500;color:var(--gal-encre-2)}

@media (max-width:1180px){
  .collection{grid-template-columns:minmax(0,1fr);gap:76px}
  .notice-corps{grid-template-columns:minmax(0,1fr)}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none !important;transition:none !important}
}
