    triangle: `<path d="M320 150 L470 350 L170 350 Z" style="fill:none;stroke:var(--plate-trait);stroke-width:1.2"/>
               <path d="M320 210 L410 330 L230 330 Z" style="fill:none;stroke:var(--plate-trait);stroke-width:1.2;opacity:.55"/>`,
    grille:   `<g style="stroke:var(--plate-trait);stroke-width:1.1;opacity:.85">
                 <rect x="200" y="160" width="240" height="160" fill="none"/>
                 <line x1="200" y1="213" x2="440" y2="213"/><line x1="200" y1="266" x2="440" y2="266"/>
                 <line x1="280" y1="160" x2="280" y2="320"/><line x1="360" y1="160" x2="360" y2="320"/>
               </g>`,
    bandes:   `<g style="stroke:var(--plate-trait);stroke-width:1.2">
                 <line x1="180" y1="180" x2="460" y2="180"/><line x1="180" y1="220" x2="460" y2="220" style="opacity:.8"/>
                 <line x1="180" y1="260" x2="460" y2="260" style="opacity:.6"/><line x1="180" y1="300" x2="460" y2="300" style="opacity:.4"/>
               </g>`,
    fissure:  `<path d="M250 140 L300 220 L262 250 L340 340" style="fill:none;stroke:var(--plate-trait);stroke-width:1.4"/>
               <path d="M300 220 L380 200 M262 250 L200 300" style="fill:none;stroke:var(--plate-trait);stroke-width:1.1;opacity:.6"/>`,
    points:   `<g style="fill:var(--plate-trait)">
                 ${Array.from({length:24},(_,i)=>`<circle cx="${222+(i%6)*36}" cy="${186+Math.floor(i/6)*36}" r="${2.2+(i%3)*0.9}"/>`).join('')}
               </g>`,
    fibre:    `<g style="fill:none;stroke:var(--plate-trait);stroke-width:1">
                 ${Array.from({length:7},(_,i)=>`<path d="M170 ${168+i*26} C 270 ${152+i*26}, 380 ${188+i*26}, 470 ${166+i*26}" style="opacity:${0.85-i*0.08}"/>`).join('')}
               </g>`,
    etoile:   `<g style="stroke:var(--plate-trait);stroke-width:1.1">
                 ${Array.from({length:12},(_,i)=>{const a=i*Math.PI/6;return `<line x1="${320+Math.cos(a)*46}" y1="${250+Math.sin(a)*46}" x2="${320+Math.cos(a)*118}" y2="${250+Math.sin(a)*118}" style="opacity:${i%2?0.5:0.9}"/>`}).join('')}
               </g>`,
    cadre:    `<g style="fill:none;stroke:var(--plate-trait);stroke-width:1.2">
                 <rect x="212" y="150" width="196" height="200"/><rect x="238" y="176" width="144" height="120" style="opacity:.55"/>
               </g>`,
    cercle:   `<circle cx="320" cy="250" r="104" style="fill:none;stroke:var(--plate-trait);stroke-width:1.3"/>
               <circle cx="320" cy="250" r="62" style="fill:none;stroke:var(--plate-trait);stroke-width:1.1;opacity:.55"/>`
  };
  return `
  <svg viewBox="0 0 640 480" preserveAspectRatio="xMidYMid slice" role="img"
       aria-label="Emplacement de planche pour ${p.titre}" style="--h:${p.h}">
    <defs>
      <linearGradient id="grad${id}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:hsl(var(--h) var(--plate-s) var(--plate-l1))"/>
        <stop offset="1" style="stop-color:hsl(calc(var(--h) + 22) var(--plate-s) var(--plate-l2))"/>
      </linearGradient>
      <pattern id="hach${id}" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="9" style="stroke:hsl(var(--h) 18% var(--plate-lh));stroke-width:.6;opacity:.30"/>
      </pattern>
    </defs>
    <rect width="640" height="480" fill="url(#grad${id})"/>
    <rect width="640" height="480" fill="url(#hach${id})"/>
    <rect x="22" y="22" width="596" height="436" fill="none"
          style="stroke:var(--plate-trait);stroke-width:1;stroke-dasharray:2 7;opacity:.7"/>
    ${marques[p.mark] || marques.cercle}
