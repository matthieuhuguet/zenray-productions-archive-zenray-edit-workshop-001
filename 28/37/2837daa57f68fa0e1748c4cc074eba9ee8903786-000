/* La nav reelle du produit. Create se scinde en trois sous-groupes : c'est ce qui rend
   les treize entrees lisibles sans rien retirer. */
var NAV = [
  { id:"create", titre:"Create", ouvert:true, sgroupes:[
    { titre:"Travail",       items:[["Create",null],["Assets",128],["Timer",null],["Plan",6],["Goals",4]] },
    { titre:"Bibliothèques", items:[["Media",null],["Notes",null],["Skills",74],["Audio",null],["Shelf",null],["Ref",null]] },
    { titre:"Pilotage",      items:[["Dashboard",null],["Projects",9],["Freelance",null]] }
  ]},
  { id:"gallery", titre:"Gallery", ouvert:true, sgroupes:[
    { titre:null, items:[["Design",null],["Characters",null],["Environments",null]] }
  ]},
  { id:"learn", titre:"Learn", ouvert:true, sgroupes:[
    { titre:null, items:[["Japanese",106]] }
  ]},
  { id:"apps", titre:"Apps", ouvert:false, sgroupes:[
    { titre:null, items:[["Articles",null],["Documents",null],["Features",null]] }
  ]},
  { id:"systeme", titre:"Système", ouvert:false, sgroupes:[
    { titre:null, items:[["Archives",null],["Drive",null],["Index",null],["Trash",null]] }
  ]}
];

var ACTIF = "Assets";
var filtreActif = "tout";

/* Le fond d'une piece : un degrade de sa famille plus un motif dessine, jamais une fausse image.
   On n'a aucun rendu reel sous la main, donc rien ne doit ressembler a un rendu reel. */
function fondDe(fam, i){
  var f = FAMILLES[fam];
  i = i || 0;
  /* SURCHARGE D'INSTANCE : la famille donne la teinte, le rang donne la lumiere.
     Sans elle, trois pieces d'une meme famille rendent trois vignettes identiques
     et la rangee s'aplatit. Ce sont des emplacements, pas de faux rendus. */
  var angle = 146 + (i % 4) * 21;
  var lx = 28 + (i % 3) * 23;
  var ly = 64 - (i % 3) * 18;
  var trames = {
    corps:   "radial-gradient(130px 160px at " + lx + "% " + (ly - 14) + "%, rgba(255,255,255,0.22), transparent 66%)",
    horizon: "linear-gradient(to top, rgba(255,255,255,0.17) 0%, transparent " + (28 + (i % 3) * 9) + "%)",
    bloc:    "repeating-linear-gradient(" + (38 + (i % 3) * 17) + "deg, rgba(255,255,255,0.075) 0 12px, transparent 12px 24px)",
    onde:    "repeating-radial-gradient(circle at " + lx + "% " + ly + "%, rgba(255,255,255,0.095) 0 14px, transparent 14px 28px)",
    grille:  "repeating-linear-gradient(0deg, rgba(255,255,255,0.09) 0 1px, transparent 1px " + (15 + (i % 3) * 5) + "px), repeating-linear-gradient(90deg, rgba(255,255,255,0.09) 0 1px, transparent 1px " + (15 + (i % 3) * 5) + "px)",
    cadre:   "linear-gradient(" + (120 + (i % 3) * 26) + "deg, rgba(255,255,255,0.16), transparent 54%)",
    page:    "repeating-linear-gradient(0deg, rgba(255,255,255,0.10) 0 1px, transparent 1px " + (13 + (i % 3) * 4) + "px)"
  };
  return trames[f.motif] + ", linear-gradient(" + angle + "deg, " + f.t1 + ", " + f.t2 + ")";
}

function rendreNav(){
  var html = "";
  NAV.forEach(function(z){
    var corps = "";
    z.sgroupes.forEach(function(sg){
      var lignes = sg.items.map(function(it){
        var actif = it[0] === ACTIF ? ' aria-current="page"' : "";
        var cnt = it[1] !== null ? '<span class="cnt">' + it[1] + "</span>" : "";
        return '<a class="item" href="#"' + actif + '><span class="pastille"></span>' + it[0] + cnt + "</a>";
      }).join("");
      corps += sg.titre
        ? '<div class="sgroupe"><div class="sgroupe-titre">' + sg.titre + "</div>" + lignes + "</div>"
        : '<div class="sgroupe">' + lignes + "</div>";
    });
    html += '<div class="zone" data-open="' + (z.ouvert ? "true" : "false") + '" data-id="' + z.id + '">'
      + '<button class="zone-tete">' + z.titre + '<span class="chevron">▾</span></button>'
      + '<div class="zone-corps">' + corps + "</div></div>";
  });
  document.getElementById("nav").innerHTML = html;
  document.querySelectorAll(".zone-tete").forEach(function(b){
    b.addEventListener("click", function(){
      var z = b.parentElement;
      z.dataset.open = z.dataset.open === "true" ? "false" : "true";
    });
  });
}

function rendreCompteurs(){
  var familles = Object.keys(FAMILLES).filter(function(k){
    return PIECES.some(function(p){ return p.fam === k; });
  }).length;
  var reemplois = PIECES.reduce(function(s, p){ return s + p.servi.length; }, 0);
  var lots = [[PIECES.length, "pièces"], [familles, "familles"], [reemplois, "réemplois"], ["2019", "depuis"]];
  document.getElementById("compteurs").innerHTML = lots.map(function(l){
    return '<div class="compteur"><div class="n">' + l[0] + '</div><div class="l">' + l[1] + "</div></div>";
  }).join("");
}

function rendreFiltres(){
  var cles = Object.keys(FAMILLES).filter(function(k){
    return PIECES.some(function(p){ return p.fam === k; });
  });
  var html = '<button class="filtre" data-f="tout" aria-pressed="' + (filtreActif === "tout") + '">Toute la collection<span class="n">'
    + PIECES.length + "</span></button>";
  html += cles.map(function(k){
    var n = PIECES.filter(function(p){ return p.fam === k; }).length;
    return '<button class="filtre" data-f="' + k + '" aria-pressed="' + (filtreActif === k) + '">'
      + FAMILLES[k].nom + '<span class="n">' + n + "</span></button>";
  }).join("");
  document.getElementById("filtres").innerHTML = html;
  document.querySelectorAll(".filtre").forEach(function(b){
    b.addEventListener("click", function(){ filtreActif = b.dataset.f; rendreFiltres(); rendreSalle(); });
  });
}

function rendreSalle(){
  var cles = Object.keys(FAMILLES).filter(function(k){
    if (filtreActif !== "tout" && k !== filtreActif) return false;
    return PIECES.some(function(p){ return p.fam === k; });
  });
  document.getElementById("salle").innerHTML = cles.map(function(k){
    var lot = PIECES.filter(function(p){ return p.fam === k; });
    var cartes = lot.map(function(p){
      var i = PIECES.indexOf(p);
      return '<button class="piece" data-i="' + i + '">'
        + '<div class="vue" style="background:' + fondDe(p.fam, i) + '">'
        + '<span class="place">' + p.poids + "</span>"
        + '<span class="lettre">' + p.nom.charAt(0) + "</span></div>"
        + "<h3>" + p.nom + "</h3>"
        + '<div class="meta"><span class="n">' + p.annee + "</span><span>" + p.format + "</span></div>"
        + "<p>" + p.court + "</p></button>";
    }).join("");
    return '<section class="famille"><div class="famille-tete"><h2>' + FAMILLES[k].nom
      + '</h2><span class="n">' + lot.length + '</span><span class="trait"></span></div>'
      + '<div class="pieces">' + cartes + "</div></section>";
  }).join("");
  document.querySelectorAll(".piece").forEach(function(b){
    b.addEventListener("click", function(){ ouvrir(PIECES[+b.dataset.i]); });
  });
}

function ouvrir(p){
  document.getElementById("detail-vue").style.background = fondDe(p.fam, PIECES.indexOf(p));
  document.getElementById("detail-corps").innerHTML =
      '<p class="fam">' + FAMILLES[p.fam].nom + "</p>"
    + "<h2>" + p.nom + "</h2>"
    + '<p class="texte">' + p.long + "</p>"
    + '<div class="fiche">'
    + "<div><dt>Année</dt><dd class=\"n\">" + p.annee + "</dd></div>"
    + "<div><dt>Format</dt><dd>" + p.format + "</dd></div>"
    + "<div><dt>Poids</dt><dd class=\"n\">" + p.poids + "</dd></div>"
    + "<div><dt>Moteur</dt><dd>" + p.moteur + "</dd></div>"
    + "<div><dt>Licence</dt><dd>" + p.licence + "</dd></div>"
    + "</div>"
    + '<div class="servi"><p class="t">A déjà servi dans</p>'
    + p.servi.map(function(s){ return "<span>" + s + "</span>"; }).join("") + "</div>";
  document.getElementById("detail").dataset.on = "true";
  document.getElementById("detail").setAttribute("aria-hidden", "false");
  document.getElementById("voile").dataset.on = "true";
}
function fermer(){
  document.getElementById("detail").dataset.on = "false";
  document.getElementById("detail").setAttribute("aria-hidden", "true");
  document.getElementById("voile").dataset.on = "false";
}
document.getElementById("fermer").addEventListener("click", fermer);
document.getElementById("voile").addEventListener("click", fermer);
document.addEventListener("keydown", function(e){ if (e.key === "Escape") fermer(); });

var btnTheme = document.getElementById("btn-theme");
btnTheme.addEventListener("click", function(){
  var sombre = document.body.classList.toggle("sombre");
  btnTheme.textContent = sombre ? "Thème clair" : "Thème sombre";
});

rendreNav(); rendreCompteurs(); rendreFiltres(); rendreSalle();
</script>
