    let widgetWidth: CGFloat = 360
    let fallbackWidgetHeight: CGFloat = 61
    let dockGap: CGFloat = 8
    let fallbackDockBottomInset: CGFloat = 8
    let dockPreferenceVerticalPadding: CGFloat = 14
    let contentPadding: CGFloat = 7
    let headerHeight: CGFloat = 16
    let contentSpacing: CGFloat = 4
    let headerSpacing: CGFloat = 8
    let actionSpacing: CGFloat = 8
    let cornerRadius: CGFloat = 12
    let headerFontSize: CGFloat = 12
    let titleFontSize: CGFloat = 14
    let iconSize: CGFloat = 12
    let buttonDiameter: CGFloat = 24
