<script>
  let chosen = 'A';
  let currentTheme = 'ivoire';

  const PALETTES = {
    ivoire: { bg: '#FAF8F4', sub: '#F2EFE9', ink: '#181715', muted: '#78746C', hair: 'rgba(24, 23, 21, 0.08)' },
    sepia:  { bg: '#F3EBD9', sub: '#E8DEC8', ink: '#262018', muted: '#786B58', hair: 'rgba(38, 32, 24, 0.10)' },
    nuit:   { bg: '#16171A', sub: '#1E2024', ink: '#EAE8E3', muted: '#8C8A84', hair: 'rgba(255, 255, 255, 0.09)' }
  };

  function pick(letter) {
    chosen = letter;
    ['A', 'B', 'C'].forEach((k) => {
      document.getElementById('card' + k).classList.toggle('selected', k === letter);
      document.getElementById('btn' + k).classList.toggle('active', k === letter);
    });
  }

  function setV(prop, val, id) {
    document.documentElement.style.setProperty(prop, val);
    document.getElementById(id).textContent = val;
  }

  function theme(key) {
    currentTheme = key;
    const p = PALETTES[key];
    document.documentElement.style.setProperty('--bg-page', p.bg);
    document.documentElement.style.setProperty('--bg-sub', p.sub);
    document.documentElement.style.setProperty('--fg-ink', p.ink);
    document.documentElement.style.setProperty('--fg-muted', p.muted);
    document.documentElement.style.setProperty('--line-hair', p.hair);
    document.getElementById('thIvoire').classList.toggle('active', key === 'ivoire');
    document.getElementById('thSepia').classList.toggle('active', key === 'sepia');
    document.getElementById('thNuit').classList.toggle('active', key === 'nuit');
  }

  function copyAll() {
    const cs = getComputedStyle(document.documentElement);
    const txt = [
      'Design Books v2 choisi : ' + chosen,
      'theme=' + currentTheme,
      'size=' + cs.getPropertyValue('--book-size').trim(),
      'lineHeight=' + cs.getPropertyValue('--book-lh').trim(),
      'width=' + cs.getPropertyValue('--book-width').trim()
    ].join(' | ');
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt);
    const b = document.getElementById('copyBtn');
    b.textContent = 'Copié : ' + txt;
    setTimeout(() => { b.textContent = 'Copier le choix'; }, 2200);
  }
</script>
</body>
</html>
