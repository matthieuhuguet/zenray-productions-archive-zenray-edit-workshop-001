#!/bin/bash
# Regenerates fontbook.html by scanning ~/Library/Fonts.
# Run after installing any new font:
#   ~/.claude/skills/zenray-edit/scripts/build-fontbook.sh
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$SKILL_DIR/fontbook.html"

python3 - "$OUT" <<'PY'
import sys, os, html, re
from pathlib import Path

out = Path(sys.argv[1])
font_dir = Path.home() / "Library" / "Fonts"

files = sorted([p for p in font_dir.iterdir()
                if p.suffix.lower() in (".ttf", ".otf")],
               key=lambda p: p.name.lower())

# Fonts already used in ZenRay work get pinned to the top: these are the brand.
BRAND = [
    ("Didonesque-Stencil-Bold.otf", "Display title",
     "The ZenRay headline face. Used for ZENRAY DICTATE and every slide headline."),
    ("GoldenHopes_PERSONAL_USE_ONLY.otf", "Handwritten signature",
     "Used for 'zenray presents'. PERSONAL USE ONLY licence, check before any commercial use."),
    ("AnthropicSans-Medium.ttf", "Body text",
     "Default running text on slides."),
    ("AnthropicSans-SemiBold.ttf", "Body emphasis",
     "Bold runs inside body text, eyebrows, key captions."),
    ("AnthropicSerif-Bold.ttf", "Serif alternative",
     "Used before Didonesque; kept as a fallback display option."),
    ("Abril.ttf", "Serif alternative",
     "Tried for SWITZERLAND, superseded by Didonesque Stencil."),
]
brand_names = {b[0] for b in BRAND}

def family_id(fname):
    return "f_" + re.sub(r"[^A-Za-z0-9]", "_", fname)

def fmt(p):
    return "opentype" if p.suffix.lower() == ".otf" else "truetype"

faces = []
for p in files:
    faces.append(
        f"@font-face {{ font-family:'{family_id(p.name)}'; "
        f"src:url('file://{p}') format('{fmt(p)}'); }}"
    )

def card(p, role=None, note=None):
    fid = family_id(p.name)
    return f"""
  <div class="card{' brand' if role else ''}">
    <div class="meta">
      <div class="name">{html.escape(p.stem)}</div>
      {f'<div class="role">{html.escape(role)}</div>' if role else ''}
      {f'<div class="note">{html.escape(note)}</div>' if note else ''}
    </div>
    <div class="sample" style="font-family:'{fid}'">ZenRay Dictate</div>
    <div class="sample small" style="font-family:'{fid}'">
      ABCDEFGHIJKLM abcdefghijklm 0123456789 &amp; ? !
    </div>
    <code class="path">file://{html.escape(str(p))}</code>
  </div>"""

brand_cards = []
for fname, role, note in BRAND:
    p = font_dir / fname
    if p.exists():
        brand_cards.append(card(p, role, note))

# Group the rest by family prefix so 20 weights of one face don't drown the list.
rest = [p for p in files if p.name not in brand_names]
groups = {}
for p in rest:
    key = re.split(r"[-_]", p.stem)[0]
    groups.setdefault(key, []).append(p)

rest_html = []
for key in sorted(groups, key=str.lower):
    members = groups[key]
    rest_html.append(f'<h3 class="group">{html.escape(key)} '
                     f'<span class="count">{len(members)}</span></h3>')
    rest_html.extend(card(p) for p in members)

doc = f"""<!doctype html>
<html><head><meta charset="utf-8">
<title>ZenRay HTML Photoshop — Font Book</title>
<style>
  {chr(10).join('  ' + f for f in faces)}

  * {{ box-sizing: border-box; }}
  body {{
    margin: 0; padding: 48px 40px 96px;
    background: #fafafa; color: #2b2b2b;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }}
  h1 {{ font-size: 34px; margin: 0 0 6px; }}
  .sub {{ color: #6b6b6b; font-size: 15px; margin-bottom: 40px; }}
  h2 {{
    font-size: 13px; letter-spacing: .14em; text-transform: uppercase;
    color: #8a8a8a; margin: 48px 0 16px;
    border-bottom: 1px solid #e6e6e6; padding-bottom: 10px;
  }}
  h3.group {{
    font-size: 15px; margin: 34px 0 12px; color: #6b6b6b; font-weight: 600;
  }}
  h3 .count {{
    font-size: 12px; color: #a5a5a5; font-weight: 500;
    background: #efefef; border-radius: 20px; padding: 2px 9px; margin-left: 6px;
  }}
  .card {{
    background: #fff; border: 1px solid #e8e8e8; border-radius: 14px;
    padding: 20px 24px; margin-bottom: 12px;
  }}
  .card.brand {{ border-color: #d8c9a4; background: #fffdf6; }}
  .meta {{ display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }}
  .name {{ font-size: 15px; font-weight: 600; }}
  .role {{
    font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    color: #b3862c; background: #fdf6e3; border-radius: 20px; padding: 3px 10px;
  }}
  .note {{ font-size: 13px; color: #8a8a8a; flex-basis: 100%; margin-top: 2px; }}
  .sample {{ font-size: 46px; line-height: 1.25; margin: 14px 0 4px; }}
  .sample.small {{ font-size: 19px; color: #6b6b6b; margin-bottom: 12px; }}
  code.path {{
    display: block; font-size: 12px; color: #7a7a7a;
    background: #f4f4f4; border-radius: 8px; padding: 8px 12px;
    user-select: all; word-break: break-all;
  }}
</style></head>
<body>
  <h1>Font Book</h1>
  <div class="sub">
    {len(files)} fonts installed in ~/Library/Fonts. Click a path to select it,
    then paste it into a <code>@font-face</code> src. Regenerate with
    <code>scripts/build-fontbook.sh</code>.
  </div>

  <h2>ZenRay brand — already used, reuse these first</h2>
  {''.join(brand_cards)}

  <h2>Everything else installed</h2>
  {''.join(rest_html)}
</body></html>
"""

out.write_text(doc, encoding="utf-8")
print(f"wrote {out}  ({len(files)} fonts)")
PY
