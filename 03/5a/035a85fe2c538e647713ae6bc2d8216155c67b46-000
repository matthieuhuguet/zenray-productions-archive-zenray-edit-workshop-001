    +     '<stop offset="0" stop-color="'+r.a+'"/><stop offset="1" stop-color="'+r.b+'"/>'
    +   '</linearGradient></defs>'
    +   '<rect width="200" height="150" fill="url(#'+uid+')"/>'
    +   forme
    + '</svg>'
    + label;
