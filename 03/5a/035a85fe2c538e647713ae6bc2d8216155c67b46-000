/* ── Rendu de la sidebar ──────────────────────────────────────────────────── */
const elNav = document.getElementById('nav');
const elPins = document.getElementById('pins');

elPins.innerHTML = PINS.map(p =>
  '<button class="pin" data-on="'+(p.on?'true':'false')+'" title="'+p.label+'">'
  + glyphe(p.icon) + '<span>'+p.label+'</span></button>'
).join('');

function rendreNav(){
  elNav.innerHTML = NAV.map(z => {
    const total = z.subs.reduce((n,s)=>n+s.items.length,0);
    const corps = z.subs.map(s => {
      const titre = s.label ? '<div class="sub-lbl">'+s.label+'</div>' : '';
      const lignes = s.items.map(it =>
        '<button class="item" data-id="'+it.id+'" data-on="'+(it.actif?'true':'false')+'" data-nom="'+it.label.toLowerCase()+'">'
        + glyphe(it.icon)
        + '<span class="txt">'+it.label+'</span>'
        + (it.neuf ? '<span class="neuf">neuf</span>' : '')
        + (it.tag ? '<span class="tag">'+it.tag+'</span>' : '')
        + '</button>'
      ).join('');
      return '<div class="sub">'+titre+lignes+'</div>';
    }).join('');
    return '<div class="zone" data-zone="'+z.id+'" data-open="'+(z.ouvert?'true':'false')+'">'
      + '<button class="zone-head">'
      +   '<svg class="chev" width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.4 8 10.4l4-4"/></svg>'
      +   '<span class="lbl">'+z.label+'</span><span class="cnt">'+total+'</span>'
      + '</button>'
      + '<div class="zone-body">'+corps+'</div>'
      + '</div>';
  }).join('');

  elNav.querySelectorAll('.zone-head').forEach(b => b.addEventListener('click', () => {
    const z = b.closest('.zone');
    z.dataset.open = z.dataset.open === 'true' ? 'false' : 'true';
  }));
  elNav.querySelectorAll('.item').forEach(b => b.addEventListener('click', () => {
    elNav.querySelectorAll('.item').forEach(o => o.dataset.on = 'false');
    b.dataset.on = 'true';
  }));
}
rendreNav();

/* Filtre de navigation : les zones fermees s'ouvrent d'elles memes des qu'une
   de leurs entrees repond, sinon le filtre mentirait par omission. */
document.getElementById('navfilter').addEventListener('input', e => {
  const q = e.target.value.trim().toLowerCase();
  elNav.querySelectorAll('.zone').forEach(z => {
    let vus = 0;
    z.querySelectorAll('.item').forEach(it => {
      const ok = !q || it.dataset.nom.includes(q);
      it.hidden = !ok; if(ok) vus++;
    });
    z.querySelectorAll('.sub').forEach(s => {
      const reste = [...s.querySelectorAll('.item')].some(i => !i.hidden);
      s.hidden = !reste;
    });
    z.hidden = q && vus === 0;
    if(q && vus) z.dataset.open = 'true';
  });
});

/* ── Rendu de la vue Assets ───────────────────────────────────────────────── */
const elChips = document.getElementById('chips');
const elScroll = document.getElementById('scroll');
const elStage = document.getElementById('stage');
const elDetail = document.getElementById('detail-in');

let filtre = 'tout', requete = '', choisi = null;

const ORDRE = ['personnage','environnement','objet','matiere','systeme','outil'];

function compte(k){ return ASSETS.filter(a => a.rayon === k).length; }

elChips.innerHTML =
  '<button class="chip" data-k="tout" data-on="true">Tout <span class="n">'+ASSETS.length+'</span></button>'
  + ORDRE.map(k => '<button class="chip" data-k="'+k+'">'+RAYONS[k].nom+' <span class="n">'+compte(k)+'</span></button>').join('');

elChips.querySelectorAll('.chip').forEach(c => c.addEventListener('click', () => {
  elChips.querySelectorAll('.chip').forEach(o => o.dataset.on = 'false');
  c.dataset.on = 'true'; filtre = c.dataset.k; rendreGrille();
}));

document.getElementById('find').addEventListener('input', e => {
  requete = e.target.value.trim().toLowerCase(); rendreGrille();
});

function carte(a){
  return '<button class="card" data-id="'+a.id+'" data-on="'+(choisi===a.id?'true':'false')+'">'
    + '<div class="vig">'+vignette(a,false)+'<div class="mark">'+a.nom.charAt(0)+'</div></div>'
    + '<div class="card-body">'
    +   '<div class="card-title">'+a.nom+'</div>'
    +   '<div class="card-meta"><span class="kind">'+a.type+'</span><span class="dot">·</span>'
    +     '<span class="num">'+a.annee+'</span><span class="dot">·</span>'
    +     '<span class="num">'+a.poids+'</span></div>'
    +   '<div class="card-desc">'+a.court+'</div>'
    + '</div></button>';
}

function rendreGrille(){
  const gardes = ASSETS.filter(a => {
    const okF = filtre === 'tout' || a.rayon === filtre;
    const okQ = !requete || (a.nom+' '+a.type+' '+a.court+' '+a.tags.join(' ')).toLowerCase().includes(requete);
    return okF && okQ;
  });

  if(!gardes.length){
    elScroll.innerHTML = '<p class="vide">Rien sur cette étagère pour le moment.</p>';
    return;
  }

  const cles = filtre === 'tout' ? ORDRE : [filtre];
  elScroll.innerHTML = cles.map(k => {
    const lot = gardes.filter(a => a.rayon === k);
    if(!lot.length) return '';
    return '<section class="rayon-bloc">'
      + '<div class="rayon"><h2>'+RAYONS[k].nom+'</h2><span class="cnt">'+lot.length+'</span><span class="rule"></span></div>'
      + '<div class="grid">'+lot.map(carte).join('')+'</div>'
      + '</section>';
  }).join('');

  elScroll.querySelectorAll('.card').forEach(c => c.addEventListener('click', () => ouvrir(c.dataset.id)));
}

function ouvrir(id){
  choisi = choisi === id ? null : id;
  if(!choisi){ fermer(); rendreGrille(); return; }
  const a = ASSETS.find(x => x.id === id);
  const r = RAYONS[a.rayon];

  elDetail.innerHTML =
      '<div class="detail-head">'
    +   '<span class="k">'+r.nom+'</span>'
    +   '<button class="icon-btn" id="ferme" title="Fermer la fiche" aria-label="Fermer la fiche">'
    +     '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg>'
    +   '</button>'
    + '</div>'
    + '<div class="detail-scroll">'
    +   '<div class="detail-vig">'+vignette(a,true)+'</div>'
    +   '<h3>'+a.nom+'</h3>'
    +   '<p class="sous">'+a.court+'</p>'
    +   '<p class="prose">'+a.long+'</p>'
    +   '<dl class="fiche">'
    +     '<div><dt>Type</dt><dd>'+a.type+'</dd></div>'
    +     '<div><dt>Année</dt><dd class="num">'+a.annee+'</dd></div>'
    +     '<div><dt>Volume</dt><dd class="num">'+a.poids+'</dd></div>'
    +     '<div><dt>Format</dt><dd>'+a.format+'</dd></div>'
    +     '<div><dt>Réemplois</dt><dd class="num">'+a.usages+'</dd></div>'
    +     '<div><dt>Mise à jour</dt><dd>'+a.maj+'</dd></div>'
    +   '</dl>'
    +   '<div class="tags">'+a.tags.map(t => '<span class="tag-s">'+t+'</span>').join('')+'</div>'
    + '</div>'
    + '<div class="detail-acts">'
    +   '<button class="btn btn-primary">Réutiliser comme base</button>'
    +   '<button class="btn btn-quiet">Ouvrir</button>'
    +   '<button class="btn btn-quiet">Publier</button>'
    + '</div>';

  elStage.dataset.detail = 'true';
  document.getElementById('detail').setAttribute('aria-hidden','false');
  document.getElementById('ferme').addEventListener('click', () => { choisi = null; fermer(); rendreGrille(); });
  rendreGrille();
}

function fermer(){
  elStage.dataset.detail = 'false';
  document.getElementById('detail').setAttribute('aria-hidden','true');
}

rendreGrille();

/* ── Bascule de theme, elle repeint toute la page ─────────────────────────── */
document.getElementById('theme').addEventListener('click', () => {
  document.documentElement.classList.toggle('zr-dark');
});
