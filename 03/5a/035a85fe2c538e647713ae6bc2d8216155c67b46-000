<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ZenRay Assets, direction Atelier</title>
<style>
  /* Polices SERVIES par le gabarit, jamais attendues du systeme : un repli de police
     ne se signale jamais, seul l'oeil le voit. Les deux familles sont VARIABLES, donc
     trois faces couvrent toutes les graisses employees ici. */
  @font-face{font-family:'Inter';src:url('fonts/InterVariable.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:swap;}
  @font-face{font-family:'AnthropicSerif';src:url('fonts/AnthropicSerif-Romans.woff2') format('woff2');font-weight:300 800;font-style:normal;font-display:swap;}
  @font-face{font-family:'AnthropicSerif';src:url('fonts/AnthropicSerif-Italics.woff2') format('woff2');font-weight:300 800;font-style:italic;font-display:swap;}

/* ═══════════════════════════════════════════════════════════════════════════
   MAQUETTE, direction ATELIER. Aucun fichier du produit n'est touché.
   Tokens repris tels quels du systeme ZenRayProgress (--zr-*, --g9-*).
   Regle typographique : Inter pour l'interface, AnthropicSerif pour les titres
   de contenu et pour TOUS les nombres visibles. Aucune monospace.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Polices installees dans ~/Library/Fonts, chargees en file:// ─────────── */


/* AnthropicSerif est installee en coupes STATIQUES. Pour que la graisse de
   composition 350 tombe sur un vrai dessin plutot que sur un faux gras, la
   coupe Regular couvre la plage 340 a 500 : 350 et 400 y resolvent le meme
   fichier, ce qui est le comportement honnete avec des fontes statiques. */





/* ── Interface de parametres, etage 1 : jetons globaux ────────────────────── */
:root{
  --zr-police-sans:'Inter','Inter Variable','Hiragino Sans W4',-apple-system,sans-serif;
  --zr-police-serif:'AnthropicSerif','Hiragino Mincho ProN W3',Georgia,serif;
  --zr-poids-sans:400; --zr-poids-serif:350; --zr-poids-nombres:400;

  --zr-ui-base:14px;
  --zr-ui-3xs:calc(var(--zr-ui-base)*0.69);
  --zr-ui-2xs:calc(var(--zr-ui-base)*0.77);
  --zr-ui-xs:calc(var(--zr-ui-base)*0.85);
  --zr-ui-sm:calc(var(--zr-ui-base)*0.92);
  --zr-ui-md:var(--zr-ui-base);
  --zr-ui-lg:calc(var(--zr-ui-base)*1.08);
  --zr-ui-xl:calc(var(--zr-ui-base)*1.13);
  --zr-ui-2xl:calc(var(--zr-ui-base)*1.20);
  --zr-ui-3xl:calc(var(--zr-ui-base)*1.33);
  --zr-corps-editeur:17px;
  --zr-titre-1:calc(var(--zr-corps-editeur)*2.00);
  --zr-titre-2:calc(var(--zr-corps-editeur)*1.58);
  --zr-titre-3:calc(var(--zr-corps-editeur)*1.28);

  --zr-r-chip:7px; --zr-r-control:10px; --zr-r-panel:14px; --zr-r-window:22px;
  --zr-accent:#0A84FF; --zr-accent-soft:rgba(10,132,255,0.12);
  --zr-selection:rgba(0,122,255,0.16);

  --zr-bg-window:#EDEDEB; --zr-bg-content:#FDFDFC;
  --zr-glass-bg:rgba(253,253,252,0.62); --zr-glass-bg-strong:rgba(253,253,252,0.80);
  --zr-shadow-panel:0 8px 30px rgba(0,0,0,0.12);
  --zr-shadow-pop:0 12px 40px rgba(0,0,0,0.18),0 2px 8px rgba(0,0,0,0.08);
  --zr-shadow-overlay:0 24px 80px rgba(0,0,0,0.28),0 8px 24px rgba(0,0,0,0.14);

  /* Materiau V9, la matiere reelle de la sidebar */
  --g9-rim-ratio:0.20;
  --g9-fg:rgba(25,27,31,.92);
  --g9-bg:#fff;
  --g9-muted:rgba(25,27,31,.56);
  --g9-soft:rgba(25,27,31,.40);
  --g9-rail:rgba(25,27,31,.16);
  --g9-glass-a:rgba(255,255,255,.76);
  --g9-glass-b:rgba(229,233,239,.42);
  --g9-rim-main:rgb(34 37 43 / calc(0.46 * var(--g9-rim-ratio)));
  --g9-rim-soft:rgb(34 37 43 / calc(0.18 * var(--g9-rim-ratio)));
  --g9-rim-side:rgb(34 37 43 / calc(0.10 * var(--g9-rim-ratio)));
  --g9-outer-line:0 0 0 0 transparent;
  --g9-elev-a:0 14px 38px rgba(62,67,78,.13);
  --g9-elev-b:0 3px 12px rgba(62,67,78,.08);
  --g9-timing:0.35s; --g9-ease:cubic-bezier(.16,1,.3,1);
  --g9-toolbar-glass-a:color-mix(in srgb, var(--g9-glass-a) 80%, #1b1d21 20%);
  --g9-toolbar-glass-b:color-mix(in srgb, var(--g9-glass-b) 80%, #1b1d21 20%);

  --ws-side-a:rgba(255,255,255,.78);
  --ws-side-b:rgba(226,230,235,.54);

  /* Propres a l'Atelier : la carte est OPAQUE, elle ne porte jamais de verre.
     Un verre pose dans un verre n'a plus rien a refracter (loi des ancetres). */
  --at-carte:rgba(255,255,255,.72);
  --at-carte-fort:rgba(255,255,255,.90);
  --at-filet:color-mix(in srgb, var(--g9-fg) 11%, transparent);
  --at-vignette-fond:rgba(25,27,31,.05);
  --at-chaud:#B5713F;         /* accent chaud de l'atelier, le bois et le cuivre */
  --at-chaud-doux:rgba(181,113,63,.13);
}

html.zr-dark{
  --zr-bg-window:#262624; --zr-bg-content:#1F1F1E;
  --zr-glass-bg:rgba(31,31,30,0.58); --zr-glass-bg-strong:rgba(31,31,30,0.80);
  --g9-fg:#fff; --g9-bg:#1c1c1e;
  --g9-muted:rgba(255,255,255,.62);
  --g9-soft:rgba(255,255,255,.46);
  --g9-rail:rgba(255,255,255,.26);
  --g9-glass-a:rgba(255,255,255,.20);
  --g9-glass-b:rgba(255,255,255,.065);
  --g9-rim-main:rgb(255 255 255 / calc(0.72 * var(--g9-rim-ratio)));
  --g9-rim-soft:rgb(255 255 255 / calc(0.16 * var(--g9-rim-ratio)));
  --g9-rim-side:rgb(255 255 255 / calc(0.085 * var(--g9-rim-ratio)));
  --g9-outer-line:0 0 0 .72px rgb(0 0 0 / calc(0.66 * var(--g9-rim-ratio)));
  --g9-elev-a:0 14px 36px rgba(0,0,0,.27);
  --g9-elev-b:0 3px 11px rgba(0,0,0,.15);
  --g9-toolbar-glass-a:color-mix(in srgb, var(--g9-glass-a) 68%, #000 32%);
  --g9-toolbar-glass-b:color-mix(in srgb, var(--g9-glass-b) 68%, #000 32%);
  --ws-side-a:rgba(255,255,255,.135);
  --ws-side-b:rgba(255,255,255,.045);
  --zr-accent:#409CFF; --zr-accent-soft:rgba(64,156,255,0.18);
  --at-carte:rgba(255,255,255,.055);
  --at-carte-fort:rgba(255,255,255,.10);
  --at-filet:color-mix(in srgb, var(--g9-fg) 13%, transparent);
  --at-vignette-fond:rgba(255,255,255,.05);
  --at-chaud:#E0A272;
  --at-chaud-doux:rgba(224,162,114,.16);
}

/* ── Scene, le verre a besoin d'une matiere a refracter ───────────────────── */
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{
  font-family:var(--zr-police-sans);
  font-weight:var(--zr-poids-sans);
  font-size:var(--zr-ui-md);
  color:var(--g9-fg);
  background:#e8e4dd;
  -webkit-font-smoothing:antialiased;
  padding:26px;
  min-height:100%;
}
/* Le fond est peint sur body::before, un pseudo, jamais sur un ancetre du
   verre : un ancetre a filtre casserait le backdrop des panneaux. */
body::before{
  content:"";position:fixed;inset:-6%;z-index:-2;
  background:
    radial-gradient(1100px 780px at 12% 8%,  #f6ece0 0%, rgba(246,236,224,0) 62%),
    radial-gradient(950px 700px at 86% 12%,  #dfe6f2 0%, rgba(223,230,242,0) 60%),
    radial-gradient(900px 900px at 74% 92%,  #efdfd0 0%, rgba(239,223,208,0) 58%),
    radial-gradient(760px 620px at 26% 88%,  #dde7e2 0%, rgba(221,231,226,0) 60%),
    linear-gradient(152deg,#f2ece4 0%,#e4e7ee 48%,#efe3d7 100%);
}
body::after{
  content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:linear-gradient(180deg,rgba(255,255,255,0.22),rgba(226,231,240,0.30));
}
html.zr-dark body{background:#191918}
html.zr-dark body::before{
  background:
    radial-gradient(1100px 780px at 12% 8%,  #35302a 0%, rgba(53,48,42,0) 62%),
    radial-gradient(950px 700px at 86% 12%,  #232a35 0%, rgba(35,42,53,0) 60%),
    radial-gradient(900px 900px at 74% 92%,  #3a2f27 0%, rgba(58,47,39,0) 58%),
    radial-gradient(760px 620px at 26% 88%,  #232b28 0%, rgba(35,43,40,0) 60%),
    linear-gradient(152deg,#20201f 0%,#1b1d21 48%,#241f1b 100%);
}
html.zr-dark body::after{background:linear-gradient(180deg,rgba(31,31,30,0.38),rgba(24,24,23,0.52))}

/* ── Cadre d'application. Aucun filtre ni transform ici, sinon les enfants
      en verre perdent leur backdrop et un position:fixed s'y ancrerait. ──── */
.app{
  display:grid;
  grid-template-columns:264px minmax(0,1fr);
  gap:16px;
  height:calc(100vh - 52px);
  min-height:640px;
  max-width:1560px;
  margin:0 auto;
}

/* ══════════════════════════════════════════════════════════════════════════
   1. LA SIDEBAR
   ══════════════════════════════════════════════════════════════════════════ */
.side{
  position:relative;
  display:flex;flex-direction:column;
  border-radius:var(--zr-r-window);
  padding:14px 12px 12px;
  color:var(--g9-fg);
  background:linear-gradient(135deg,var(--ws-side-a),var(--ws-side-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a), var(--g9-elev-b);
  backdrop-filter:blur(27px) saturate(169%);
  -webkit-backdrop-filter:blur(27px) saturate(169%);
}

.side-top{display:flex;align-items:center;gap:8px;padding:2px 4px 10px}
.side-mark{
  width:26px;height:26px;border-radius:9px;flex:none;
  display:grid;place-items:center;
  background:linear-gradient(140deg,var(--at-chaud),#8d5730);
  color:#fff;font-family:var(--zr-police-serif);font-weight:500;font-size:13px;
  box-shadow:0 2px 7px rgba(120,70,35,.35), inset 0 1px 0 rgba(255,255,255,.4);
}
.side-name{font-size:var(--zr-ui-sm);font-weight:500;letter-spacing:-.01em;flex:1;min-width:0}
.side-name small{display:block;font-size:var(--zr-ui-3xs);font-weight:400;color:var(--g9-soft);letter-spacing:.06em;text-transform:uppercase;margin-top:1px}
.icon-btn{
  width:28px;height:28px;flex:none;padding:0;display:grid;place-items:center;
  border:0;border-radius:9px;background:transparent;color:var(--g9-muted);cursor:pointer;
  transition:background-color var(--g9-timing) var(--g9-ease),color var(--g9-timing) var(--g9-ease);
}
.icon-btn:hover{background:color-mix(in srgb,var(--g9-fg) 8%,transparent);color:var(--g9-fg)}

/* Le filtre de navigation : premiere reponse a la densite, on tape trois
   lettres et les quatorze entrees de Create se reduisent a une. */
.side-search{
  display:flex;align-items:center;gap:9px;height:34px;padding:0 12px;
  border-radius:999px;overflow:hidden;position:relative;color:var(--g9-fg);
  background:linear-gradient(135deg,var(--g9-toolbar-glass-a),var(--g9-toolbar-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side), inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-b);
}
.side-search svg{color:var(--g9-muted);flex:none}
.side-search input{
  min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--g9-fg);
  font-family:var(--zr-police-sans);font-size:var(--zr-ui-sm);font-weight:400;
}
.side-search input::placeholder{color:var(--g9-muted)}

/* Les epingles : quatre destinations tenues au chaud, hors de la liste. */
.pins{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:10px 2px 4px}
.pin{
  height:44px;border:0;cursor:pointer;border-radius:12px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
  background:color-mix(in srgb,var(--g9-fg) 5%,transparent);
  color:var(--g9-muted);font-family:var(--zr-police-sans);font-size:var(--zr-ui-3xs);
  transition:background-color var(--g9-timing) var(--g9-ease),color var(--g9-timing) var(--g9-ease);
}
.pin:hover{background:color-mix(in srgb,var(--g9-fg) 9%,transparent);color:var(--g9-fg)}
.pin[data-on="true"]{background:var(--at-chaud-doux);color:var(--at-chaud)}

.nav{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:6px 0 4px;margin-top:6px}
.nav::-webkit-scrollbar{width:8px}
.nav::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--g9-fg) 16%,transparent);border-radius:8px;border:2px solid transparent;background-clip:content-box}
.nav::-webkit-scrollbar-track{background:transparent}

/* Zone : titre cliquable, compteur a droite, contenu repliable. */
.zone{margin-bottom:2px}
.zone-head{
  display:flex;align-items:center;gap:7px;width:100%;
  min-height:26px;padding:0 10px;margin:8px 0 2px;
  border:0;background:transparent;cursor:pointer;text-align:left;
  color:var(--g9-soft);font-family:var(--zr-police-sans);
  font-size:var(--zr-ui-xs);font-weight:600;letter-spacing:.05em;text-transform:uppercase;
  transition:color var(--g9-timing) var(--g9-ease);
}
.zone-head:hover{color:var(--g9-fg)}
.zone-head .lbl{flex:1;min-width:0}
.zone-head .cnt{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);
  font-size:var(--zr-ui-xs);letter-spacing:0;color:var(--g9-soft);
  text-transform:none;font-variant-numeric:tabular-nums;
}
.zone-head .chev{
  flex:none;color:var(--g9-soft);
  transition:transform var(--g9-timing) var(--g9-ease);
}
.zone[data-open="false"] .chev{transform:rotate(-90deg)}
.zone[data-open="false"] .zone-body{display:none}

/* Sous rubrique : le geste qui casse le bloc de quatorze lignes en trois
   respirations de cinq, six et trois. Filet fin, etiquette minuscule. */
.sub{margin-top:9px}
.sub:first-child{margin-top:2px}
.sub-lbl{
  display:flex;align-items:center;gap:9px;
  padding:0 12px 5px;color:var(--g9-soft);
  font-size:var(--zr-ui-3xs);font-weight:500;letter-spacing:.09em;text-transform:uppercase;
}
.sub-lbl::after{content:"";flex:1;height:1px;background:var(--at-filet)}

.item{
  position:relative;
  display:flex;align-items:center;gap:9px;width:100%;
  min-height:29px;padding:0 10px;
  border:0;border-radius:10px;background:transparent;cursor:pointer;text-align:left;
  color:var(--g9-fg);font-family:var(--zr-police-sans);
  font-size:var(--zr-ui-md);font-weight:400;letter-spacing:-.015em;
  transition:background-color var(--g9-timing) var(--g9-ease),color var(--g9-timing) var(--g9-ease);
}
.item .gl{flex:none;color:var(--g9-muted);transition:color var(--g9-timing) var(--g9-ease)}
.item .txt{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item .tag{
  flex:none;font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);
  font-size:var(--zr-ui-2xs);color:var(--g9-soft);font-variant-numeric:tabular-nums;
}
.item:hover{background:color-mix(in srgb,var(--g9-fg) 6%,transparent)}
.item:hover .gl{color:var(--g9-fg)}
.item[data-on="true"]{background:var(--at-chaud-doux);color:var(--at-chaud);font-weight:500}
.item[data-on="true"] .gl{color:var(--at-chaud)}
.item[data-on="true"] .tag{color:var(--at-chaud)}
.item .neuf{
  flex:none;padding:1px 7px;border-radius:999px;
  background:var(--at-chaud);color:#fff;
  font-size:var(--zr-ui-3xs);font-weight:500;letter-spacing:.02em;
}
.item[hidden]{display:none}

.side-foot{
  display:flex;align-items:center;gap:8px;padding:10px 8px 2px;margin-top:6px;
  border-top:1px solid var(--at-filet);color:var(--g9-muted);font-size:var(--zr-ui-2xs);
}
.side-foot .num{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);color:var(--g9-fg)}
.side-foot .grow{flex:1}

/* ══════════════════════════════════════════════════════════════════════════
   2. LA SCENE, vue ZenRay Assets
   ══════════════════════════════════════════════════════════════════════════ */
.stage{
  position:relative;min-width:0;
  display:grid;grid-template-columns:minmax(0,1fr) 0fr;
  transition:grid-template-columns .42s var(--g9-ease);
  border-radius:var(--zr-r-window);
  background:linear-gradient(135deg,var(--g9-glass-a),var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side), inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a), var(--g9-elev-b);
  backdrop-filter:blur(27px) saturate(169%);
  -webkit-backdrop-filter:blur(27px) saturate(169%);
  overflow:hidden;
}
.stage[data-detail="true"]{grid-template-columns:minmax(0,1fr) 372px}

.main{min-width:0;display:flex;flex-direction:column;overflow:hidden}
.scroll{flex:1;min-height:0;overflow-y:auto;padding:0 26px 28px}
.scroll::-webkit-scrollbar{width:10px}
.scroll::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--g9-fg) 16%,transparent);border-radius:8px;border:3px solid transparent;background-clip:content-box}
.scroll::-webkit-scrollbar-track{background:transparent}

/* En tete editoriale */
.head{padding:26px 26px 0;display:flex;align-items:flex-start;gap:22px}
.head-txt{flex:1;min-width:0}
.eyebrow{
  font-family:var(--zr-police-sans);font-size:var(--zr-ui-3xs);font-weight:500;
  letter-spacing:.16em;text-transform:uppercase;color:var(--at-chaud);
}
h1{
  margin:8px 0 0;font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--zr-titre-1);line-height:1.08;letter-spacing:-.02em;color:var(--g9-fg);
}
.lede{
  margin:9px 0 0;max-width:56ch;color:var(--g9-muted);
  font-size:var(--zr-ui-lg);line-height:1.5;
}
.stats{display:flex;gap:22px;flex:none;padding-top:6px}
.stat{text-align:right}
.stat b{
  display:block;font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);
  font-size:var(--zr-titre-3);line-height:1.1;color:var(--g9-fg);font-variant-numeric:tabular-nums;
}
.stat span{display:block;margin-top:3px;font-size:var(--zr-ui-3xs);letter-spacing:.09em;text-transform:uppercase;color:var(--g9-soft)}

/* Barre d'outils */
.tools{
  position:sticky;top:0;z-index:5;
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  padding:18px 26px 14px;margin-bottom:2px;
  background:linear-gradient(180deg,
     color-mix(in srgb,var(--g9-bg) 62%, transparent) 0%,
     color-mix(in srgb,var(--g9-bg) 62%, transparent) 68%,
     transparent 100%);
}
.chips{display:flex;gap:6px;flex-wrap:wrap;flex:1;min-width:0}
.chip{
  border:0;cursor:pointer;border-radius:999px;padding:6px 13px;
  font-family:var(--zr-police-sans);font-size:var(--zr-ui-sm);font-weight:400;
  color:var(--g9-muted);background:color-mix(in srgb,var(--g9-fg) 6%,transparent);
  transition:background-color var(--g9-timing) var(--g9-ease),color var(--g9-timing) var(--g9-ease);
  white-space:nowrap;display:inline-flex;align-items:center;gap:7px;
}
.chip:hover{background:color-mix(in srgb,var(--g9-fg) 10%,transparent);color:var(--g9-fg)}
.chip[data-on="true"]{background:var(--at-chaud);color:#fff;font-weight:500}
.chip .n{
  font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);
  font-size:var(--zr-ui-2xs);opacity:.72;font-variant-numeric:tabular-nums;
}
.find{
