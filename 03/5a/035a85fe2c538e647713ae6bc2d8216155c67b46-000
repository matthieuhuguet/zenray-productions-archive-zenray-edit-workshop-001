/* ── Vignettes : dessins abstraits, jamais une fausse capture. Le mot
      Emplacement reste visible pour qu'aucune image ne soit prise pour vraie. */
function vignette(a, grande){
  const r = RAYONS[a.rayon];
  const uid = 'g_'+a.id+(grande?'_L':'');
  let forme = '';
  const m = a.motif;
  if(m==='buste'){
    forme = '<circle cx="100" cy="58" r="24" fill="#fff" opacity=".16"/>'
          + '<path d="M56 122c0-26 20-40 44-40s44 14 44 40z" fill="#fff" opacity=".13"/>'
          + '<path d="M100 34v88M62 74h76" stroke="#fff" stroke-opacity=".16" stroke-width="1"/>';
  } else if(m==='horizon'){
    forme = '<path d="M0 108 44 62l30 32 26-26 40 40 60-44v86H0z" fill="#fff" opacity=".14"/>'
          + '<path d="M0 122h200" stroke="#fff" stroke-opacity=".22" stroke-width="1"/>'
          + '<circle cx="152" cy="42" r="15" fill="#fff" opacity=".18"/>';
  } else if(m==='grille'){
    forme = '<g fill="#fff" fill-opacity=".14">'
          + '<rect x="26" y="28" width="60" height="30" rx="8"/><rect x="94" y="28" width="80" height="30" rx="8"/>'
          + '<rect x="26" y="66" width="80" height="30" rx="8"/><rect x="114" y="66" width="60" height="30" rx="8"/>'
          + '<rect x="26" y="104" width="148" height="18" rx="8"/></g>';
  } else if(m==='arche'){
    forme = '<path d="M40 128V54h120v74" stroke="#fff" stroke-opacity=".2" stroke-width="9" fill="none"/>'
          + '<rect x="24" y="38" width="152" height="10" rx="4" fill="#fff" opacity=".2"/>'
          + '<rect x="34" y="60" width="132" height="7" rx="3" fill="#fff" opacity=".16"/>';
  } else if(m==='bandes'){
    forme = '<g>'
          + '<rect x="0" y="0" width="200" height="30" fill="#fff" opacity=".05"/>'
          + '<rect x="0" y="30" width="200" height="26" fill="#fff" opacity=".10"/>'
          + '<rect x="0" y="56" width="200" height="24" fill="#fff" opacity=".16"/>'
          + '<rect x="0" y="80" width="200" height="24" fill="#fff" opacity=".22"/>'
          + '<rect x="0" y="104" width="200" height="46" fill="#fff" opacity=".30"/></g>';
  } else if(m==='ondes'){
    forme = '<g fill="none" stroke="#fff" stroke-width="1.4">'
          + '<path d="M-6 46q26-16 52 0t52 0 52 0 52 0" stroke-opacity=".22"/>'
          + '<path d="M-6 70q26-16 52 0t52 0 52 0 52 0" stroke-opacity=".18"/>'
          + '<path d="M-6 94q26-16 52 0t52 0 52 0 52 0" stroke-opacity=".14"/>'
          + '<path d="M-6 118q26-16 52 0t52 0 52 0 52 0" stroke-opacity=".10"/></g>'
          + '<circle cx="128" cy="70" r="26" fill="none" stroke="#fff" stroke-opacity=".2" stroke-width="1.2"/>';
  } else if(m==='fibres'){
    let l='';
    for(let i=0;i<16;i++){ const y=8+i*9; l += '<path d="M-4 '+y+'q50 '+((i%3)-1)*7+' 104 0t104 0" stroke="#fff" stroke-opacity="'+(0.07+(i%4)*0.035).toFixed(3)+'" stroke-width="1.1" fill="none"/>'; }
    forme = l;
  } else if(m==='noeuds'){
    forme = '<g stroke="#fff" stroke-opacity=".24" stroke-width="1.2" fill="none">'
          + '<path d="M46 44h48v34h60M46 44v62h48"/><path d="M94 78h-24v42h48"/></g>'
          + '<g fill="#fff" fill-opacity=".24">'
          + '<circle cx="46" cy="44" r="7"/><circle cx="154" cy="78" r="7"/><circle cx="118" cy="120" r="7"/><circle cx="70" cy="78" r="5"/><circle cx="94" cy="106" r="5"/></g>';
  } else if(m==='volume'){
    forme = '<g fill="#fff">'
          + '<ellipse cx="100" cy="104" rx="58" ry="20" fill-opacity=".10"/>'
          + '<ellipse cx="94" cy="76" rx="40" ry="26" fill-opacity=".13"/>'
          + '<ellipse cx="108" cy="50" rx="27" ry="20" fill-opacity=".16"/>'
          + '<ellipse cx="98" cy="28" rx="16" ry="12" fill-opacity=".19"/></g>';
  } else if(m==='lame'){
    forme = '<path d="M30 120 148 30l14 12L48 132z" fill="#fff" opacity=".18"/>'
          + '<path d="M40 126 152 38" stroke="#fff" stroke-opacity=".3" stroke-width="1.1"/>'
