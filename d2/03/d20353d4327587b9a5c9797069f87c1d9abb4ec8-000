#!/usr/bin/env node

/**
 * zr-design.mjs
 * Gestionnaire du Registre des 1000+ Designs HDA ZenRay.
 * Permet la recherche instantanée par ID parlant ou mots-clés
 * et l'extraction atomique de composants pour éviter le gaspillage de tokens.
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const REGISTRY_PATH = path.resolve(__dirname, '../templates/designs/index.json');

function loadRegistry() {
  if (!fs.existsSync(REGISTRY_PATH)) {
    console.error(`Registre introuvable : ${REGISTRY_PATH}`);
    process.exit(1);
  }
  return JSON.parse(fs.readFileSync(REGISTRY_PATH, 'utf-8'));
}

function saveRegistry(data) {
  fs.writeFileSync(REGISTRY_PATH, JSON.stringify(data, null, 2), 'utf-8');
}

const [,, cmd, ...args] = process.argv;

if (!cmd || cmd === 'help' || cmd === '--help') {
  console.log(`
Usage:
  node zr-design.mjs list                       # Liste tous les designs indexés
  node zr-design.mjs find <mots-clés / id>      # Recherche rapide par ID ou mot-clé
  node zr-design.mjs get <id>                   # Affiche le détail complet et tokens d'un design
  node zr-design.mjs count                      # Affiche le total et la capacité
`);
  process.exit(0);
}

const reg = loadRegistry();
const designs = Object.values(reg.designs || {});

if (cmd === 'list') {
  console.log(`=== ZENRAY DESIGN REGISTRY (${designs.length} designs indexés) ===\n`);
  console.log(
    'ID'.padEnd(26) +
    'TYPE'.padEnd(12) +
    'NOM'.padEnd(36) +
    'TAGS'
  );
  console.log('-'.repeat(90));
  for (const d of designs) {
    console.log(
      d.id.padEnd(26) +
      d.type.padEnd(12) +
      d.name.padEnd(36) +
      d.tags.slice(0, 4).join(', ')
    );
  }
  process.exit(0);
}

function stripAccents(str) {
  return (str || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
}

if (cmd === 'find') {
  const rawQuery = args.join(' ').trim();
  const query = stripAccents(rawQuery);
  if (!query) {
    console.error('Spécifier un terme de recherche. Exemple : node zr-design.mjs find "luxe epure"');
    process.exit(1);
  }

  const matches = designs.filter(d =>
    stripAccents(d.id).includes(query) ||
    stripAccents(d.name).includes(query) ||
    stripAccents(d.description).includes(query) ||
    d.tags.some(t => stripAccents(t).includes(query))
  );

  if (matches.length === 0) {
    console.log(`Aucun design trouvé pour "${query}".`);
    process.exit(0);
  }

  console.log(`Trouvé ${matches.length} design(s) pour "${query}" :\n`);
  for (const m of matches) {
    console.log(`[${m.id}] ${m.name} (${m.type})`);
    console.log(`  Description : ${m.description}`);
    console.log(`  Fichier     : ${m.file}`);
    console.log(`  Composants  : ${m.components?.join(', ')}`);
    console.log('');
  }
  process.exit(0);
}

if (cmd === 'get') {
  const id = args[0];
  if (!id) {
    console.error('Spécifier un ID. Exemple : node zr-design.mjs get luxe-epure');
    process.exit(1);
  }

  const design = reg.designs[id];
  if (!design) {
    console.error(`Design non trouvé pour l'ID "${id}".`);
    process.exit(1);
  }

  console.log(JSON.stringify(design, null, 2));
  process.exit(0);
}

if (cmd === 'count') {
  console.log(`Total designs enregistrés : ${designs.length} (Capacité cible : ${reg.targetCapacity})`);
  process.exit(0);
}

console.error(`Commande inconnue : "${cmd}". Utiliser --help.`);
process.exit(1);
