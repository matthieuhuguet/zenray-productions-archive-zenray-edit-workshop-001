    // Mettre a jour le corps AI
    document.querySelectorAll('.data-ai-long').forEach(el => {
      el.innerHTML = data.aiLong.map(p => `<p style="margin:0 0 10px;" ${modeEdition ? 'contenteditable="true"' : ''}>${p}</p>`).join('');
    });

    // Mettre a jour l'entete Role
    document.querySelectorAll('.data-role-header').forEach(el => {
      el.textContent = data.roleHeader;
      if (modeEdition) el.setAttribute('contenteditable', 'true');
    });

    // Mettre a jour les points Role
    document.querySelectorAll('.data-role-points').forEach(el => {
      el.innerHTML = data.rolePoints.map((pt, i) => `
        <li class="capsule-point-item">
          <span class="capsule-point-num">${i + 1}.</span>
          <span ${modeEdition ? 'contenteditable="true"' : ''}>${pt}</span>
        </li>
      `).join('');
    });
  }

  function changerLangue(lang, btn) {
    langueActive = lang;
    document.querySelectorAll('.btn-opt').forEach(b => b.classList.remove('actif'));
    btn.classList.add('actif');
    injecterContenu();
  }

  function toggleCapsule(id) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('est-ouvert');
  }

  let toutDeplie = false;
  function toggleTout() {
    toutDeplie = !toutDeplie;
    document.querySelectorAll('[id^="p1-"], [id^="p2-"], [id^="p3-"], [id^="p4-"]').forEach(el => {
      if (toutDeplie) el.classList.add('est-ouvert');
      else el.classList.remove('est-ouvert');
    });
    const label = document.getElementById('btn-tout-label');
    if (label) label.textContent = toutDeplie ? 'Tout Replier' : 'Tout Déplier';
  }

  function toggleElementProp4(className, hide) {
    document.querySelectorAll('.capsule-p4').forEach(el => {
      if (hide) el.classList.add(className);
      else el.classList.remove(className);
    });
  }

  function setTransitionMode(mode, btn) {
    document.querySelectorAll('.capsule-p4').forEach(el => {
      if (mode === 'fade') el.classList.add('mode-fade-theme');
      else el.classList.remove('mode-fade-theme');
    });
    const btnSoft = document.getElementById('btn-trans-soft');
    const btnFade = document.getElementById('btn-trans-fade');
    if (btnSoft && btnFade) {
      if (mode === 'fade') {
        btnFade.classList.add('actif');
        btnSoft.classList.remove('actif');
      } else {
        btnSoft.classList.add('actif');
        btnFade.classList.remove('actif');
      }
    }
    const radios = document.querySelectorAll('input[name="trans-mode"]');
    radios.forEach(r => { if (r.value === mode) r.checked = true; });
  }

  function toggleTheme() {
    const body = document.body;
    body.classList.toggle('sombre');
    const estSombre = body.classList.contains('sombre');
    document.getElementById('theme-label').textContent = estSombre ? 'Mode Clair' : 'Mode Sombre';
  }

  function toggleTextEdit() {
    modeEdition = !modeEdition;
    const btn = document.getElementById('btn-edit-text');
    if (modeEdition) {
      btn.classList.add('mode-on');
      btn.textContent = 'Mode Édition : ACTIF';
    } else {
      btn.classList.remove('mode-on');
      btn.textContent = 'Mode Édition Texte';
    }
    injecterContenu();
  }

  function updateToken(token, val, labelId) {
    document.documentElement.style.setProperty(token, val);
    if (labelId) document.getElementById(labelId).textContent = val;
  }

  function copierValeursCSS() {
    const rootStyle = getComputedStyle(document.documentElement);
    const tokens = [
      '--capsule-r-closed',
      '--capsule-r-open',
      '--capsule-pad-y',
      '--capsule-pad-x',
      '--capsule-title-size',
      '--capsule-body-size',
      '--capsule-bg-alpha',
      '--capsule-border-alpha',
      '--capsule-blur',
      '--points-gap'
    ];
    const cssText = tokens.map(t => `${t}: ${rootStyle.getPropertyValue(t).trim()};`).join('\n');
    navigator.clipboard.writeText(cssText).then(() => {
      const fb = document.getElementById('feedback-css');
      fb.textContent = 'Variables CSS copiées !';
      setTimeout(() => { fb.textContent = ''; }, 3000);
    });
  }

  function copierTextesEdites() {
    // Récupère les textes de la proposition 1 pour exporter les modifications faites
    const p1 = document.getElementById('p1-ai');
    const p1Role = document.getElementById('p1-role');

    const aiShort = p1.querySelector('.data-ai-short')?.textContent.trim();
    const aiParas = Array.from(p1.querySelectorAll('.data-ai-long p')).map(p => p.textContent.trim());
    const roleShort = p1Role.querySelector('.data-role-short')?.textContent.trim();
    const roleHeader = p1Role.querySelector('.data-role-header')?.textContent.trim();
    const rolePoints = Array.from(p1Role.querySelectorAll('.data-role-points li span:last-child')).map(s => s.textContent.trim());

    const exported = {
      lang: langueActive,
      aiShort,
      aiLong: aiParas,
      roleShort,
      roleHeader,
      rolePoints
    };

    navigator.clipboard.writeText(JSON.stringify(exported, null, 2)).then(() => {
      alert('Textes actuels (' + langueActive.toUpperCase() + ') copiés au format JSON dans le presse-papier !');
    });
  }

  // Initialisation
  window.addEventListener('DOMContentLoaded', () => {
    injecterContenu();
  });
</script>

</body>
</html>
