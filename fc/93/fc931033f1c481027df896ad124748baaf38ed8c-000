<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ZenRay Books v3 · 3 Propositions Shelf + Design C Double-Page Livre Ouvert · 18 October 2026</title>
<style>
  /* 18 October 2026 : Uniquement AnthropicSerif Medium (500) et InterVariable Medium (500). Zéro Light. */
  @font-face {
    font-family: 'InterVariable';
    src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/InterVariable.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: 'AnthropicSerif';
    src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/AnthropicSerif-Medium.ttf') format('truetype');
    font-weight: 500;
    font-display: swap;
  }
  @font-face {
    font-family: 'AnthropicMono';
    src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/AnthropicMono-Medium.ttf') format('truetype');
    font-weight: 500;
    font-display: swap;
  }

  :root {
    --zr-police-sans: 'InterVariable', 'Hiragino Sans W4', 'Hiragino Sans', sans-serif;
    --zr-police-serif: 'AnthropicSerif', 'Hiragino Mincho ProN W3', serif;
    --zr-police-mono: 'AnthropicMono', ui-monospace, monospace;
    --zr-poids-sans: 500;
    --zr-poids-serif: 500;
    --zr-poids-nombres: 500;

    /* Paramètres HDA (18 October 2026) */
    --shelf-cols: 5;
    --shelf-gap: 24px;
    --cover-radius: 6px;
    --book-size: 18px;
    --book-lh: 1.72;
    --book-width: 54ch;
    --page-pad: 44px;
    --win-radius: 14px;

    /* Thème Papier Clair Apple Books par défaut */
    --bg-page: #FAF8F4;
    --bg-sub: #F2EFE9;
    --fg-ink: #181715;
    --fg-muted: #78746C;
    --line-hair: rgba(24, 23, 21, 0.08);
    --card-surface: rgba(24, 23, 21, 0.03);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #0E0F11;
    color: #F2F2F4;
    font-family: var(--zr-police-sans);
    font-weight: 500;
    padding: 20px 24px 56px;
    -webkit-font-smoothing: antialiased;
  }

  .num {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Barre HDA compacte en haut */
  .hda-bar {
    max-width: 1420px;
    margin: 0 auto 22px;
    background: #151619;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hda-left {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .hda-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 19px;
    color: #FFFFFF;
  }

  .hda-sub {
    font-size: 12px;
    color: rgba(242, 242, 244, 0.52);
  }

  .hda-sliders {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .s-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: rgba(242, 242, 244, 0.72);
  }

  .s-item input[type="range"] {
    width: 72px;
    accent-color: #FFFFFF;
    cursor: pointer;
  }

  .chip-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .chip {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: #EAEAEF;
    font-family: var(--zr-police-sans);
    font-weight: 500;
    font-size: 11.5px;
    padding: 5px 10px;
    border-radius: 8px;
    cursor: pointer;
  }

  .chip.active {
    background: #FFFFFF;
    color: #111214;
    border-color: #FFFFFF;
  }

  .copy-btn {
    background: #FFFFFF;
    color: #111214;
    border: none;
    border-radius: 8px;
    padding: 7px 13px;
    font-family: var(--zr-police-sans);
    font-weight: 500;
    font-size: 12px;
    cursor: pointer;
  }

  /* Pile des 3 propositions Shelf + Design C Lecteur */
  .stack {
    max-width: 1420px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .card {
    background: #141518;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    cursor: pointer;
  }

  .card.selected {
    border-color: rgba(255, 255, 255, 0.48);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card-head-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .badge-letter {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.10);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 13px;
  }

  .card.selected .badge-letter {
    background: #FFFFFF;
    color: #111214;
  }

  .card-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 17px;
    color: #FFFFFF;
  }

  .card-note {
    font-size: 12px;
    color: rgba(242, 242, 244, 0.52);
  }

  /* Fenêtre ZenRayProgress ultra-propre */
  .app-frame {
    display: grid;
    grid-template-columns: 164px 1fr;
    min-height: 440px;
    border-radius: var(--win-radius);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--bg-page);
    color: var(--fg-ink);
  }

  .sidebar {
    background: #121316;
    color: rgba(242, 242, 244, 0.64);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 12.5px;
  }

  .traffic {
    display: flex;
    gap: 6px;
    padding: 2px 6px 16px;
  }

  .traffic span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .s-nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .s-link {
    padding: 7px 10px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .s-link.active {
    background: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
  }

  .s-foot {
    font-size: 11px;
    color: rgba(242, 242, 244, 0.40);
    padding: 0 6px;
  }

  /* Surface papier commune aux Shelves et au Lecteur Design C */
  .paper-surface {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-page);
    color: var(--fg-ink);
  }

  .quiet-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 34px;
    font-size: 12.5px;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--line-hair);
  }

  .quiet-brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .quiet-brand-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 17px;
    color: var(--fg-ink);
  }

  .quiet-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--fg-muted);
    font-size: 12.5px;
  }

  .quiet-actions span.active-tab {
    color: var(--fg-ink);
    border-bottom: 1.5px solid var(--fg-ink);
    padding-bottom: 2px;
  }

  .quiet-bottom {
    padding: 13px 34px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    color: var(--fg-muted);
    border-top: 1px solid var(--line-hair);
    gap: 20px;
  }

  .hair-progress {
    flex: 1;
    max-width: 240px;
    height: 2px;
    background: var(--line-hair);
    border-radius: 99px;
    overflow: hidden;
  }

  .hair-fill {
    width: 33%;
    height: 100%;
    background: var(--fg-ink);
  }

  /* =========================================================
     PROPOSITION SHELF A : GRILLE PORTRAIT 2:3 PURE (APPLE BOOKS / SHELF.JSX ÉPURÉ)
     ========================================================= */
  .shelf-a-wrap {
    padding: 28px 34px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(var(--shelf-cols), minmax(0, 1fr));
    gap: var(--shelf-gap);
  }

  .book-item {
    display: flex;
    flex-direction: column;
    gap: 9px;
    cursor: pointer;
  }

  .book-cover {
    aspect-ratio: 2 / 3;
    border-radius: var(--cover-radius);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08), inset 2px 0 0 rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(24, 23, 21, 0.08);
  }

  .cover-tag {
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .cover-serif-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.22;
  }

  .cover-author {
    font-size: 10.5px;
    opacity: 0.78;
  }

  .book-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .book-meta-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 13.5px;
    color: var(--fg-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-meta-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--fg-muted);
  }

  .mini-bar {
    height: 2px;
    background: var(--line-hair);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 2px;
  }

  .mini-bar > div {
    height: 100%;
    background: var(--fg-ink);
  }

  /* =========================================================
     PROPOSITION SHELF B : DOUBLE-NIVEAU (TABLE DE CHEVET CREATE/BOOKS + CATALOGUE SHELF.JSON)
     ========================================================= */
  .shelf-b-wrap {
    padding: 24px 34px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .section-kicker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }

  .section-kicker strong {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 14px;
    color: var(--fg-ink);
  }

  .desk-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .desk-card {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 16px;
    padding: 14px 16px;
    border-radius: 10px;
    background: var(--bg-sub);
    border: 1px solid var(--line-hair);
    align-items: center;
  }

  .desk-cover {
    aspect-ratio: 2 / 3;
    border-radius: 4px;
    padding: 8px;
    display: flex;
    align-items: flex-end;
    font-family: var(--zr-police-serif);
    font-size: 11px;
    color: #FFFFFF;
  }

  .desk-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .desk-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 15px;
    color: var(--fg-ink);
  }

  .desk-author {
    font-size: 12px;
    color: var(--fg-muted);
  }

  .desk-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    font-size: 11.5px;
    color: var(--fg-ink);
  }

  .shelf-b-lower {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .compact-book {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .compact-cover {
    aspect-ratio: 2 / 3;
    border-radius: 5px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--zr-police-serif);
    font-size: 11.5px;
    line-height: 1.2;
    border: 1px solid var(--line-hair);
  }

  .compact-title {
    font-size: 11.5px;
    color: var(--fg-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* =========================================================
     PROPOSITION SHELF C : REGISTRE ÉDITORIAL MINIMALISTE (COUVERTURES + TABLE SHELF.JSX)
     ========================================================= */
  .shelf-c-wrap {
    padding: 20px 34px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .editorial-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }

  .editorial-table th {
    text-align: left;
    font-weight: 500;
    font-size: 11px;
    color: var(--fg-muted);
    padding: 8px 10px;
    border-bottom: 1px solid var(--line-hair);
  }

  .editorial-table td {
    padding: 10px;
    border-bottom: 1px solid var(--line-hair);
    color: var(--fg-ink);
    vertical-align: middle;
  }

  .row-book-cell {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tiny-cover {
    width: 24px;
    height: 34px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .row-book-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 14px;
    color: var(--fg-ink);
  }

  .pill-quiet {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--bg-sub);
    color: var(--fg-ink);
    font-size: 11px;
  }

  /* =========================================================
     DESIGN C VALIDÉ : DOUBLE-PAGE LIVRE OUVERT (ZÉRO CHROME, PAPIER NU)
     ========================================================= */
  .two-page-spread {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 48px;
    padding: var(--page-pad) 48px;
    align-items: center;
  }

  .spine-line {
    width: 1px;
    height: 100%;
    background: var(--line-hair);
  }

  .prose-column {
    width: 100%;
    max-width: var(--book-width);
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: var(--book-size);
    line-height: var(--book-lh);
    color: var(--fg-ink);
  }

  .ch-label {
    font-family: var(--zr-police-sans);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }

  .ch-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: calc(var(--book-size) * 1.42);
    line-height: 1.24;
    margin-bottom: 18px;
  }

  .prose-column p {
    margin-bottom: 14px;
  }

  .warm-hl {
    background: rgba(242, 194, 68, 0.28);
    padding: 1px 3px;
    border-radius: 3px;
  }
</style>
</head>
<body>

  <!-- BARRE HDA -->
  <header class="hda-bar">
    <div class="hda-left">
      <h1 class="hda-title">ZenRay Books v3 · Shelf (3 Propositions) + Lecteur Design C</h1>
      <span class="hda-sub">Adapté de Shelf.jsx (<span class="num">213</span> livres) + Create/Books (<span class="num">5</span> PDF Cloud) · Medium <span class="num">500</span> · <span class="num">18</span> October <span class="num">2026</span></span>
    </div>

    <div class="hda-sliders">
      <div class="chip-row">
        <button class="chip active" id="btnA" onclick="pick('A')">Shelf A · Grille Pure</button>
        <button class="chip" id="btnB" onclick="pick('B')">Shelf B · Table + Grille</button>
        <button class="chip" id="btnC" onclick="pick('C')">Shelf C · Registre</button>
      </div>

      <div class="s-item">
        <span>Colonnes</span>
        <input type="range" min="4" max="6" step="1" value="5" oninput="setV('--shelf-cols', this.value, 'vCols')" />
        <span class="num" id="vCols">5</span>
      </div>

      <div class="s-item">
        <span>Écart</span>
        <input type="range" min="14" max="36" step="2" value="24" oninput="setV('--shelf-gap', this.value + 'px', 'vGap')" />
        <span class="num" id="vGap">24px</span>
      </div>

      <div class="s-item">
        <span>Corps</span>
        <input type="range" min="15" max="22" step="0.5" value="18" oninput="setV('--book-size', this.value + 'px', 'vSize')" />
        <span class="num" id="vSize">18px</span>
      </div>

      <div class="chip-row">
        <button class="chip active" id="thIvoire" onclick="theme('ivoire')">Ivoire</button>
        <button class="chip" id="thSepia" onclick="theme('sepia')">Sépia</button>
        <button class="chip" id="thNuit" onclick="theme('nuit')">Nuit</button>
      </div>

      <button class="copy-btn" id="copyBtn" onclick="copyAll()">Copier le choix</button>
    </div>
  </header>

  <main class="stack">

    <!-- PROPOSITION SHELF A : GRILLE PORTRAIT 2:3 PURE (APPLE BOOKS / SHELF.JSX ÉPURÉ) -->
    <section class="card selected" id="cardA" onclick="pick('A')">
      <div class="card-head">
        <div class="card-head-left">
          <span class="badge-letter">A</span>
          <h2 class="card-title">Shelf A · Étagère Portrait 2:3 Épurée (Apple Books &amp; ZenRayShelf sur Papier Nu)</h2>
          <span class="card-note">Couvertures 2:3 sur le même papier ivoire que le lecteur Design C, progression fine sous les 5 livres Cloud de Create/Books, filtres discrets en haut.</span>
        </div>
      </div>

      <div class="app-frame">
        <aside class="sidebar">
          <div>
            <div class="traffic">
              <span style="background:#FF5F56;"></span>
              <span style="background:#FFBD2E;"></span>
              <span style="background:#27C93F;"></span>
            </div>
            <div class="s-nav">
              <div class="s-link"><span>Create</span></div>
              <div class="s-link"><span>Progress</span></div>
              <div class="s-link"><span>Assets</span></div>
              <div class="s-link active"><span>Books</span><span class="num">218</span></div>
              <div class="s-link"><span>Money</span></div>
              <div class="s-link"><span>Sport</span></div>
            </div>
          </div>
          <div class="s-foot">Create / Books + Shelf</div>
        </aside>

        <div class="paper-surface">
          <div class="quiet-top">
            <div class="quiet-brand">
              <span class="quiet-brand-title">Bibliothèque</span>
              <span><span class="num">5</span> livres Cloud dans Create/Books · <span class="num">213</span> dans Shelf</span>
            </div>
            <div class="quiet-actions">
              <span class="active-tab">En cours (<span class="num">5</span>)</span>
              <span>À lire (<span class="num">48</span>)</span>
              <span>Lus (<span class="num">160</span>)</span>
              <span>Tous (<span class="num">218</span>)</span>
              <span>Rechercher</span>
              <span>+ Ajouter</span>
            </div>
          </div>

          <div class="shelf-a-wrap">
            <div class="shelf-grid">
              <div class="book-item" onclick="openBook('The Win Without Pitching Manifesto', 'Blair Enns', '33%')">
                <div class="book-cover" style="background:#1D222B; color:#FAF8F4;">
                  <span class="cover-tag">Create / Books · PDF</span>
                  <div class="cover-serif-title">The Win Without Pitching Manifesto</div>
                  <span class="cover-author">Blair Enns</span>
                </div>
                <div class="book-meta">
                  <div class="book-meta-title">Win Without Pitching</div>
                  <div class="book-meta-sub"><span>Blair Enns</span><span class="num">33% · p. 42</span></div>
                  <div class="mini-bar"><div style="width:33%"></div></div>
                </div>
              </div>

              <div class="book-item" onclick="openBook('Convenience Store Woman', 'Sayaka Murata', '68%')">
                <div class="book-cover" style="background:#263E33; color:#FAF8F4;">
                  <span class="cover-tag">Create / Books · PDF</span>
                  <div class="cover-serif-title">Convenience Store Woman</div>
                  <span class="cover-author">Sayaka Murata</span>
                </div>
                <div class="book-meta">
                  <div class="book-meta-title">Convenience Store Woman</div>
                  <div class="book-meta-sub"><span>Sayaka Murata</span><span class="num">68% · p. 112</span></div>
                  <div class="mini-bar"><div style="width:68%"></div></div>
                </div>
              </div>

              <div class="book-item" onclick="openBook('An Introduction to Japanese Society', 'Yoshio Sugimoto', '21%')">
                <div class="book-cover" style="background:#4E2825; color:#FAF8F4;">
                  <span class="cover-tag">Create / Books · PDF</span>
                  <div class="cover-serif-title">An Introduction to Japanese Society</div>
                  <span class="cover-author">Yoshio Sugimoto</span>
