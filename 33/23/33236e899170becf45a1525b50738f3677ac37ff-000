<script>const C={"groups": [{"name": "sjliZ", "items": [{"id": "sjliZ_A", "label": "A", "selected": true}, {"id": "sjliZ_B", "label": "B", "selected": true}, {"id": "sjliZ_C", "label": "C", "selected": true}, {"id": "sjliZ_D", "label": "D", "selected": true}, {"id": "sjliZ_E", "label": "E", "selected": true}]}, {"name": "vczndjqja", "items": [{"id": "vczndjqja_A", "label": "A", "selected": false}, {"id": "vczndjqja_B", "label": "B", "selected": false}, {"id": "vczndjqja_C", "label": "C", "selected": false}, {"id": "vczndjqja_D", "label": "D", "selected": false}, {"id": "vczndjqja_E", "label": "E", "selected": false}, {"id": "vczndjqja_F", "label": "F", "selected": false}, {"id": "vczndjqja_G", "label": "G", "selected": false}, {"id": "vczndjqja_H", "label": "H", "selected": false}]}, {"name": "vdilbaiia", "items": [{"id": "vdilbaiia_A", "label": "A", "selected": false}, {"id": "vdilbaiia_B", "label": "B", "selected": false}, {"id": "vdilbaiia_C", "label": "C", "selected": false}, {"id": "vdilbaiia_D", "label": "D", "selected": false}, {"id": "vdilbaiia_E", "label": "E", "selected": false}, {"id": "vdilbaiia_F", "label": "F", "selected": false}, {"id": "vdilbaiia_G", "label": "G", "selected": false}, {"id": "vdilbaiia_H", "label": "H", "selected": false}, {"id": "vdilbaiia_I", "label": "I", "selected": false}, {"id": "vdilbaiia_J", "label": "J", "selected": false}, {"id": "vdilbaiia_K", "label": "K", "selected": false}, {"id": "vdilbaiia_L", "label": "L", "selected": false}]}, {"name": "vlkhcbxia", "items": [{"id": "vlkhcbxia_A", "label": "A", "selected": false}, {"id": "vlkhcbxia_B", "label": "B", "selected": true}, {"id": "vlkhcbxia_C", "label": "C", "selected": true}, {"id": "vlkhcbxia_D", "label": "D", "selected": false}, {"id": "vlkhcbxia_E", "label": "E", "selected": false}, {"id": "vlkhcbxia_F", "label": "F", "selected": true}, {"id": "vlkhcbxia_G", "label": "G", "selected": true}, {"id": "vlkhcbxia_H", "label": "H", "selected": false}]}], "copy": {"group_line