const cards=[...document.querySelectorAll('.card')],out=document.getElementById('out'),cnt=document.getElementById('cnt');
function line(){const parts=[];let n=0;C.groups.forEach((g,gi)=>{const l=g.items.filter(i=>cards.find(c=>+c.dataset.g==gi&&g.items[+c.dataset.i]===i).classList.contains('on')).map(i=>i.label);n+=l.length;if(l.length)parts.push(C.copy.group_line.replace('{group}',g.name).replace('{labels}',l.join(' ')))});cnt.textContent=n+' selected';return parts.join(C.copy.separator)}
function sync(){out.textContent=line()||'(nothing selected)'}
cards.forEach(c=>c.addEventListener('click',()=>{c.classList.toggle('on');c.setAttribute('aria-pressed',c.classList.contains('on'));sync()}));
document.querySelectorAll('[data-all],[data-none]').forEach(b=>b.addEventListener('click',()=>{const gi=b.dataset.all??b.dataset.none,on=b.dataset.all!==undefined;cards.filter(c=>c.dataset.g==gi).forEach(c=>{c.classList.toggle('on',on);c.setAttribute('aria-pressed',on)});sync()}));
document.getElementById('copy').addEventListener('click',async e=>{const t=line();try{await navigator.clipboard.writeText(t);e.target.textContent='Copied ✓'}catch(_){const r=document.createRange();r.selectNodeContents(out);getSelection().removeAllRanges();getSelection().addRange(r);e.target.textContent='Select + ⌘C'}setTimeout(()=>e.target.textContent='Copy selection',1500)});
