/* ═══════ Motifs de vignette ════════════════════════════════════════════════
   Aucun rendu invente : uniquement du trait, qui se lit comme un emplacement.
   Le degrade prend la teinte de la famille, jamais une couleur ecrite en dur. */
function motifSVG(type, cle){
  const t = TYPES[type];
  const gid = 'g' + cle;
  const c = t.teinte;
  const traits = {
    buste:`<ellipse cx="160" cy="74" rx="30" ry="34"/><path d="M112 168c0-30 21-48 48-48s48 18 48 48"/>
           <path d="M132 66h56M136 84h48M140 100h40"/><path d="M160 40v128"/>`,
    horizon:`<path d="M28 132h264"/><path d="M52 132 108 78l34 30 26-24 44 48"/>
           <path d="M188 132l38-34 42 34"/><path d="M28 150h264M28 164h264M28 178h264"/>
           <path d="M96 132v46M160 132v46M224 132v46"/>`,
    cube:`<path d="M160 40 236 78v70l-76 38-76-38V78z"/><path d="M84 78l76 38 76-38M160 116v70"/>
           <path d="M60 56h200v104H60z" stroke-dasharray="5 6"/>`,
    sphere:`<circle cx="160" cy="106" r="62"/><ellipse cx="160" cy="106" rx="62" ry="22"/>
           <ellipse cx="160" cy="106" rx="62" ry="42"/><ellipse cx="160" cy="106" rx="22" ry="62"/>
           <ellipse cx="160" cy="106" rx="42" ry="62"/>`,
    squelette:`<path d="M160 34v40l-30 30 8 44-16 34M160 74l30 30-8 44 16 34"/>
           <path d="M130 104 96 122M190 104l34 18"/>
           <circle cx="160" cy="34" r="9"/><circle cx="160" cy="74" r="6"/><circle cx="130" cy="104" r="6"/>
           <circle cx="190" cy="104" r="6"/><circle cx="138" cy="148" r="6"/><circle cx="182" cy="148" r="6"/>`,
    rampe:`<path d="M44 58h38v96H44zM90 58h38v96H90zM136 58h38v96h-38zM182 58h38v96h-38zM228 58h38v96h-38z"/>
           <path d="M44 106h222" stroke-dasharray="4 6"/>`,
    graphe:`<path d="M36 52h64v34H36zM220 52h64v34h-64zM128 122h64v34h-64z"/>
           <path d="M100 69h30c12 0 12 70 30 70M284 69h-30c-12 0-12 70-30 70"/>
           <circle cx="160" cy="139" r="4"/>`,
    bloc:`<path d="M32 34h256v144H32z"/><path d="M32 66h256M104 66v112"/>
           <path d="M124 88h60v14h-60zM124 118h140v10H124zM124 140h100v10H124z"/>
           <path d="M50 88h34v10H50zM50 110h34v10H50zM50 132h34v10H50z"/>`,
    planche:`<path d="M28 30h124v68H28zM168 30h124v68H168zM28 114h124v68H28zM168 114h124v68H168z"/>
           <path d="M28 82h124M168 82h124M28 166h124M168 166h124"/>`
  }[t.motif];
  return `<svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <linearGradient id="${gid}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="${c}" stop-opacity="0.30"/>
        <stop offset="0.52" stop-color="${c}" stop-opacity="0.08"/>
        <stop offset="1" stop-color="${c}" stop-opacity="0.02"/>
      </linearGradient>
    </defs>
    <rect width="320" height="200" fill="url(#${gid})"/>
    <g stroke="${c}" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"
       opacity="var(--zr-motif-opacite)">${traits}</g>
  </svg>`;
}

/* ═══════ Rendu de la navigation ════════════════════════════════════════════ */
const etatNav = { deplie:{}, filtre:'' };

function rendreNav(){
  const q = etatNav.filtre.trim().toLowerCase();
  const nav = document.getElementById('nav');
  nav.innerHTML = ZONES.map(zone => {
    const items = zone.items.filter(it => !q || it.nom.toLowerCase().includes(q));
    if(!items.length) return '';
    const tout = etatNav.deplie[zone.id] || q;
    const seuil = tout ? items.length : Math.min(zone.seuilPlein, items.length);
    const pleins = items.slice(0, seuil);
    const puces  = items.slice(seuil);
    const ligne = it => `
      <button class="zr-item${it.actif ? ' actif' : ''}">
        <span class="zr-pastille">${ico(it.icone, 12)}</span>
        <span class="zr-libelle">${it.nom}</span>
        ${it.badge ? `<span class="zr-badge num">${it.badge}</span>` : ''}
      </button>`;
    const puce = it => `
      <button class="zr-puce" title="${it.nom}">${ico(it.icone, 12)}<span>${it.nom}</span></button>`;
    return `
      <section class="zr-zone" style="--zone:${zone.couleur}">
        <div class="zr-zone-tete">
          <button>${zone.nom}</button>
          <span class="zr-compte num">${items.length}</span>
        </div>
        ${pleins.map(ligne).join('')}
        ${puces.length ? `<div class="zr-grille-nav">${puces.map(puce).join('')}</div>` : ''}
        ${(puces.length || (tout && !q && items.length > zone.seuilPlein))
          ? `<button class="zr-deplier" data-zone="${zone.id}">
               ${ico('chevron', 11)} ${tout ? 'Replier' : 'Tout deplier'}
             </button>` : ''}
      </section>`;
  }).join('');

  nav.querySelectorAll('.zr-deplier').forEach(b => b.addEventListener('click', () => {
    etatNav.deplie[b.dataset.zone] = !etatNav.deplie[b.dataset.zone];
    rendreNav();
  }));
}
document.getElementById('nav-recherche').addEventListener('input', e => {
  etatNav.filtre = e.target.value; rendreNav();
});

/* ═══════ Rendu de la vue Assets ════════════════════════════════════════════ */
const etat = { type:'tous', moteur:'tous', annee:'toutes', texte:'', selection:0 };

const MOTEURS = [...new Set(ASSETS.map(a => a.moteur))].sort();
const ANNEES  = [...new Set(ASSETS.map(a => a.annee))].sort((a,b) => b - a);

function filtres(){
  return ASSETS.filter(a =>
    (etat.type    === 'tous'    || a.type   === etat.type) &&
    (etat.moteur  === 'tous'    || a.moteur === etat.moteur) &&
    (etat.annee   === 'toutes'  || String(a.annee) === etat.annee) &&
    (!etat.texte  || (a.nom + ' ' + a.desc + ' ' + a.servi.join(' ')).toLowerCase().includes(etat.texte))
  );
}

function rendreRails(){
  const compte = f => ASSETS.filter(f).length;
  document.getElementById('rail-type').innerHTML =
    `<button class="zr-chip" data-val="tous" data-on="${etat.type==='tous'}">
       Tous <span class="zr-n">${ASSETS.length}</span></button>` +
    Object.entries(TYPES).map(([id, t]) => `
      <button class="zr-chip" data-val="${id}" data-on="${etat.type===id}" style="--teinte:${t.teinte}">
        <span class="zr-point"></span>${t.label}
        <span class="zr-n">${compte(a => a.type === id)}</span>
      </button>`).join('');

  document.getElementById('rail-moteur').innerHTML =
    `<button class="zr-chip" data-val="tous" data-on="${etat.moteur==='tous'}">Tous</button>` +
    MOTEURS.map(m => `<button class="zr-chip" data-val="${m}" data-on="${etat.moteur===m}">
      ${m} <span class="zr-n">${compte(a => a.moteur === m)}</span></button>`).join('');

  document.getElementById('rail-annee').innerHTML =
    `<button class="zr-chip" data-val="toutes" data-on="${etat.annee==='toutes'}">Toutes</button>` +
    ANNEES.map(y => `<button class="zr-chip" data-val="${y}" data-on="${etat.annee===String(y)}">
      <span class="num">${y}</span> <span class="zr-n">${compte(a => a.annee === y)}</span></button>`).join('');

  brancher('rail-type','type');
  brancher('rail-moteur','moteur');
  brancher('rail-annee','annee');
}
function brancher(id, cle){
  document.getElementById(id).querySelectorAll('.zr-chip').forEach(b =>
    b.addEventListener('click', () => { etat[cle] = b.dataset.val; rendreRails(); rendrePlanche(); }));
}

function carte(a, i){
  const t = TYPES[a.type];
  return `
    <button class="zr-carte" data-i="${i}" data-sel="${etat.selection === i}">
      <div class="zr-vignette">
        ${motifSVG(a.type, i)}
        <div class="zr-hachure"></div>
        <div class="zr-cadre-pointille"></div>
        <div class="zr-nom-place">${a.nom}</div>
        <span class="zr-etiquette" style="--teinte:${t.teinte}"><span class="zr-point"></span>${t.label}</span>
        ${a.phare ? `<span class="zr-fanion">Phare</span>` : ''}
        <div class="zr-voile">
          <div class="zr-voile-ligne">
            <span>${a.moteur}</span><span class="zr-voile-sep">/</span>
            <span>${a.format}</span><span class="zr-voile-sep">/</span>
            <span><b>${a.poids}</b></span><span class="zr-voile-sep">/</span>
            <span>${a.licence}</span>
          </div>
          <div class="zr-voile-servi">A servi dans ${a.servi.join(', ')}</div>
        </div>
      </div>
      <div class="zr-carte-pied">
        <h3>${a.nom}</h3>
        <span class="zr-an">${a.annee}</span>
      </div>
    </button>`;
}

function rendrePlanche(){
  const liste = filtres();
  const planche = document.getElementById('planche');

  if(!liste.length){
    planche.innerHTML = `<p class="zr-vide">Aucun asset ne repond a ces filtres.</p>`;
    return;
  }

  /* Regroupement par famille tant qu'aucun type n'est isole : c'est ce qui
     permet de tenir cent vignettes sans que l'oeil perde le fil. */
  const html = (etat.type === 'tous')
    ? Object.entries(TYPES).map(([id, t]) => {
        const lot = liste.map((a, i) => [a, ASSETS.indexOf(a)]).filter(([a]) => a.type === id);
        if(!lot.length) return '';
        return `
          <div class="zr-lot-tete">
            <h2>${t.label}</h2><span class="zr-trait"></span>
            <span class="zr-compte num">${lot.length}</span>
          </div>
          <div class="zr-grille">${lot.map(([a, i]) => carte(a, i)).join('')}</div>`;
      }).join('')
    : `<div class="zr-grille">${liste.map(a => carte(a, ASSETS.indexOf(a))).join('')}</div>`;

  planche.innerHTML = html;
  planche.querySelectorAll('.zr-carte').forEach(c => c.addEventListener('click', () => {
    etat.selection = Number(c.dataset.i);
    planche.querySelectorAll('.zr-carte').forEach(x =>
      x.dataset.sel = (Number(x.dataset.i) === etat.selection));
    rendreInspecteur();
  }));
}

function rendreInspecteur(){
  const a = ASSETS[etat.selection];
  const t = TYPES[a.type];
  document.getElementById('insp').innerHTML = `
    <div class="zr-insp-vignette">${motifSVG(a.type, 'i' + etat.selection)}
      <div class="zr-hachure"></div><div class="zr-cadre-pointille"></div></div>
    <h2>${a.nom}</h2>
    <div class="zr-insp-type"><span class="zr-point" style="width:7px;height:7px;border-radius:50%;
      display:inline-block;background:${t.teinte}"></span>${t.label}</div>
    <p class="zr-insp-desc">${a.desc}</p>
    <dl class="zr-fiche">
      <div class="zr-fiche-ligne"><dt>Annee</dt><dd class="num">${a.annee}</dd></div>
      <div class="zr-fiche-ligne"><dt>Moteur</dt><dd>${a.moteur}</dd></div>
      <div class="zr-fiche-ligne"><dt>Format</dt><dd>${a.format}</dd></div>
      <div class="zr-fiche-ligne"><dt>Poids</dt><dd class="num">${a.poids}</dd></div>
      <div class="zr-fiche-ligne"><dt>Licence</dt><dd>${a.licence}</dd></div>
    </dl>
    <div class="zr-servi">
      <div class="zr-servi-titre">A deja servi dans</div>
      <div class="zr-servi-liste">${a.servi.map(s => `<span class="zr-tag">${s}</span>`).join('')}</div>
    </div>`;
}

function rendreMesures(){
  const gio = ASSETS.reduce((s, a) => {
    const n = parseFloat(a.poids.replace(',', '.'));
    return s + (a.poids.includes('Gio') ? n : n / 1024);
  }, 0);
  const projets = new Set(ASSETS.flatMap(a => a.servi));
  document.getElementById('m-total').textContent   = ASSETS.length;
  document.getElementById('m-projets').textContent = projets.size;
  document.getElementById('m-poids').textContent   = gio.toFixed(1).replace('.', ',');
}

/* ── Densite de la planche : un seul jeton pilote toute la grille ── */
const TAILLES = { s:'166px', m:'216px', l:'292px' };
document.getElementById('densite').querySelectorAll('button').forEach(b =>
  b.addEventListener('click', () => {
    document.getElementById('densite').querySelectorAll('button').forEach(x => x.dataset.on = 'false');
    b.dataset.on = 'true';
    document.documentElement.style.setProperty('--zr-vignette-min', TAILLES[b.dataset.taille]);
  }));

document.getElementById('filtre-texte').addEventListener('input', e => {
  etat.texte = e.target.value.trim().toLowerCase(); rendrePlanche();
});

document.getElementById('btn-theme').addEventListener('click', () => {
  document.getElementById('racine').classList.toggle('zr-clair');
  document.body.classList.toggle('zr-clair');
});
document.getElementById('btn-inspecteur').addEventListener('click', () => {
  const c = document.getElementById('corps');
  c.dataset.inspecteur = c.dataset.inspecteur === 'on' ? 'off' : 'on';
});

rendreNav();
rendreRails();
rendrePlanche();
rendreInspecteur();
rendreMesures();
