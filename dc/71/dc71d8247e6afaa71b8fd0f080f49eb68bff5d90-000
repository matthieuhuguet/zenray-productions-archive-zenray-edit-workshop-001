<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZenRay Assets, direction STUDIO</title>
<style>
  /* Polices SERVIES par le gabarit, jamais attendues du systeme : un repli de police
     ne se signale jamais, seul l'oeil le voit. Les deux familles sont VARIABLES, donc
     trois faces couvrent toutes les graisses employees ici. */
  @font-face{font-family:'Inter';src:url('fonts/InterVariable.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:swap;}
  @font-face{font-family:'AnthropicSerif';src:url('fonts/AnthropicSerif-Romans.woff2') format('woff2');font-weight:300 800;font-style:normal;font-display:swap;}
  @font-face{font-family:'AnthropicSerif';src:url('fonts/AnthropicSerif-Italics.woff2') format('woff2');font-weight:300 800;font-style:italic;font-display:swap;}

/* ═══════════════════════════════════════════════════════════════════════════
   MAQUETTE DE DESIGN, direction STUDIO. Aucun fichier produit n'est touché.
   Interface de parametres unique en tete (loi HDA) : tout le reste en derive.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Polices, servies depuis ~/Library/Fonts pour un rendu juste en double clic ── */


/* AnthropicSerif est installee en coupes STATIQUES. On declare des plages de graisse
   pour que 350 (titres) et 400 (nombres) tombent tous deux sur la coupe Regular,
   au lieu de laisser le navigateur choisir Light en silence. */





/* ═══════ ÉTAGE 1, jetons globaux ═══════════════════════════════════════════ */
:root{
  /* Typographie, reprise du systeme ZenRayProgress */
  --zr-police-sans:'Inter','Inter Variable','Hiragino Sans W4',-apple-system,Arial,sans-serif;
  --zr-police-serif:'AnthropicSerif','Hiragino Mincho ProN W3',Georgia,serif;
  --zr-poids-sans:400;
  --zr-poids-serif:350;
  --zr-poids-nombres:400;
  --zr-ui-base:14px;
  --zr-ui-3xs:calc(var(--zr-ui-base)*0.69);
  --zr-ui-2xs:calc(var(--zr-ui-base)*0.77);
  --zr-ui-xs:calc(var(--zr-ui-base)*0.85);
  --zr-ui-sm:calc(var(--zr-ui-base)*0.92);
  --zr-ui-md:var(--zr-ui-base);
  --zr-ui-lg:calc(var(--zr-ui-base)*1.08);
  --zr-ui-xl:calc(var(--zr-ui-base)*1.13);
  --zr-ui-2xl:calc(var(--zr-ui-base)*1.20);
  --zr-ui-3xl:calc(var(--zr-ui-base)*1.33);

  /* Rayons et rythme, repris du systeme */
  --zr-r-chip:7px; --zr-r-control:10px; --zr-r-panel:14px; --zr-r-window:22px;
  --zr-r-thumb:12px;
  --zr-pas:4px;
  --zr-gap-1:calc(var(--zr-pas)*1);
  --zr-gap-2:calc(var(--zr-pas)*2);
  --zr-gap-3:calc(var(--zr-pas)*3);
  --zr-gap-4:calc(var(--zr-pas)*4);
  --zr-gap-6:calc(var(--zr-pas)*6);
  --zr-gap-8:calc(var(--zr-pas)*8);

  --zr-timing:.34s;
  --zr-ease:cubic-bezier(.16,1,.3,1);

  /* Geometrie de la maquette */
  --zr-sidebar-w:248px;
  --zr-inspector-w:326px;
  --zr-vignette-min:216px;   /* pilote par la densite S, M, L */
  --zr-vignette-ratio:62%;   /* hauteur de vignette en pourcentage de largeur */

  /* ── SOMBRE, le defaut de cette direction ────────────────────────────────
     On regarde de la 3D et des images sur du charbon, jamais sur du blanc. */
  --zr-bg-ambiant:#0E0E0D;
  --zr-bg-window:#151514;
  --zr-bg-content:#1B1B1A;
  --zr-bg-eleve:#232321;
  --zr-bg-creux:#111110;
  --zr-fg:#EDEDEA;
  --zr-fg-doux:rgba(237,237,234,.62);
  --zr-fg-tenu:rgba(237,237,234,.40);
  --zr-filet:rgba(255,255,255,.085);
  --zr-filet-fort:rgba(255,255,255,.16);
  --zr-survol:rgba(255,255,255,.055);
  --zr-accent:#D9AC5E;            /* laiton, la signature studio */
  --zr-accent-doux:rgba(217,172,94,.15);
  --zr-accent-fg:#1A1508;
  --zr-verre:rgba(27,27,26,.72);
  --zr-verre-filtre:blur(28px) saturate(170%);
  --zr-ombre-douce:0 2px 10px rgba(0,0,0,.34);
  --zr-ombre-forte:0 18px 46px rgba(0,0,0,.52),0 4px 14px rgba(0,0,0,.34);
  --zr-vignette-fond:#131312;
  --zr-vignette-voile:.30;
  --zr-motif-opacite:.46;
  --zr-hachure:rgba(255,255,255,.028);

  /* Couleurs de zone de navigation, les reperes visuels forts */
  --zone-create:#D9AC5E;
  --zone-gallery:#B49BF5;
  --zone-learn:#5FC2A6;
  --zone-apps:#6FA8F0;
  --zone-systeme:#8E8E88;
}

/* ── CLAIR, la bascule. Seuls les jetons changent, aucune regle ne se reecrit ── */
.zr-clair{
  --zr-bg-ambiant:#E9E7E2;
  --zr-bg-window:#F4F3EF;
  --zr-bg-content:#FDFDFC;
  --zr-bg-eleve:#FFFFFF;
  --zr-bg-creux:#F0EFEA;
  --zr-fg:#1E1E1C;
  --zr-fg-doux:rgba(30,30,28,.62);
  --zr-fg-tenu:rgba(30,30,28,.42);
  --zr-filet:rgba(0,0,0,.09);
  --zr-filet-fort:rgba(0,0,0,.17);
  --zr-survol:rgba(0,0,0,.045);
  --zr-accent:#8A6516;
  --zr-accent-doux:rgba(138,101,22,.12);
  --zr-accent-fg:#FFFBF0;
  --zr-verre:rgba(253,253,252,.74);
  --zr-ombre-douce:0 2px 8px rgba(40,36,28,.10);
  --zr-ombre-forte:0 16px 40px rgba(40,36,28,.16),0 3px 10px rgba(40,36,28,.08);
  --zr-vignette-fond:#E6E4DE;
  --zr-vignette-voile:.16;
  --zr-motif-opacite:.55;
  --zr-hachure:rgba(0,0,0,.030);
  --zone-create:#8A6516;
  --zone-gallery:#6B4FCF;
  --zone-learn:#1F7D64;
  --zone-apps:#2C6BB8;
  --zone-systeme:#6C6C66;
}

/* ═══════ Base ══════════════════════════════════════════════════════════════ */
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{
  font-family:var(--zr-police-sans);
  font-weight:var(--zr-poids-sans);
  font-size:var(--zr-ui-md);
  color:var(--zr-fg);
  background:var(--zr-bg-ambiant);
  -webkit-font-smoothing:antialiased;
  overflow:hidden;
}
.num{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);font-variant-numeric:tabular-nums;letter-spacing:.01em}
h1,h2,h3,h4{margin:0;font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);letter-spacing:-.015em}
button,input,select{font-family:inherit;font-size:inherit;color:inherit}
button{border:0;background:transparent;cursor:pointer;padding:0}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--zr-filet-fort);border-radius:9px;border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-track{background:transparent}

/* Lueur ambiante derriere la fenetre. Pas d'image, uniquement des degrades,
   et surtout AUCUN backdrop-filter ici, sinon le verre de la sidebar n'a plus
   rien a refracter. */
.zr-ambiant{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(1100px 620px at 12% -12%, rgba(217,172,94,.16), transparent 62%),
    radial-gradient(900px 560px at 88% 6%, rgba(111,168,240,.11), transparent 60%),
    radial-gradient(1200px 800px at 50% 118%, rgba(180,155,245,.10), transparent 64%);
}
.zr-clair .zr-ambiant{
  background:
    radial-gradient(1100px 620px at 12% -12%, rgba(190,150,70,.24), transparent 62%),
    radial-gradient(900px 560px at 88% 6%, rgba(110,150,210,.18), transparent 60%),
    radial-gradient(1200px 800px at 50% 118%, rgba(150,130,200,.16), transparent 64%);
}

/* ═══════ Cadre d'application ═══════════════════════════════════════════════ */
.zr-app{
  position:relative;z-index:1;height:100vh;padding:22px;
  display:flex;flex-direction:column;
}
.zr-window{
  flex:1;min-height:0;display:flex;flex-direction:column;
  border-radius:var(--zr-r-window);overflow:hidden;
  background:var(--zr-bg-window);
  box-shadow:var(--zr-ombre-forte), inset 0 0 0 1px var(--zr-filet);
}
.zr-titlebar{
  height:40px;flex:none;display:flex;align-items:center;gap:var(--zr-gap-3);
  padding:0 var(--zr-gap-4);border-bottom:1px solid var(--zr-filet);
  background:var(--zr-bg-creux);
}
.zr-feux{display:flex;gap:7px}
.zr-feu{width:11px;height:11px;border-radius:50%;background:var(--zr-filet-fort)}
.zr-feu:nth-child(1){background:#E1584E}.zr-feu:nth-child(2){background:#E2B04A}.zr-feu:nth-child(3){background:#5FB martin}
.zr-feu:nth-child(3){background:#5FB05A}
.zr-titre-fenetre{flex:1;text-align:center;font-size:var(--zr-ui-sm);color:var(--zr-fg-tenu)}
.zr-titlebar-fin{display:flex;align-items:center;gap:var(--zr-gap-2)}

.zr-corps{flex:1;min-height:0;display:grid;grid-template-columns:var(--zr-sidebar-w) minmax(0,1fr) var(--zr-inspector-w)}
.zr-corps[data-inspecteur="off"]{grid-template-columns:var(--zr-sidebar-w) minmax(0,1fr) 0}
.zr-corps[data-inspecteur="off"] .zr-inspecteur{display:none}

/* ═══════ SIDEBAR ═══════════════════════════════════════════════════════════
   Le probleme reel : treize entrees d'affilee dans la zone Create, c'est une
   liste plate ou l'oeil ne trouve plus rien. Trois reponses ici, cumulees.
   1. Un rail de couleur par zone, tenu sur toute la hauteur, qui donne a l'oeil
      un repere avant meme la lecture.
   2. Une pastille d'icone par entree, teintee de la couleur de sa zone.
   3. Une zone Create scindee en deux registres : les six premieres entrees en
      lignes pleines, les huit suivantes en grille compacte de deux colonnes,
      dans l'ordre exact. Quatorze lignes deviennent dix, et l'oeil retrouve
      des blocs au lieu d'un ruban. */
.zr-sidebar{
  min-height:0;display:flex;flex-direction:column;gap:var(--zr-gap-2);
  padding:var(--zr-gap-3) var(--zr-gap-3) var(--zr-gap-4);
  background:var(--zr-verre);
  backdrop-filter:var(--zr-verre-filtre);-webkit-backdrop-filter:var(--zr-verre-filtre);
  border-right:1px solid var(--zr-filet);
}
.zr-sb-tete{display:flex;align-items:center;gap:var(--zr-gap-2);padding:var(--zr-gap-1) var(--zr-gap-2)}
.zr-sb-sceau{width:24px;height:24px;border-radius:7px;display:grid;place-items:center;flex:none;
  background:linear-gradient(140deg,var(--zr-accent),color-mix(in srgb,var(--zr-accent) 55%,#000));
  color:var(--zr-accent-fg);font-size:var(--zr-ui-sm);font-weight:600}
.zr-sb-nom{flex:1;min-width:0;font-size:var(--zr-ui-sm);color:var(--zr-fg-doux);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.zr-icone-btn{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;color:var(--zr-fg-tenu);
  transition:background-color var(--zr-timing) var(--zr-ease),color var(--zr-timing) var(--zr-ease)}
.zr-icone-btn:hover{background:var(--zr-survol);color:var(--zr-fg)}

.zr-sb-recherche{display:flex;align-items:center;gap:var(--zr-gap-2);height:32px;padding:0 11px;
  border-radius:999px;background:var(--zr-bg-creux);box-shadow:inset 0 0 0 1px var(--zr-filet);color:var(--zr-fg-tenu)}
.zr-sb-recherche input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:var(--zr-ui-sm);color:var(--zr-fg)}
.zr-sb-recherche input::placeholder{color:var(--zr-fg-tenu)}

.zr-nav{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding-right:2px}
.zr-zone{position:relative;padding-left:9px;margin-top:var(--zr-gap-3)}
.zr-zone:first-child{margin-top:var(--zr-gap-1)}
/* Le rail de zone : deux pixels de couleur qui tiennent tout le groupe ensemble. */
.zr-zone::before{content:"";position:absolute;left:2px;top:19px;bottom:3px;width:2px;border-radius:2px;
  background:var(--zone);opacity:.42}
.zr-zone-tete{display:flex;align-items:center;gap:var(--zr-gap-2);height:22px;padding:0 var(--zr-gap-2);
  color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);font-weight:600;letter-spacing:.09em;text-transform:uppercase}
.zr-zone-tete .zr-compte{margin-left:auto;color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);opacity:.8}
.zr-zone-tete button{color:inherit;display:flex;align-items:center;gap:var(--zr-gap-2);flex:1;letter-spacing:inherit;
  font-size:inherit;font-weight:inherit;text-transform:inherit}

.zr-item{display:flex;align-items:center;gap:9px;width:100%;height:28px;padding:0 var(--zr-gap-2);
  border-radius:9px;color:var(--zr-fg);font-size:var(--zr-ui-sm);letter-spacing:-.01em;text-align:left;
  transition:background-color var(--zr-timing) var(--zr-ease),color var(--zr-timing) var(--zr-ease)}
.zr-item:hover{background:var(--zr-survol)}
.zr-pastille{width:20px;height:20px;flex:none;border-radius:6px;display:grid;place-items:center;
  color:var(--zone);background:color-mix(in srgb,var(--zone) 15%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--zone) 22%,transparent)}
.zr-item .zr-libelle{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.zr-item .zr-badge{font-size:var(--zr-ui-2xs);color:var(--zr-fg-tenu)}
.zr-item.actif{background:color-mix(in srgb,var(--zone) 16%,transparent);color:var(--zr-fg);font-weight:500}
.zr-item.actif .zr-pastille{color:var(--zr-accent-fg);background:var(--zone);box-shadow:none}

/* Le second registre : huit entrees en grille de deux colonnes. */
.zr-grille-nav{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-top:3px}
.zr-puce{display:flex;align-items:center;gap:6px;height:26px;padding:0 7px;border-radius:8px;
  color:var(--zr-fg-doux);font-size:var(--zr-ui-2xs);letter-spacing:-.005em;text-align:left;
  transition:background-color var(--zr-timing) var(--zr-ease),color var(--zr-timing) var(--zr-ease)}
.zr-puce:hover{background:var(--zr-survol);color:var(--zr-fg)}
.zr-puce svg{flex:none;color:var(--zone);opacity:.8}
.zr-puce span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.zr-deplier{display:flex;align-items:center;gap:6px;width:100%;height:22px;padding:0 var(--zr-gap-2);margin-top:3px;
  border-radius:8px;color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs)}
.zr-deplier:hover{background:var(--zr-survol);color:var(--zr-fg-doux)}

.zr-sb-pied{flex:none;padding:var(--zr-gap-2) var(--zr-gap-2) 0;border-top:1px solid var(--zr-filet);
  display:flex;align-items:center;gap:var(--zr-gap-2);color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs)}

/* ═══════ VUE ASSETS ════════════════════════════════════════════════════════ */
.zr-vue{min-width:0;min-height:0;display:flex;flex-direction:column;background:var(--zr-bg-content)}

.zr-entete{flex:none;padding:var(--zr-gap-6) var(--zr-gap-8) var(--zr-gap-4);border-bottom:1px solid var(--zr-filet)}
.zr-fil{display:flex;align-items:center;gap:7px;color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);
  letter-spacing:.08em;text-transform:uppercase;margin-bottom:var(--zr-gap-3)}
.zr-entete-ligne{display:flex;align-items:flex-end;gap:var(--zr-gap-4);flex-wrap:wrap}
.zr-entete h1{font-size:31px;line-height:1.1}
.zr-entete .zr-chapo{margin:6px 0 0;max-width:56ch;color:var(--zr-fg-doux);font-size:var(--zr-ui-sm);line-height:1.55}
.zr-mesures{margin-left:auto;display:flex;gap:var(--zr-gap-6);padding-bottom:3px}
.zr-mesure{display:flex;flex-direction:column;gap:2px;align-items:flex-end}
.zr-mesure b{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);font-size:23px;line-height:1;letter-spacing:.005em}
.zr-mesure span{color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);letter-spacing:.07em;text-transform:uppercase}

/* Les filtres. Instantanes, jamais un formulaire a valider. */
.zr-filtres{position:sticky;top:0;z-index:5;flex:none;
  padding:var(--zr-gap-3) var(--zr-gap-8);border-bottom:1px solid var(--zr-filet);
  background:var(--zr-verre);backdrop-filter:var(--zr-verre-filtre);-webkit-backdrop-filter:var(--zr-verre-filtre);
  display:flex;flex-direction:column;gap:var(--zr-gap-2)}
.zr-rail{display:flex;align-items:center;gap:var(--zr-gap-2);flex-wrap:wrap}
.zr-rail-titre{color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);letter-spacing:.08em;text-transform:uppercase;
  width:62px;flex:none}
.zr-chip{display:inline-flex;align-items:center;gap:6px;height:27px;padding:0 11px;border-radius:999px;
  background:var(--zr-bg-creux);box-shadow:inset 0 0 0 1px var(--zr-filet);color:var(--zr-fg-doux);
  font-size:var(--zr-ui-2xs);white-space:nowrap;
  transition:background-color var(--zr-timing) var(--zr-ease),color var(--zr-timing) var(--zr-ease),box-shadow var(--zr-timing) var(--zr-ease)}
.zr-chip:hover{color:var(--zr-fg);background:var(--zr-survol)}
.zr-chip .zr-point{width:7px;height:7px;border-radius:50%;background:var(--teinte,var(--zr-fg-tenu))}
.zr-chip .zr-n{color:var(--zr-fg-tenu);font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres)}
.zr-chip[data-on="true"]{background:color-mix(in srgb,var(--teinte,var(--zr-accent)) 20%,transparent);
  color:var(--zr-fg);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--teinte,var(--zr-accent)) 45%,transparent)}
.zr-chip[data-on="true"] .zr-n{color:var(--zr-fg-doux)}
.zr-outils{margin-left:auto;display:flex;align-items:center;gap:var(--zr-gap-2)}
.zr-champ{display:flex;align-items:center;gap:7px;height:27px;padding:0 11px;border-radius:999px;
  background:var(--zr-bg-creux);box-shadow:inset 0 0 0 1px var(--zr-filet);color:var(--zr-fg-tenu)}
.zr-champ input{width:150px;border:0;outline:0;background:transparent;font-size:var(--zr-ui-2xs);color:var(--zr-fg)}
.zr-champ input::placeholder{color:var(--zr-fg-tenu)}
.zr-densite{display:inline-flex;gap:2px;padding:2px;border-radius:999px;background:var(--zr-bg-creux);
  box-shadow:inset 0 0 0 1px var(--zr-filet)}
.zr-densite button{width:26px;height:23px;border-radius:999px;color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);
  display:grid;place-items:center;transition:background-color var(--zr-timing) var(--zr-ease),color var(--zr-timing) var(--zr-ease)}
.zr-densite button[data-on="true"]{background:var(--zr-accent);color:var(--zr-accent-fg);font-weight:600}

/* La planche. C'est elle qui doit rendre cent assets lisibles d'un coup d'oeil. */
.zr-planche{flex:1;min-height:0;overflow-y:auto;padding:var(--zr-gap-6) var(--zr-gap-8) var(--zr-gap-8)}
.zr-lot-tete{display:flex;align-items:baseline;gap:var(--zr-gap-3);margin:var(--zr-gap-6) 0 var(--zr-gap-3)}
.zr-lot-tete:first-child{margin-top:0}
.zr-lot-tete h2{font-size:var(--zr-ui-2xl);letter-spacing:-.01em}
.zr-lot-tete .zr-trait{flex:1;height:1px;background:var(--zr-filet)}
.zr-lot-tete .zr-compte{color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs)}

.zr-grille{display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--zr-vignette-min),1fr));gap:var(--zr-gap-4)}

.zr-carte{position:relative;display:flex;flex-direction:column;gap:9px;text-align:left;border-radius:var(--zr-r-thumb);
  transition:transform var(--zr-timing) var(--zr-ease)}
.zr-carte:hover{transform:translateY(-3px)}
.zr-vignette{position:relative;width:100%;padding-top:var(--zr-vignette-ratio);border-radius:var(--zr-r-thumb);
  overflow:hidden;background:var(--zr-vignette-fond);
  box-shadow:inset 0 0 0 1px var(--zr-filet),var(--zr-ombre-douce);
  transition:box-shadow var(--zr-timing) var(--zr-ease)}
.zr-carte:hover .zr-vignette{box-shadow:inset 0 0 0 1px var(--zr-filet-fort),var(--zr-ombre-forte)}
.zr-carte[data-sel="true"] .zr-vignette{box-shadow:inset 0 0 0 2px var(--zr-accent),var(--zr-ombre-forte)}
.zr-vignette svg{position:absolute;inset:0;width:100%;height:100%}
/* Le motif dit clairement "emplacement" : trace au trait, jamais un faux rendu. */
.zr-vignette .zr-cadre-pointille{position:absolute;inset:10px;border:1px dashed var(--zr-filet-fort);
  border-radius:calc(var(--zr-r-thumb) - 5px);opacity:.55;pointer-events:none}
.zr-vignette .zr-hachure{position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(135deg,transparent 0 6px,var(--zr-hachure) 6px 12px)}
.zr-vignette .zr-nom-place{position:absolute;left:14px;right:14px;top:50%;transform:translateY(-50%);
  text-align:center;font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--zr-ui-lg);color:var(--zr-fg-doux);letter-spacing:.01em;pointer-events:none;
  transition:opacity var(--zr-timing) var(--zr-ease)}
.zr-carte:hover .zr-nom-place{opacity:0}

/* Le survol revele la metadonnee, la vignette reste la vedette au repos. */
.zr-voile{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;gap:5px;
  padding:11px 12px;opacity:0;pointer-events:none;
  background:linear-gradient(180deg,rgba(10,10,9,0) 26%,rgba(10,10,9,.62) 62%,rgba(10,10,9,.88));
  transition:opacity var(--zr-timing) var(--zr-ease)}
.zr-clair .zr-voile{background:linear-gradient(180deg,rgba(20,18,14,0) 26%,rgba(20,18,14,.52) 62%,rgba(20,18,14,.82))}
.zr-carte:hover .zr-voile{opacity:1}
.zr-voile-ligne{display:flex;gap:7px;flex-wrap:wrap;color:#F2F1EC;font-size:var(--zr-ui-3xs);letter-spacing:.02em}
.zr-voile-ligne b{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres)}
.zr-voile-sep{opacity:.45}
.zr-voile-servi{color:rgba(242,241,236,.78);font-size:var(--zr-ui-3xs);line-height:1.35}

.zr-etiquette{position:absolute;top:9px;left:9px;display:inline-flex;align-items:center;gap:5px;height:21px;
  padding:0 8px;border-radius:999px;background:rgba(12,12,11,.62);color:#F1F0EB;font-size:var(--zr-ui-3xs);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.zr-clair .zr-etiquette{background:rgba(255,255,255,.82);color:#26241F}
.zr-etiquette .zr-point{width:6px;height:6px;border-radius:50%;background:var(--teinte)}
.zr-fanion{position:absolute;top:9px;right:9px;height:21px;padding:0 8px;border-radius:999px;
  background:var(--zr-accent);color:var(--zr-accent-fg);font-size:var(--zr-ui-3xs);font-weight:600;
  display:inline-flex;align-items:center}

.zr-carte-pied{display:flex;align-items:baseline;gap:var(--zr-gap-2);padding:0 2px}
.zr-carte-pied h3{flex:1;min-width:0;font-size:var(--zr-ui-lg);line-height:1.3;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.zr-carte-pied .zr-an{color:var(--zr-fg-tenu);font-family:var(--zr-police-serif);
  font-weight:var(--zr-poids-nombres);font-size:var(--zr-ui-sm)}

/* ═══════ INSPECTEUR ════════════════════════════════════════════════════════
   Le seul endroit ou tout est ecrit, pour que la planche reste une planche. */
.zr-inspecteur{min-width:0;min-height:0;display:flex;flex-direction:column;
  border-left:1px solid var(--zr-filet);background:var(--zr-bg-window)}
.zr-insp-tete{flex:none;display:flex;align-items:center;gap:var(--zr-gap-2);height:38px;
  padding:0 var(--zr-gap-4);border-bottom:1px solid var(--zr-filet);
  color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);letter-spacing:.08em;text-transform:uppercase}
.zr-insp-corps{flex:1;min-height:0;overflow-y:auto;padding:var(--zr-gap-4)}
.zr-insp-vignette{position:relative;width:100%;padding-top:64%;border-radius:var(--zr-r-panel);overflow:hidden;
  background:var(--zr-vignette-fond);box-shadow:inset 0 0 0 1px var(--zr-filet)}
.zr-insp-vignette svg{position:absolute;inset:0;width:100%;height:100%}
.zr-insp-corps h2{margin-top:var(--zr-gap-4);font-size:22px;line-height:1.22}
.zr-insp-type{display:flex;align-items:center;gap:7px;margin-top:7px;color:var(--zr-fg-doux);font-size:var(--zr-ui-2xs)}
.zr-insp-desc{margin:var(--zr-gap-3) 0 0;font-family:var(--zr-police-serif);font-weight:var(--zr-poids-serif);
  font-size:var(--zr-ui-lg);line-height:1.58;color:var(--zr-fg-doux)}
.zr-fiche{margin-top:var(--zr-gap-4);border-top:1px solid var(--zr-filet)}
.zr-fiche-ligne{display:flex;align-items:baseline;gap:var(--zr-gap-3);padding:8px 0;border-bottom:1px solid var(--zr-filet)}
.zr-fiche-ligne dt{width:96px;flex:none;color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);
  letter-spacing:.05em;text-transform:uppercase}
.zr-fiche-ligne dd{margin:0;flex:1;min-width:0;font-size:var(--zr-ui-sm);color:var(--zr-fg)}
.zr-servi{margin-top:var(--zr-gap-4)}
.zr-servi-titre{color:var(--zr-fg-tenu);font-size:var(--zr-ui-2xs);letter-spacing:.08em;text-transform:uppercase;
  margin-bottom:var(--zr-gap-2)}
.zr-servi-liste{display:flex;flex-wrap:wrap;gap:6px}
.zr-tag{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;
  background:var(--zr-bg-creux);box-shadow:inset 0 0 0 1px var(--zr-filet);
  color:var(--zr-fg-doux);font-size:var(--zr-ui-2xs)}
.zr-actions{flex:none;display:flex;gap:var(--zr-gap-2);padding:var(--zr-gap-3) var(--zr-gap-4);
  border-top:1px solid var(--zr-filet);background:var(--zr-bg-creux)}
.zr-btn{flex:1;height:33px;border-radius:var(--zr-r-control);font-size:var(--zr-ui-2xs);font-weight:500;
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  background:var(--zr-bg-eleve);color:var(--zr-fg);box-shadow:inset 0 0 0 1px var(--zr-filet);
  transition:background-color var(--zr-timing) var(--zr-ease),transform .12s ease}
.zr-btn:hover{background:var(--zr-survol)}
.zr-btn:active{transform:scale(.98)}
.zr-btn-primaire{background:var(--zr-accent);color:var(--zr-accent-fg);box-shadow:none;font-weight:600}
.zr-btn-primaire:hover{filter:brightness(1.07);background:var(--zr-accent)}

.zr-vide{padding:var(--zr-gap-8);text-align:center;color:var(--zr-fg-tenu);font-size:var(--zr-ui-sm)}

@media (prefers-reduced-motion:reduce){
  *{transition:none !important;animation:none !important}
  .zr-carte:hover{transform:none}
}
</style>
</head>
<body>
