    font-weight: 100 900;
    font-display: swap;
  }
  @font-face {
    font-family: 'AnthropicSerif';
    src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/AnthropicSerif-Medium.ttf') format('truetype');
    font-weight: 500;
    font-display: swap;
  }
  @font-face {
    font-family: 'AnthropicMono';
    src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/AnthropicMono-Medium.ttf') format('truetype');
    font-weight: 500;
    font-display: swap;
  }

  :root {
    --zr-police-sans: 'InterVariable', 'Hiragino Sans W4', 'Hiragino Sans', sans-serif;
    --zr-police-serif: 'AnthropicSerif', 'Hiragino Mincho ProN W3', serif;
    --zr-police-mono: 'AnthropicMono', ui-monospace, monospace;
    --zr-poids-sans: 500;
    --zr-poids-serif: 500;
    --zr-poids-nombres: 500;

    /* Paramètres HDA (18 October 2026) */
    --hex-gold: #C89B3C;
    --hex-gold-bright: #F0E6D2;
    --hex-cyan: #0AC8B9;
    --hex-bg: #090D13;
    --hex-panel: #0F1620;
    --hex-border: rgba(200, 155, 60, 0.28);
    --card-radius: 12px;
    --panel-pad: 22px;
    --hero-size: 34px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #07090D;
    color: #F0E6D2;
    font-family: var(--zr-police-sans);
    font-weight: 500;
    padding: 20px 24px 48px;
    -webkit-font-smoothing: antialiased;
  }

  .num {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Barre HDA supérieure */
  .hda-bar {
    max-width: 1420px;
    margin: 0 auto 22px;
    background: #0E131B;
    border: 1px solid var(--hex-border);
    border-radius: 14px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hda-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 20px;
    color: var(--hex-gold-bright);
  }

  .hda-sub {
    font-size: 12px;
    color: rgba(240, 230, 210, 0.56);
    margin-left: 10px;
  }

  .hda-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .s-group {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: rgba(240, 230, 210, 0.75);
  }

  .s-group input[type="range"] {
    width: 76px;
    accent-color: var(--hex-gold);
    cursor: pointer;
  }

  .chip {
    background: rgba(200, 155, 60, 0.10);
    border: 1px solid var(--hex-border);
    color: var(--hex-gold-bright);
    font-family: var(--zr-police-sans);
    font-weight: 500;
    font-size: 11.5px;
    padding: 5px 11px;
    border-radius: 8px;
    cursor: pointer;
  }

  .chip.active {
    background: var(--hex-gold);
    color: #090D13;
    border-color: var(--hex-gold);
  }

  .copy-btn {
    background: var(--hex-gold);
    color: #090D13;
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    font-family: var(--zr-police-sans);
    font-weight: 500;
    font-size: 12px;
    cursor: pointer;
  }

  /* Pile des 3 propositions */
  .stack {
    max-width: 1420px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .design-card {
    background: #0B1017;
    border: 1px solid rgba(200, 155, 60, 0.18);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    cursor: pointer;
  }

  .design-card.selected {
    border-color: var(--hex-gold);
    box-shadow: 0 0 0 1px rgba(200, 155, 60, 0.35);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card-head-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .letter-hex {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: rgba(200, 155, 60, 0.16);
    border: 1px solid var(--hex-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 13px;
    color: var(--hex-gold-bright);
  }

  .design-card.selected .letter-hex {
    background: var(--hex-gold);
    color: #090D13;
  }

  .card-title {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 18px;
    color: var(--hex-gold-bright);
  }

  .card-desc {
    font-size: 12px;
    color: rgba(240, 230, 210, 0.56);
  }

  /* Fenêtre ZenRayProgress avec onglet Money */
  .zrp-frame {
    display: grid;
    grid-template-columns: 168px 1fr;
    min-height: 450px;
    border-radius: var(--card-radius);
    overflow: hidden;
    border: 1px solid var(--hex-border);
    background: var(--hex-bg);
  }

  .zrp-sidebar {
    background: #080B10;
    border-right: 1px solid rgba(200, 155, 60, 0.14);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 12.5px;
    color: rgba(240, 230, 210, 0.62);
  }

  .traffic {
    display: flex;
    gap: 6px;
    padding: 2px 6px 16px;
  }

  .traffic span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .nav-col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav-row {
    padding: 7px 10px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-row.active-gold {
    background: rgba(200, 155, 60, 0.16);
    border: 1px solid rgba(200, 155, 60, 0.38);
    color: var(--hex-gold-bright);
  }

  .money-stage {
    padding: var(--panel-pad) 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    background: radial-gradient(circle at 85% 10%, rgba(200, 155, 60, 0.10), transparent 55%), var(--hex-bg);
  }

  /* En-tête Ranked LoL */
  .rank-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(200, 155, 60, 0.18);
  }

  .rank-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .crest-badge {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    background: linear-gradient(145deg, rgba(200, 155, 60, 0.28), rgba(10, 200, 185, 0.14));
    border: 1.5px solid var(--hex-gold);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--zr-police-serif);
    color: var(--hex-gold-bright);
  }

  .hero-amount {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: var(--hero-size);
    color: var(--hex-gold-bright);
    line-height: 1.1;
  }

  .rank-sub {
    font-size: 12px;
    color: rgba(240, 230, 210, 0.65);
    margin-top: 4px;
  }

  .xp-bar-wrap {
    flex: 1;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .xp-labels {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: rgba(240, 230, 210, 0.78);
  }

  .xp-track {
    height: 8px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(200, 155, 60, 0.30);
    overflow: hidden;
  }

  .xp-fill {
    height: 100%;
    width: 64.5%;
    background: linear-gradient(90deg, var(--hex-gold), #F5D77F);
  }

  .gold-cta {
    background: rgba(200, 155, 60, 0.18);
    border: 1px solid var(--hex-gold);
    color: var(--hex-gold-bright);
    padding: 9px 15px;
    border-radius: 9px;
    font-size: 12px;
  }

  /* Grille 3 Champions = 3 Projets ZenRay Assets */
  .champions-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .champ-card {
    background: var(--hex-panel);
    border: 1px solid rgba(200, 155, 60, 0.22);
    border-radius: var(--card-radius);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .champ-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .champ-name {
    font-family: var(--zr-police-serif);
    font-weight: 500;
    font-size: 16px;
    color: var(--hex-gold-bright);
  }

  .mastery-tag {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(10, 200, 185, 0.14);
    border: 1px solid rgba(10, 200, 185, 0.35);
    color: var(--hex-cyan);
  }

  .champ-gold {
    font-family: var(--zr-police-serif);
    font-size: 22px;
    color: var(--hex-gold);
  }

  .champ-quest {
    font-size: 11.5px;
    color: rgba(240, 230, 210, 0.72);
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
  }

  /* Frise hebdomadaire en bas */
  .weeks-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(200, 155, 60, 0.16);
  }

  .week-pill {
    padding: 8px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    font-size: 12px;
  }

  .week-pill.current {
    background: rgba(200, 155, 60, 0.14);
    border-color: var(--hex-gold);
  }

  /* Design B : Quêtes Publication -> Cashflow */
  .bounty-split {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 18px;
    flex: 1;
  }

  .weekly-drop-box {
    background: var(--hex-panel);
    border: 1px solid var(--hex-border);
    border-radius: var(--card-radius);
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .bounty-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bounty-row {
    background: var(--hex-panel);
    border: 1px solid rgba(200, 155, 60, 0.20);
    border-radius: 10px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* Design C : Trésorerie Souveraine Épurée */
  .minimal-vault {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .kpi-trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .kpi-box {
    padding: 16px 18px;
    border-radius: var(--card-radius);
    background: var(--hex-panel);
    border: 1px solid rgba(200, 155, 60, 0.20);
  }

  .kpi-label {
    font-size: 11.5px;
    color: rgba(240, 230, 210, 0.58);
    margin-bottom: 6px;
  }

  .kpi-val {
    font-family: var(--zr-police-serif);
    font-size: 26px;
    color: var(--hex-gold-bright);
  }
</style>
