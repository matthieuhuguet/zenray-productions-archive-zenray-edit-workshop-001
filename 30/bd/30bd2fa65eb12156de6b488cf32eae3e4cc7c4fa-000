button.ui{font:inherit;font-weight:500;border:1px solid var(--page-line);background:transparent;color:var(--page-ink);border-radius:999px;padding:7px 14px;cursor:pointer}
button.ui:hover{border-color:var(--clay)}
main{max-width:1180px;margin:0 auto;padding:0 20px 60px}
section.proposal{margin:44px 0 0;padding-top:28px;border-top:1px solid var(--page-line)}
.proposal .meta{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:baseline}
.proposal p.desc{color:var(--page-muted);margin:6px 0 16px;max-width:780px}
.tag{font-size:12px;font-weight:500;color:var(--clay-deep);letter-spacing:.04em;text-transform:uppercase}

/* Mock screen / faux écran */
.screen{position:relative;width:100%;max-width:calc(var(--screen-w)*var(--scale)*1px);aspect-ratio:1728/1117;border-radius:14px;overflow:hidden;
  background:linear-gradient(135deg,#3d4a5c 0%,#6b5b73 45%,#c08a6a 100%);box-shadow:0 24px 60px -30px rgba(0,0,0,.5);container-type:inline-size}
.screen .menubar{position:absolute;inset:0 0 auto 0;height:2.2cqw;background:rgba(255,255,255,.28);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:flex-end;padding:0 1.2cqw;gap:1.2cqw;color:#fff;font-size:.95cqw;font-weight:500}
.screen .window{position:absolute;left:8%;top:14%;width:54%;height:62%;border-radius:1cqw;background:rgba(255,255,255,.86);box-shadow:0 2cqw 4cqw -2cqw rgba(0,0,0,.4)}
.screen .window::before{content:"";position:absolute;left:1.2cqw;top:1.1cqw;width:4cqw;height:.9cqw;background:radial-gradient(circle at .45cqw 50%,#ff5f57 .4cqw,transparent .42cqw),radial-gradient(circle at 1.75cqw 50%,#febc2e .4cqw,transparent .42cqw),radial-gradient(circle at 3.05cqw 50%,#28c840 .4cqw,transparent .42cqw)}
.screen .window .lines{position:absolute;left:6%;right:6%;top:18%;display:grid;gap:1.2cqw}
.screen .window .lines i{display:block;height:.9cqw;border-radius:1cqw;background:#e3ddd3}
.screen .window .lines i:nth-child(2){width:80%}.screen .window .lines i:nth-child(3){width:64%}
.dock{position:absolute;left:50%;bottom:.6cqw;transform:translateX(-50%);width:34%;height:3.6cqw;border-radius:1.2cqw;background:rgba(255,255,255,.3);backdrop-filter:blur(10px)}
.state{position:absolute;right:1.2cqw;top:2.8cqw;font-size:.9cqw;color:#fff;font-weight:500;background:rgba(0,0,0,.28);padding:.3cqw .8cqw;border-radius:2cqw}

/* All widget sizes are written in points, converted by --pt (1 pt in cqw units of the screen). */
.screen{--pt:calc(100cqw/1728)}
.rec,.result{position:absolute;opacity:0;pointer-events:none;transition:opacity var(--t-fade) ease,transform var(--t-move) ease}
.rec{right:calc(var(--edge-inset)*var(--pt));top:50%;transform:translate(10%,-50%)}
.result{left:50%;bottom:calc((var(--bottom-inset) + 64)*var(--pt));transform:translate(-50%,12%)}
.screen[data-state="rec"] .rec,.screen[data-state="busy"] .rec{opacity:1;transform:translate(0,-50%)}
.screen[data-state="done"] .result{opacity:1;transform:translate(-50%,0)}
.bars{display:flex;align-items:center;gap:calc(3*var(--pt))}
.bars b{display:block;width:calc(4*var(--pt));border-radius:calc(2*var(--pt));height:calc(6*var(--pt));background:currentColor;transition:height .08s}
.screen[data-state="busy"] .bars b{height:calc(4*var(--pt))!important;opacity:.45}
.timer{font-family:var(--zr-police-serif);font-variant-numeric:tabular-nums}

/* ===== A : Verre sombre, pilule verticale ===== */
.A{--a-bg:rgba(22,20,18,.72);--a-ink:#f4efe6;--a-accent:var(--clay);--a-w:64;--a-h:212;--a-radius:32;--a-result-w:720}
.A .rec{width:calc(var(--a-w)*var(--pt));height:calc(var(--a-h)*var(--pt));border-radius:calc(var(--a-radius)*var(--pt));background:var(--a-bg);backdrop-filter:blur(20px) saturate(1.4);
  border:calc(1*var(--pt)) solid rgba(255,255,255,.14);color:var(--a-ink);display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:calc(16*var(--pt)) 0;box-shadow:0 calc(18*var(--pt)) calc(40*var(--pt)) calc(-18*var(--pt)) rgba(0,0,0,.6)}
.A .rec .dot{width:calc(12*var(--pt));height:calc(12*var(--pt));border-radius:50%;background:var(--a-accent);box-shadow:0 0 calc(10*var(--pt)) var(--a-accent);animation:pulse 1.2s infinite}
.A .rec .bars{flex-direction:column;color:var(--a-accent)}
.A .rec .bars b{height:calc(4*var(--pt));width:calc(6*var(--pt))}
.A .rec .timer{font-size:calc(13*var(--pt))}
.A .result{width:calc(var(--a-result-w)*var(--pt));border-radius:calc(22*var(--pt));background:var(--a-bg);backdrop-filter:blur(20px) saturate(1.4);border:calc(1*var(--pt)) solid rgba(255,255,255,.14);color:var(--a-ink);
  padding:calc(16*var(--pt)) calc(22*var(--pt));font-family:var(--zr-police-serif);font-size:calc(17*var(--pt));line-height:1.45;box-shadow:0 calc(18*var(--pt)) calc(40*var(--pt)) calc(-18*var(--pt)) rgba(0,0,0,.6)}
.A .result .chip{display:inline-block;margin-left:calc(10*var(--pt));font-family:var(--zr-police-sans);font-size:calc(11*var(--pt));font-weight:500;color:var(--a-accent)}

/* ===== B : Papier Claude, capsule horizontale ===== */
.B{--b-bg:#f7f2ea;--b-ink:#2a2622;--b-muted:#8b8378;--b-accent:var(--clay);--b-w:300;--b-h:60;--b-result-w:640}
.B .rec{width:calc(var(--b-w)*var(--pt));height:calc(var(--b-h)*var(--pt));border-radius:calc(var(--b-h)/2*var(--pt));background:var(--b-bg);color:var(--b-ink);display:flex;align-items:center;gap:calc(12*var(--pt));padding:0 calc(18*var(--pt));
  box-shadow:0 calc(14*var(--pt)) calc(32*var(--pt)) calc(-14*var(--pt)) rgba(60,40,20,.45),0 0 0 calc(1*var(--pt)) rgba(120,90,60,.12)}
.B .rec .mic{width:calc(30*var(--pt));height:calc(30*var(--pt));border-radius:50%;background:var(--b-accent);display:grid;place-items:center;flex:none;animation:pulse 1.2s infinite}
.B .rec .mic svg{width:calc(14*var(--pt));height:calc(14*var(--pt))}
.B .rec .bars{flex:1;color:var(--b-accent)}
.B .rec .timer{font-size:calc(14*var(--pt));color:var(--b-muted)}
.B .result{width:calc(var(--b-result-w)*var(--pt));border-radius:calc(18*var(--pt));background:var(--b-bg);color:var(--b-ink);padding:calc(16*var(--pt)) calc(20*var(--pt)) calc(14*var(--pt));
  box-shadow:0 calc(14*var(--pt)) calc(32*var(--pt)) calc(-14*var(--pt)) rgba(60,40,20,.45),0 0 0 calc(1*var(--pt)) rgba(120,90,60,.12)}
.B .result h4{margin:0 0 calc(4*var(--pt));font-family:var(--zr-police-titres);font-style:italic;font-weight:400;font-size:calc(14*var(--pt));color:var(--b-accent)}
.B .result p{margin:0;font-family:var(--zr-police-serif);font-size:calc(17*var(--pt));line-height:1.45}
.B .result .actions{display:flex;gap:calc(14*var(--pt));margin-top:calc(10*var(--pt));font-size:calc(11*var(--pt));font-weight:500;color:var(--b-muted)}

/* ===== C : Orbe minimal, une ligne ===== */
.C{--c-size:46;--c-accent:var(--clay);--c-bg:rgba(14,13,12,.82);--c-ink:#fff}
.C .rec{width:calc(var(--c-size)*var(--pt));height:calc(var(--c-size)*var(--pt));border-radius:50%;background:radial-gradient(circle at 35% 30%,#f0a685,var(--c-accent) 60%,#8f3f24);
  box-shadow:0 0 0 calc(var(--ring,0)*var(--pt)) rgba(217,119,87,.28),0 calc(10*var(--pt)) calc(24*var(--pt)) calc(-8*var(--pt)) rgba(0,0,0,.55);display:grid;place-items:center;transition:opacity var(--t-fade),transform var(--t-move),box-shadow .08s}
.C .rec svg{width:calc(18*var(--pt));height:calc(18*var(--pt))}
.C .screen[data-state="busy"] .rec{animation:spin 1s linear infinite}
.C .result{max-width:calc(820*var(--pt));border-radius:calc(999*var(--pt));background:var(--c-bg);backdrop-filter:blur(16px);color:var(--c-ink);padding:calc(12*var(--pt)) calc(22*var(--pt));font-size:calc(15*var(--pt));font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.C .result .k{color:var(--c-accent);margin-right:calc(8*var(--pt))}

/* Real-size detail / détail en taille réelle : 1 pt = 1 px */
.detail{--pt:1px;margin-top:14px;display:flex;gap:28px;align-items:center;justify-content:center;flex-wrap:wrap;padding:34px 24px;border-radius:14px;background:linear-gradient(135deg,#3d4a5c 0%,#6b5b73 45%,#c08a6a 100%)}
.detail .rec,.detail .result{position:static;opacity:1;transform:none;pointer-events:auto}
.detail .result{max-width:100%}
.detail-label{width:100%;text-align:center;color:#fff;font-size:12px;font-weight:500;opacity:.8;margin-top:-18px}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.12)}}
@keyframes spin{to{filter:hue-rotate(25deg) brightness(1.1)}}

/* Icons / icônes */
.icons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:18px}
.icons figure{margin:0;text-align:center}
.icons svg{width:100%;max-width:200px;height:auto;filter:drop-shadow(0 16px 24px rgba(0,0,0,.22))}
.icons .dock-row{display:flex;justify-content:center;gap:10px;margin-top:10px}
.icons .dock-row svg{width:36px;filter:none}
figcaption{color:var(--page-muted);font-size:13px;margin-top:8px}
.notes{margin-top:30px;color:var(--page-muted);font-size:13px}
@media (max-width:720px){.icons{grid-template-columns:1fr}h1{font-size:34px}}
