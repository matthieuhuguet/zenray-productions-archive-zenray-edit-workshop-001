:root{
  /* Global tokens / jetons globaux (25 October 2026) */
  --zr-police-sans:'InterVariable','Hiragino Sans W4',sans-serif;
  --zr-police-titres:'GT Sectra LCG','AnthropicSerif',serif;
  --zr-style-titres:italic;
  --zr-police-serif:'AnthropicSerif','Hiragino Mincho ProN W3',serif;
  --page-bg:#f4f1ea; --page-ink:#1d1b18; --page-muted:#6f6a61; --page-line:#e0dace;
  --clay:#d97757; --clay-deep:#b85c3e; --cream:#f5f0e8;
  /* Screen mock / faux écran : 1728 x 1117 pt shown at --scale */
  --screen-w:1728; --screen-h:1117; --scale:0.52;
  --edge-inset:16; --bottom-inset:24;
  /* Timing / temps (seconds) */
  --t-fade:.18s; --t-move:.24s;
}
@media (prefers-color-scheme:dark){:root{--page-bg:#171614;--page-ink:#ece7de;--page-muted:#9b958b;--page-line:#2c2a26}}
*{box-sizing:border-box}
body{margin:0;background:var(--page-bg);color:var(--page-ink);font-family:var(--zr-police-sans);font-weight:400;font-size:15px;line-height:1.55}
.num{font-family:var(--zr-police-serif);font-style:normal}
header.page{max-width:1180px;margin:0 auto;padding:40px 20px 8px}
h1,h2,h3{font-family:var(--zr-police-titres);font-style:var(--zr-style-titres);font-weight:400;letter-spacing:-.01em;margin:0}
h1{font-size:44px;line-height:1.1}
h2{font-size:30px;margin-bottom:6px}
