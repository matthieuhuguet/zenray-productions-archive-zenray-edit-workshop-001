          <rect x="64" y="64" width="896" height="896" rx="200" fill="url(#g1)"/>
          <g stroke="#fff6ee" stroke-width="34" stroke-linecap="round" opacity=".9"><line x1="512" y1="170" x2="512" y2="250"/><line x1="512" y1="774" x2="512" y2="854"/><line x1="170" y1="512" x2="250" y2="512"/><line x1="774" y1="512" x2="854" y2="512"/><line x1="270" y1="270" x2="326" y2="326"/><line x1="698" y1="698" x2="754" y2="754"/><line x1="754" y1="270" x2="698" y2="326"/><line x1="326" y1="698" x2="270" y2="754"/></g>
          <rect x="432" y="318" width="160" height="290" rx="80" fill="#fff"/><path d="M362 500a150 150 0 0 0 300 0M512 650v72" fill="none" stroke="#fff" stroke-width="40" stroke-linecap="round"/></svg>
        <figcaption>1 · Terracotta, micro et rayons</figcaption>
      </figure>
      <figure>
        <svg viewBox="0 0 1024 1024" class="ico2"><rect x="64" y="64" width="896" height="896" rx="200" fill="#f5efe6"/>
          <g fill="#d97757"><path d="M512 190 548 430 512 470 476 430Z"/><path d="M512 834 476 594 512 554 548 594Z"/><path d="M190 512 430 476 470 512 430 548Z"/><path d="M834 512 594 548 554 512 594 476Z"/><path d="M284 284 470 452 452 470Z" opacity=".75"/><path d="M740 740 554 572 572 554Z" opacity=".75"/><path d="M740 284 572 470 554 452Z" opacity=".75"/><path d="M284 740 452 554 470 572Z" opacity=".75"/></g>
          <circle cx="512" cy="512" r="128" fill="#2a2622"/><rect x="478" y="440" width="68" height="116" rx="34" fill="#f5efe6"/><path d="M450 520a62 62 0 0 0 124 0M512 584v28" fill="none" stroke="#f5efe6" stroke-width="18" stroke-linecap="round"/></svg>
