        <svg viewBox="0 0 1024 1024" class="ico3"><defs><linearGradient id="g3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22201d"/><stop offset="1" stop-color="#0f0e0d"/></linearGradient></defs>
