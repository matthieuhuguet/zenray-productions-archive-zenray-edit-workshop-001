<script>
// 25 October 2026: replays Fn -> recording -> transcription -> result on every mock screen. / rejoue la séquence sur chaque faux écran.
const PARAMS = { recordMs: 3200, busyMs: 700, resultMs: 2600, idleMs: 900, bars: { A: 9, B: 22, C: 0 },
  text: 'Bonjour, je teste la dictée de Claude avec Houdini et Unreal Engine.' }
const screens = [...document.querySelectorAll('section.proposal .screen')]
screens.forEach(s => { const d = document.createElement('div'); d.className = 'detail'; d.dataset.state = 'rec'; d.append(s.querySelector('.rec').cloneNode(true), s.querySelector('.result').cloneNode(true)); const l = document.createElement('div'); l.className = 'detail-label'; l.textContent = 'Taille réelle : widget d’enregistrement, puis texte'; d.append(l); s.after(d) })
const details = [...document.querySelectorAll('.detail')]
;[...screens, ...details].forEach(s => { const kind = s.closest('section').classList[1]; const bars = s.querySelector('.bars'); if (bars) for (let i = 0; i < PARAMS.bars[kind]; i++) bars.append(document.createElement('b')); s.querySelectorAll('.text').forEach(t => t.textContent = PARAMS.text) })
const label = { idle: 'prêt', rec: 'Fn · enregistrement', busy: 'transcription', done: 'texte copié' }
let paused = false, timers = []
function set(state) { screens.forEach(s => { s.dataset.state = state; s.querySelector('.state').textContent = label[state] }) }
function cycle() {
  timers.forEach(clearTimeout); timers = []; set('idle')
  const t0 = PARAMS.idleMs; timers.push(setTimeout(() => set('rec'), t0))
  timers.push(setTimeout(() => set('busy'), t0 + PARAMS.recordMs))
  timers.push(setTimeout(() => set('done'), t0 + PARAMS.recordMs + PARAMS.busyMs))
  timers.push(setTimeout(() => { if (!paused) cycle() }, t0 + PARAMS.recordMs + PARAMS.busyMs + PARAMS.resultMs))
}
let start = performance.now()
function tick(now) {
  ;[...screens, ...details].forEach(s => {
    const rec = s.dataset.state === 'rec'
    s.querySelectorAll('.bars b').forEach((b, i) => { const v = rec ? 6 + 22 * Math.abs(Math.sin(now / 140 + i * 0.9) * Math.sin(now / 410 + i)) : 6; b.style.height = `calc(${v.toFixed(1)}*var(--pt))` })
    const t = s.querySelector('.timer'); if (t && rec && !s.classList.contains('detail')) { const sec = Math.floor((now - start) / 1000) % 60; t.textContent = `0:${String(sec).padStart(2, '0')}` }
    const orb = s.closest('.C') && s.querySelector('.rec'); if (orb) orb.style.setProperty('--ring', rec ? (4 + 10 * Math.abs(Math.sin(now / 160))).toFixed(1) : 0)
  })
  requestAnimationFrame(tick)
}
new MutationObserver(() => {}).observe(document.body, { subtree: true, attributes: true })
screens.forEach(s => new MutationObserver(() => { if (s.dataset.state === 'rec') start = performance.now() }).observe(s, { attributes: true, attributeFilter: ['data-state'] }))
document.getElementById('replay').onclick = () => { paused = false; cycle() }
document.getElementById('pause').onclick = () => { paused = true; timers.forEach(clearTimeout); set('done') }
// Dock sizes / tailles Dock
const dock = document.getElementById('dockSizes')
document.querySelectorAll('.icons svg').forEach(svg => { const f = document.createElement('figure'); f.className = 'dock-row'; [16, 32, 64].forEach(sz => { const c = svg.cloneNode(true); c.style.width = sz + 'px'; c.removeAttribute('class'); f.append(c) }); dock.append(f) })
cycle(); requestAnimationFrame(tick)
</script>
</body>
