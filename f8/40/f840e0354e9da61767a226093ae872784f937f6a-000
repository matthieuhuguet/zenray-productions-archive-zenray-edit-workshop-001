    alt: "A Versailles planter box next to its Houdini node graph" }
];

const FEATURED = ["bayou", "rock", "toki", "cliff"];

const COLLECTIONS = [
  { title: "Japan, rebuilt in 3D", ids: ["toki"], img: "assets/09-toki-rooftops.webp",
    alt: "Temple rooftops over a red autumn forest at sunset",
    text: "Places captured in Japan and rebuilt as Unreal environments. The series continues from Tokyo in 2027." },
  { title: "Procedural Houdini tools", ids: ["rock", "stairs", "pampa", "planter", "bayou"], img: "assets/03-rock-generator.webp",
    alt: "A procedural grey rock with sharp fractured facets",
    text: "Houdini digital assets for rocks, stairs, grass, planters and whole buildings." },
  { title: "Unreal environments and props", ids: ["toki", "bayou", "wheel"], img: "assets/05-water-wheel.webp",
    alt: "A wooden water wheel with water pouring over it",
    text: "Scenes and props packaged for Unreal Engine 5, from a temple to a water mill." }
];

const SERVICES = [
  { title: "Environment sprint", text: "Five days, one procedural environment built in Houdini and delivered in Unreal, ready to integrate." },
  { title: "Custom Houdini tool", text: "A documented digital asset designed around your pipeline: scattering, modular kits, vegetation." },
  { title: "Technical art on demand", text: "Remote technical art for Unreal Engine and Houdini, booked by the day." }
];

const JOURNAL = [
  { title: "Scattering assets from Houdini to Unreal", img: "assets/10-scattering.webp",
    alt: "Houdini viewport and Unreal viewport side by side with scattered trees" },
  { title: "Organic texturing with Point VOP", img: "assets/11-point-vop.webp",
    alt: "A procedurally textured rock with the words Organic texturing with Point VOP" },
  { title: "Procedural shutters in Houdini", img: "assets/12-shutters.webp",
    alt: "Procedural wooden shutters with the title Procedural shutters in Houdini" }
];

const TOOLS = ["Houdini", "Unreal Engine 5", "Substance Designer", "ZBrush"];

const FOOT_LINKS = ["Fab store", "Gumroad", "Instagram", "LinkedIn", "matthieuhuguet.com", "Legal notice"];

/* ── Templates ── */
const byId = (id) => PRODUCTS.find((p) => p.id === id);

function plate(src, alt, eager, focus){
  const pos = focus ? ` style="object-position:${focus}"` : "";
  return `<span class="plate"><img src="${src}" alt="${alt}"${pos} ${eager ? "" : "loading=\"lazy\""} decoding="async"></span>`;
}

function productCard(p){
  return `
    <a class="card" href="#latest" data-id="${p.id}" aria-label="${p.title}, ${TYPES[p.type]}, ${p.price} on ${p.store}">
      ${plate(p.img, p.alt, false, p.focus)}
      <span class="card-body">
        <span class="type">${TYPES[p.type]} · ${p.software}</span>
        <span class="card-title">${p.title}</span>
        <span class="card-sub">${p.sub}</span>
        <span class="card-foot"><span class="price n">${p.price}</span><span class="store">on ${p.store}</span></span>
      </span>
    </a>`;
}

function renderNav(){
  document.getElementById("mainNav").innerHTML = NAV.map((n) => `<a href="${n.href}">${n.label}</a>`).join("");
}

function renderFeatured(){
  document.getElementById("featuredGrid").innerHTML = FEATURED.map(byId).map((p) => `
    <a href="#latest" data-id="${p.id}">
      ${plate(p.img, p.alt, false, p.focus)}
      <span class="featured-legend">
        <span class="type">${TYPES[p.type]}</span>
        <span class="featured-title">${p.title}</span>
        <span class="view">View</span>
      </span>
    </a>`).join("");
}

function renderCollections(){
  document.getElementById("collectionsGrid").innerHTML = COLLECTIONS.map((c) => {
    const items = c.ids.map(byId);
    const software = [...new Set(items.map((p) => p.software))].join(", ");
    const count = items.length;
    return `
      <a class="collection" href="#latest">
        ${plate(c.img, c.alt, false)}
        <span class="collection-body">
          <span class="type">Collection</span>
          <h3 class="collection-title">${c.title}</h3>
          <p class="collection-text">${c.text}</p>
          <span class="stats"><span><span class="n">${count}</span> ${count > 1 ? "assets" : "asset"}</span><span class="sep">·</span><span>${software}</span></span>
        </span>
      </a>`;
  }).join("");
}

let activeType = "all";
let query = "";

function renderFilters(){
  const count = (key) => key === "all" ? PRODUCTS.length : PRODUCTS.filter((p) => p.type === key).length;
  const keys = ["all", ...Object.keys(TYPES)].filter((k) => count(k) > 0);
  const label = (k) => k === "all" ? "All" : TYPES[k] + "s";
  const host = document.getElementById("filters");
  host.innerHTML = keys.map((k) => `
    <button class="filter" data-key="${k}" data-on="${k === activeType ? "1" : "0"}">${label(k)}<span class="n">${count(k)}</span></button>`).join("");
  host.querySelectorAll(".filter").forEach((b) => b.addEventListener("click", () => {
    activeType = b.dataset.key;
    host.querySelectorAll(".filter").forEach((x) => x.dataset.on = x === b ? "1" : "0");
    renderLatest();
  }));
}

function renderLatest(){
  const q = query.trim().toLowerCase();
  const list = PRODUCTS.filter((p) =>
    (activeType === "all" || p.type === activeType) &&
    (!q || (p.title + " " + p.sub + " " + p.software).toLowerCase().includes(q)));
  document.getElementById("latestGrid").innerHTML = list.length
    ? list.map(productCard).join("")
    : `<p class="empty">Nothing matches “${q}” yet.</p>`;
}

function renderServices(){
  document.getElementById("servicesGrid").innerHTML = SERVICES.map((s, i) => `
    <div class="service">
      <span class="service-index n">0${i + 1}</span>
      <h3 class="service-title">${s.title}</h3>
      <p class="service-text">${s.text}</p>
    </div>`).join("");
}

function renderJournal(){
  document.getElementById("journalGrid").innerHTML = JOURNAL.map((j) => `
    <a class="post" href="#journal">
      ${plate(j.img, j.alt, false)}
      <span class="post-body">
        <span class="type">Breakdown</span>
        <span class="post-title">${j.title}</span>
        <span class="post-where">Read on matthieuhuguet.com</span>
      </span>
    </a>`).join("");
}

function renderTools(){
  document.getElementById("toolsStrip").innerHTML =
    `<span class="label">Built with</span>` + TOOLS.map((t) => `<span>${t}</span>`).join(`<span class="sep">·</span>`);
  document.getElementById("footLinks").innerHTML = FOOT_LINKS.map((l) => `<a href="#contact">${l}</a>`).join("");
}

/* ── Theme: light by default, one button, remembered when storage allows it ── */
const THEME_KEY = "zrs:theme";
function applyTheme(t){ document.documentElement.classList.toggle("dark", t === "dark"); }
/* ?theme=dark forces a theme for a shared preview or a headless capture; the button still wins after.
   FR : ?theme=dark force un thème pour un aperçu partagé ou une capture sans écran. */
const urlTheme = new URLSearchParams(location.search).get("theme");
try { applyTheme(urlTheme || localStorage.getItem(THEME_KEY) || "light"); } catch (e) { applyTheme(urlTheme || "light"); }
document.getElementById("btnTheme").addEventListener("click", () => {
  const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
  applyTheme(next);
  try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
});

document.getElementById("searchInput").addEventListener("input", (e) => {
  query = e.target.value;
  renderLatest();
  if (query) document.getElementById("latest").scrollIntoView({ block: "start" });
});

renderNav(); renderFeatured(); renderCollections(); renderFilters(); renderLatest();
renderServices(); renderJournal(); renderTools();
</script>
</body>
