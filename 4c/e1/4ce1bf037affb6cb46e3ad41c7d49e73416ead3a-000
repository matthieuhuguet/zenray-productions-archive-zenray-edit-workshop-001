<!doctype html>
<!-- 12 October 2026: ZenRay Assets rework, three parametric proposals (Tube, Gallery, Shelves). Every visual value lives in :root; the panel writes only CSS variables. -->
<!-- FR : refonte ZenRay Assets, trois propositions paramétriques. Toute valeur visuelle vit dans :root ; le panneau n'écrit que des variables CSS. -->
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZenRay Assets Rework</title>
<style>
@font-face { font-family: 'InterVariable'; src: local('Inter Variable'), local('InterVariable'); font-weight: 100 900; }
:root {
  /* Fonts (Typography1.md trio) */
  --zr-police-sans: 'InterVariable', 'Inter Variable', 'Hiragino Sans W4', 'Hiragino Sans', sans-serif;
  --zr-police-serif: 'AnthropicSerif', 'Hiragino Mincho ProN W3', serif;
  --zr-poids-sans: 400; --zr-poids-serif: 350; --zr-poids-nombres: 400;
  /* LAYOUT */
  --card-min: 260px; --gap: 22px; --radius: 14px; --page-pad: 32px; --rail-w: 220px; --cover-ratio: 1.778;
  /* TYPE */
  --title-size: 14px; --meta-size: 12.5px; --hero-size: 40px; --ui-size: 13.5px;
  /* MOTION AND LOADING */
  --latency: 450; --fade: 260ms; --lift: 3px; --spinner: 22px;
  /* COLOUR */
  --accent-h: 18; --accent-s: 62%; --glass: 0.72; --bg-blur: 28px;
  /* Derived (never edited directly) */
  --accent: hsl(var(--accent-h) var(--accent-s) 58%);
  --accent-soft: hsl(var(--accent-h) var(--accent-s) 58% / .14);
  --bg: #eef0f3; --surface: rgb(255 255 255 / var(--glass)); --ink: #16171a; --ink-2: #6b6f76; --ink-3: #a3a7ae; --line: rgb(0 0 0 / .07);
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #111214; --surface: rgb(30 31 34 / var(--glass)); --ink: #f2f2f3; --ink-2: #a0a3a9; --ink-3: #6a6d73; --line: rgb(255 255 255 / .08); } }
:root[data-theme="dark"] { --bg: #111214; --surface: rgb(30 31 34 / var(--glass)); --ink: #f2f2f3; --ink-2: #a0a3a9; --ink-3: #6a6d73; --line: rgb(255 255 255 / .08); }

* { box-sizing: border-box; margin: 0; }
html, body { height: 100%; }
body { background: var(--bg); color: var(--ink); font-family: var(--zr-police-sans); font-weight: var(--zr-poids-sans); font-size: var(--ui-size); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
.num { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-nombres); }
.serif { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-serif); }

/* App frame: the real ZenRayProgress sidebar is kept, reduced to its essentials */
.app { display: grid; grid-template-columns: var(--rail-w) 1fr; min-height: 100vh; }
.rail { padding: 26px 18px; border-right: 1px solid var(--line); position: sticky; top: 0; height: 100vh; }
.rail .brand { font-family: var(--zr-police-serif); font-size: 21px; margin: 0 8px 26px; }
.rail .brand i { color: var(--ink-3); }
.rail a { display: block; padding: 7px 10px; border-radius: 8px; color: var(--ink-2); text-decoration: none; }
.rail a.on { color: var(--ink); background: var(--accent-soft); }
.rail .sep { height: 1px; background: var(--line); margin: 14px 8px; }
main { padding: calc(var(--page-pad) + 44px) var(--page-pad) var(--page-pad); min-width: 0; }

/* Proposal switcher */
.switch { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; gap: 4px; padding: 4px; border-radius: 99px; background: var(--surface); backdrop-filter: blur(var(--bg-blur)); -webkit-backdrop-filter: blur(var(--bg-blur)); box-shadow: 0 6px 24px rgb(0 0 0 / .12); }
.switch button { padding: 7px 14px; border-radius: 99px; color: var(--ink-2); }
.switch button.on { background: var(--ink); color: var(--bg); }

/* Shared: search, chips */
.search { display: flex; align-items: center; gap: 10px; height: 44px; padding: 0 16px; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); }
.search input { flex: 1; border: 0; background: none; outline: none; font: inherit; color: var(--ink); }
.chips { display: flex; gap: 8px; flex-wrap: wrap; }
.chip { padding: 7px 14px; border-radius: 99px; background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); }
.chip.on { background: var(--ink); color: var(--bg); border-color: transparent; }

/* Shared: thumbnail. The SHAPE carries the type, so no type label is ever written */
.thumb { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--line); aspect-ratio: var(--cover-ratio); transition: transform var(--fade), box-shadow var(--fade); }
.tile:hover .thumb { transform: translateY(calc(var(--lift) * -1)); box-shadow: 0 14px 30px -14px rgb(0 0 0 / .35); }
.thumb .art { position: absolute; inset: 0; opacity: 0; transition: opacity var(--fade); }
.thumb.ready .art { opacity: 1; }
.thumb .badge { position: absolute; right: 8px; bottom: 8px; padding: 2px 7px; border-radius: 6px; background: rgb(0 0 0 / .72); color: #fff; font-size: 11.5px; }
.thumb .dot { position: absolute; left: 9px; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px rgb(255 255 255 / .8); }
.thumb .glyph { position: absolute; inset: 0; display: grid; place-items: center; color: rgb(255 255 255 / .9); }
.thumb.k-doc { aspect-ratio: .78; }
.thumb.k-audio { border-radius: 50%; aspect-ratio: 1; }
.thumb.k-image { aspect-ratio: 1; }
.thumb.k-3d { aspect-ratio: 1; }
/* Apple-style spinner shown while a thumbnail loads: an empty box is a design error */
.spin { position: absolute; left: 50%; top: 50%; width: var(--spinner); height: var(--spinner); transform: translate(-50%, -50%); opacity: 1; transition: opacity var(--fade); }
.thumb.ready .spin { opacity: 0; }
.spin i { position: absolute; left: 46%; top: 0; width: 8%; height: 28%; border-radius: 2px; background: var(--ink-2); transform-origin: 50% 178%; animation: spinfade 1s linear infinite; }
@keyframes spinfade { from { opacity: 1 } to { opacity: .15 } }
.tile { cursor: pointer; min-width: 0; }
.t-title { margin-top: 10px; font-size: var(--title-size); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.t-meta { margin-top: 3px; font-size: var(--meta-size); color: var(--ink-2); }

/* A: TUBE (YouTube logic) */
.tube-top { display: flex; gap: 16px; align-items: center; margin: 40px 0 18px; }
.tube-top .search { flex: 1; max-width: 640px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--card-min), 1fr)); gap: calc(var(--gap) * 1.4) var(--gap); margin-top: 22px; }
.files-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(calc(var(--card-min) * .62), 1fr)); gap: var(--gap); margin-top: 22px; align-items: end; }
.back { color: var(--ink-2); display: inline-flex; gap: 6px; align-items: center; margin-bottom: 14px; }
.p-head { display: flex; gap: 28px; align-items: flex-end; }
.p-head h1 { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-serif); font-size: var(--hero-size); letter-spacing: -.01em; line-height: 1.05; }
.p-head .thumb { width: 300px; flex: none; }

/* B: GALLERY (Apple Photos logic) */
.gal-hero { margin: 46px 0 22px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.gal-hero h1 { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-serif); font-size: var(--hero-size); }
.albums { display: grid; grid-auto-flow: column; grid-auto-columns: calc(var(--card-min) * 1.15); gap: var(--gap); overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x mandatory; }
.albums .tile { scroll-snap-align: start; }
.albums .thumb { aspect-ratio: 1; }
.mosaic { display: flex; flex-wrap: wrap; gap: calc(var(--gap) * .25); margin-top: 26px; }
.mosaic .tile { --h: calc(var(--card-min) * .62); height: var(--h); flex: var(--w) 1 calc(var(--h) * var(--w)); }
.mosaic .thumb { height: 100%; aspect-ratio: auto; border-radius: calc(var(--radius) * .4); }
.mosaic .thumb.k-audio { border-radius: calc(var(--radius) * .4); }
.mosaic .hovername { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 10px 8px; color: #fff; font-size: var(--meta-size); background: linear-gradient(transparent, rgb(0 0 0 / .6)); opacity: 0; transition: opacity var(--fade); }
.mosaic .tile:hover .hovername { opacity: 1; }
.section-t { margin-top: 34px; font-size: 15px; color: var(--ink-2); }

/* C: SHELVES (Spotlight + App Store logic) */
.spot { max-width: 760px; margin: 70px auto 10px; text-align: center; }
.spot .search { height: 58px; font-size: 17px; box-shadow: 0 18px 50px -24px rgb(0 0 0 / .3); }
.spot p { margin-top: 12px; color: var(--ink-3); font-size: var(--meta-size); }
.shelf { margin-top: 36px; }
.shelf h2 { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-serif); font-size: 22px; margin-bottom: 14px; }
.row { display: grid; grid-auto-flow: column; grid-auto-columns: var(--card-min); gap: var(--gap); overflow-x: auto; padding: 4px 2px 10px; align-items: start; }
.row .thumb.k-doc, .row .thumb.k-audio, .row .thumb.k-image, .row .thumb.k-3d { width: 72%; margin: 0 auto; }
.row.big { grid-auto-columns: calc(var(--card-min) * 1.6); }
.stage { display: grid; grid-template-columns: 1fr 300px; gap: var(--gap); margin-top: 8px; }
.stage .big .thumb { aspect-ratio: 16 / 10; border-radius: calc(var(--radius) * 1.4); }
.strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; align-content: start; max-height: 70vh; overflow: auto; }
.strip .tile .thumb { border-radius: calc(var(--radius) * .6); }
.strip .tile.sel .thumb { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Parameter panel (workshop tool, never shipped) */
.panel { position: fixed; right: 14px; bottom: 14px; width: 300px; max-height: calc(100vh - 28px); overflow: auto; z-index: 60; padding: 14px; border-radius: 16px; background: var(--surface); backdrop-filter: blur(var(--bg-blur)); -webkit-backdrop-filter: blur(var(--bg-blur)); box-shadow: 0 20px 60px -20px rgb(0 0 0 / .35); font-size: 12px; }
.panel.closed .body { display: none; }
.panel header { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.panel h3 { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin: 14px 0 6px; font-weight: 400; }
.panel label { display: grid; grid-template-columns: 1fr 64px; gap: 2px 8px; margin: 6px 0; color: var(--ink-2); }
.panel input[type=range] { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
.panel output { text-align: right; color: var(--ink); }
.panel .btns { display: flex; gap: 6px; margin-top: 12px; flex-wrap: wrap; }
.panel .btns button { flex: 1; padding: 8px; border-radius: 9px; background: var(--ink); color: var(--bg); }
.panel .btns button.ghost { background: var(--line); color: var(--ink); }

@media (max-width: 820px) {
  .app { grid-template-columns: 1fr; } .rail { display: none; }
  :root { --page-pad: 16px; }
  .stage { grid-template-columns: 1fr; } .p-head { flex-direction: column; align-items: flex-start; } .p-head .thumb { width: 100%; }
  .panel { width: calc(100% - 28px); }
}
</style>
</head>
<body>
<div class="switch" id="switch"></div>
<div class="app">
  <nav class="rail">
    <div class="brand">ZenRay <i>Progress</i></div>
    <a>Create</a><a>Progress</a><a class="on">Assets</a><a>Plan</a><a>Media</a>
    <div class="sep"></div><a>Houdini</a><a>Skills</a><a>Freelance</a>
  </nav>
  <main id="main"></main>
</div>
<aside class="panel" id="panel"></aside>

<script>
// 12 October 2026: definition = render functions, interface = PARAMS + DATA, instances = the three proposals.
// FR : définition = fonctions de rendu, interface = PARAMS + DATA, instances = les trois propositions.

// PARAMETER INTERFACE: at most 8 per category, priority first, defaults equal the delivered result.
const PARAMS = {
  Layout: [
    ['--card-min', 'Largeur des cartes', 160, 420, 1, 'px'],
    ['--gap', 'Espacement', 6, 48, 1, 'px'],
    ['--radius', 'Arrondi', 0, 32, 1, 'px'],
    ['--cover-ratio', 'Format des couvertures', 1, 2.4, 0.01, ''],
    ['--page-pad', 'Marge de page', 12, 80, 1, 'px'],
    ['--rail-w', 'Largeur du menu', 160, 300, 1, 'px'],
  ],
  Type: [
    ['--title-size', 'Titre des cartes', 11, 20, 0.5, 'px'],
    ['--meta-size', 'Ligne d’information', 10, 16, 0.5, 'px'],
    ['--hero-size', 'Grand titre', 24, 72, 1, 'px'],
    ['--ui-size', 'Interface', 11, 17, 0.5, 'px'],
  ],
  Motion: [
    ['--latency', 'Latence simulée', 0, 2000, 10, ''],
    ['--fade', 'Fondu d’apparition', 0, 800, 10, 'ms'],
    ['--lift', 'Soulèvement au survol', 0, 10, 0.5, 'px'],
    ['--spinner', 'Taille du chargeur', 12, 40, 1, 'px'],
  ],
  Colour: [
    ['--accent-h', 'Teinte d’accent', 0, 360, 1, ''],
    ['--accent-s', 'Saturation d’accent', 0, 100, 1, '%'],
    ['--glass', 'Opacité du verre', 0.3, 1, 0.01, ''],
    ['--bg-blur', 'Flou du verre', 0, 60, 1, 'px'],
  ],
}

// Mock data taken from the real Memory1/Projects list. Replace with the registry in the real build.
const KINDS = ['image', 'video', '3d', 'audio', 'doc']
const PROJECTS = [
  ['Roof Tiles, Copernicus to Unreal Short', '3D', 54, '24 Sep', 18],
  ['Copernicus Shorts Style V4', 'Social', 169, '9 Oct', 222],
  ['Louisiana Bayou', '3D', 412, '10 Oct', 140],
  ['Ceramic Tiles', 'Materials', 88, '1 Oct', 160],
  ['Japanese Environment', '3D', 236, '28 Sep', 340],
  ['Vegetation Assets Collection 01', '3D', 131, '3 Oct', 110],
  ['Control Brutalist Fountain', 'Unreal', 47, '22 Sep', 210],
  ['SFX audio collection', 'Audio', 379, '18 Sep', 265],
  ['ZenRay Motion Design 01', 'Motion', 64, '12 Oct', 300],
  ['Poisson Gloss, Poterie Aix', 'Photo', 72, '8 Oct', 30],
  ['ZenRay Height', 'Houdini', 39, '11 Oct', 40],
  ['ZenRay Shards Core', 'Game', 205, '6 Oct', 250],
].map(([name, cat, count, date, hue], i) => ({ id: i, name, cat, count, date, hue, unsynced: i % 5 === 2 }))

function rng(seed) { return () => (seed = (seed * 9301 + 49297) % 233280) / 233280 }
function filesOf(p) {
  const r = rng(p.id * 97 + 7), out = []
  const names = { image: ['height_v', 'basecolor_v', 'sheet_', 'ref_'], video: ['turntable_v', 'short_v', 'screen_rec_'], '3d': ['mesh_', 'tiles_hda_', 'scene_v'], audio: ['sfx_', 'ambience_'], doc: ['FEEDBACK', 'notes_', 'plan_'] }
  for (let i = 0; i < Math.min(p.count, 30); i++) {
    const k = p.cat === 'Audio' ? (r() < .8 ? 'audio' : 'doc') : KINDS[Math.floor(r() * r() * 5)]
    const n = names[k][Math.floor(r() * names[k].length)]
    out.push({ id: `${p.id}-${i}`, kind: k, name: `${n}${String(i + 1).padStart(3, '0')}`, hue: (p.hue + r() * 60 - 30 + 360) % 360, dur: `${Math.floor(r() * 3)}:${String(Math.floor(r() * 60)).padStart(2, '0')}`, w: .7 + r() * 1.1, unsynced: r() < .08 })
  }
  return out
}
const ALL_FILES = PROJECTS.flatMap(p => filesOf(p).slice(0, 6).map(f => ({ ...f, project: p })))

// Procedural art standing in for real thumbnails.
function art(hue, kind, seed) {
  const g = `linear-gradient(135deg, hsl(${hue} 45% 62%), hsl(${(hue + 40) % 360} 40% 32%))`
  if (kind === 'audio') return `<div class="art" style="background:${g}"><svg class="glyph" viewBox="0 0 100 100" width="100%" height="100%">${Array.from({ length: 13 }, (_, i) => { const h = 12 + ((seed * (i + 3)) % 40); return `<rect x="${17 + i * 5.2}" y="${50 - h / 2}" width="2.6" height="${h}" rx="1.3" fill="white" opacity=".85"/>` }).join('')}</svg></div>`
  if (kind === 'doc') return `<div class="art" style="background:hsl(${hue} 20% 96%)"><svg class="glyph" viewBox="0 0 100 128" width="100%" height="100%">${Array.from({ length: 9 }, (_, i) => `<rect x="14" y="${22 + i * 10}" width="${44 + ((seed + i * 7) % 28)}" height="3" rx="1.5" fill="hsl(${hue} 15% 70%)"/>`).join('')}</svg></div>`
  if (kind === '3d') return `<div class="art" style="background:radial-gradient(circle at 50% 40%, hsl(${hue} 30% 70%), hsl(${hue} 25% 22%))"><svg class="glyph" viewBox="0 0 100 100" width="46%"><path d="M50 18 80 34v32L50 82 20 66V34z M50 50 80 34 M50 50v32 M50 50 20 34" fill="none" stroke="white" stroke-width="2.4" stroke-linejoin="round" opacity=".9"/></svg></div>`
  return `<div class="art" style="background:${g}; background-image: repeating-linear-gradient(${seed % 180}deg, rgb(255 255 255 / .07) 0 6px, transparent 6px 14px), ${g}"></div>`
}
const spinner = `<div class="spin">${Array.from({ length: 12 }, (_, i) => `<i style="transform:rotate(${i * 30}deg);animation-delay:${(i - 12) / 12}s"></i>`).join('')}</div>`
function thumb(o, kind, extra = '') {
  const k = kind || 'cover'
  const badge = k === 'video' ? `<span class="badge num">${o.dur}</span>` : ''
  return `<div class="thumb k-${k}" data-load>${art(o.hue, k === 'cover' ? 'image' : k, o.id.toString().length * 13 + (o.hue | 0))}${spinner}${badge}${o.unsynced ? '<span class="dot" title="Pas encore dans le cloud"></span>' : ''}${extra}</div>`
}
// A project card: thumbnail + title + one line. Nothing else.
const projectCard = p => `<div class="tile" data-project="${p.id}">${thumb(p, 'cover')}<div class="t-title">${p.name}</div><div class="t-meta"><span class="num">${p.count}</span> · <span class="num">${p.date}</span></div></div>`
// A file card: the shape says the type, the title says the rest.
const fileCard = (f, withMeta) => `<div class="tile" data-file="${f.id}">${thumb(f, f.kind)}<div class="t-title">${f.name}</div>${withMeta && f.project ? `<div class="t-meta">${f.project.name}</div>` : ''}</div>`

const CHIPS = [['all', 'Tout'], ['image', 'Images'], ['video', 'Vidéos'], ['3d', '3D'], ['audio', 'Audio'], ['doc', 'Docs']]
const state = { design: 'tube', project: null, kind: 'all', q: '', sel: 0 }
const chips = () => `<div class="chips">${CHIPS.map(([k, l]) => `<button class="chip ${state.kind === k ? 'on' : ''}" data-kind="${k}">${l}</button>`).join('')}</div>`
const searchBox = ph => `<label class="search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="q" placeholder="${ph}" value="${state.q}"></label>`
const match = s => s.toLowerCase().includes(state.q.toLowerCase())
const byKind = fs => fs.filter(f => (state.kind === 'all' || f.kind === state.kind) && match(f.name))

const DESIGNS = {
  tube: {
    label: 'A · Tube',
    home: () => `<div class="tube-top">${searchBox('Rechercher un projet ou un fichier')}</div>${chips()}
      <div class="grid">${PROJECTS.filter(p => match(p.name) && (state.kind === 'all' || filesOf(p).some(f => f.kind === state.kind))).map(projectCard).join('')}</div>`,
    project: p => `<button class="back" data-home>‹ Projets</button><div class="p-head">${thumb(p, 'cover')}<div><h1>${p.name}</h1><div class="t-meta" style="margin-top:10px"><span class="num">${p.count}</span> fichiers · <span class="num">${p.date}</span></div></div></div>
      <div style="margin-top:28px">${chips()}</div><div class="files-grid">${byKind(filesOf(p)).map(f => fileCard(f)).join('')}</div>`,
  },
  gallery: {
    label: 'B · Galerie',
    home: () => `<div class="gal-hero"><h1>Assets</h1><div style="width:min(420px,50vw)">${searchBox('Rechercher')}</div></div>
      <div class="albums">${PROJECTS.filter(p => match(p.name)).map(projectCard).join('')}</div>
      <div class="section-t">Récents</div><div class="mosaic">${byKind(ALL_FILES).map(f => mosaicTile(f)).join('')}</div>`,
    project: p => `<button class="back" data-home>‹ Assets</button><div class="gal-hero" style="margin-top:6px"><h1>${p.name}</h1>${chips()}</div>
      <div class="mosaic">${byKind(filesOf(p)).map(f => mosaicTile(f)).join('')}</div>`,
  },
  shelves: {
    label: 'C · Étagères',
    home: () => {
      const q = state.q.trim()
      if (q) return `<div class="spot">${searchBox('Que cherches-tu ?')}</div><div class="shelf"><h2>Résultats</h2><div class="files-grid">${ALL_FILES.filter(f => match(f.name) || match(f.project.name)).map(f => fileCard(f, true)).join('')}</div></div>`
      const cats = [...new Set(PROJECTS.map(p => p.cat))].slice(0, 4)
      return `<div class="spot">${searchBox('Que cherches-tu ?')}<p>Projets, fichiers, couleurs, types</p></div>
        <div class="shelf"><h2>Reprendre</h2><div class="row big">${PROJECTS.slice(0, 5).map(projectCard).join('')}</div></div>
        ${cats.map(c => `<div class="shelf"><h2>${c}</h2><div class="row">${ALL_FILES.filter(f => f.project.cat === c).map(f => fileCard(f, true)).join('')}</div></div>`).join('')}`
    },
    project: p => {
      const fs = byKind(filesOf(p)), cur = fs[state.sel] || fs[0]
      return `<button class="back" data-home>‹ Étagères</button><div class="p-head" style="margin-bottom:18px"><div><h1>${p.name}</h1></div></div>${chips()}
      <div class="stage" style="margin-top:18px"><div class="big">${cur ? fileCard(cur) : ''}</div><div class="strip">${fs.map((f, i) => `<div class="tile ${i === state.sel ? 'sel' : ''}" data-sel="${i}">${thumb(f, f.kind)}</div>`).join('')}</div></div>`
    },
  },
}
function mosaicTile(f) { return `<div class="tile" data-file="${f.id}" style="--w:${f.kind === 'video' ? 1.78 : f.kind === 'doc' ? .78 : f.kind === 'audio' ? 1 : f.w.toFixed(2)}">${thumb(f, f.kind, `<div class="hovername">${f.name}</div>`)}</div>` }

// Render + simulated parallel loading: each thumbnail resolves independently, spinner until then.
function render() {
  const d = DESIGNS[state.design], p = state.project != null ? PROJECTS[state.project] : null
  document.getElementById('main').innerHTML = p ? d.project(p) : d.home()
  const lat = +getComputedStyle(document.documentElement).getPropertyValue('--latency')
  document.querySelectorAll('[data-load]').forEach((el, i) => setTimeout(() => el.classList.add('ready'), lat * (.4 + Math.random() * .6) + i * 4))
  const q = document.getElementById('q'); if (q && document.activeElement !== q && state.q) { q.focus(); q.setSelectionRange(q.value.length, q.value.length) }
}
document.getElementById('switch').innerHTML = Object.entries(DESIGNS).map(([k, d]) => `<button data-design="${k}">${d.label}</button>`).join('')
function syncSwitch() { document.querySelectorAll('[data-design]').forEach(b => b.classList.toggle('on', b.dataset.design === state.design)) }
document.addEventListener('click', e => {
  const t = e.target.closest('[data-design],[data-project],[data-home],[data-kind],[data-sel]'); if (!t) return
  if (t.dataset.design) { state.design = t.dataset.design; state.project = null; state.sel = 0; syncSwitch() }
  else if (t.dataset.project) { state.project = +t.dataset.project; state.kind = 'all'; state.sel = 0; scrollTo(0, 0) }
  else if ('home' in t.dataset) state.project = null
  else if (t.dataset.kind) { state.kind = t.dataset.kind; state.sel = 0 }
  else if (t.dataset.sel) state.sel = +t.dataset.sel
  render()
})
document.addEventListener('input', e => { if (e.target.id === 'q') { state.q = e.target.value; render() } })

// Panel: sliders write ONLY :root variables, plus a copy button for the prompt.
const root = document.documentElement
const DEFAULTS = {}
function buildPanel() {
  const css = getComputedStyle(root)
  let html = `<header><strong>Paramètres</strong><span><button class="ghost" id="theme" style="padding:4px 8px">◐</button><button id="fold" style="padding:4px 8px">–</button></span></header><div class="body">`
  for (const [cat, list] of Object.entries(PARAMS)) {
    html += `<h3>${cat}</h3>`
    for (const [v, label, min, max, step, unit] of list) {
      const val = parseFloat(css.getPropertyValue(v)); DEFAULTS[v] = val
      html += `<label>${label}<output id="o${v}">${val}${unit}</output><input type="range" min="${min}" max="${max}" step="${step}" value="${val}" data-var="${v}" data-unit="${unit}"></label>`
    }
  }
  html += `<div class="btns"><button id="copy">Copier les valeurs pour le prompt</button><button class="ghost" id="reset">Revenir aux défauts</button></div></div>`
  document.getElementById('panel').innerHTML = html
}
buildPanel()
if (innerWidth < 1100) document.getElementById('panel').classList.add('closed')
document.getElementById('panel').addEventListener('input', e => {
  const s = e.target.closest('[data-var]'); if (!s) return
  root.style.setProperty(s.dataset.var, s.value + s.dataset.unit)
  document.getElementById('o' + s.dataset.var).textContent = s.value + s.dataset.unit
  if (s.dataset.var === '--latency') render()
})
document.getElementById('panel').addEventListener('click', e => {
  if (e.target.id === 'fold') document.getElementById('panel').classList.toggle('closed')
  if (e.target.id === 'theme') root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark'
  if (e.target.id === 'reset') { root.removeAttribute('style'); buildPanel(); render() }
  if (e.target.id === 'copy') {
    const vals = [...document.querySelectorAll('[data-var]')].map(s => `${s.dataset.var}: ${s.value}${s.dataset.unit}`).join('; ')
    navigator.clipboard?.writeText(`Design ${DESIGNS[state.design].label} retenu, :root { ${vals} }`)
    e.target.textContent = 'Copié'; setTimeout(() => e.target.textContent = 'Copier les valeurs pour le prompt', 1200)
  }
})
syncSwitch(); render()
</script>
</body>
</html>
