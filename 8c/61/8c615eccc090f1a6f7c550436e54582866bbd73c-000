<!doctype html><html lang="fr"><meta charset="utf-8"><title>Adobe Clean sur ZenRay Progress, mockup</title>
<style>
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:300 450}
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:500 900}
@font-face{font-family:'GT Ultra';src:url(data:font/woff2;base64,) format('woff2')}
@font-face{font-family:'Literata';src:url(data:font/woff2;base64,) format('woff2');font-weight:200 900}
:root{--f-ui:'Adobe Clean';--f-title:'GT Ultra';--f-num:'GT Ultra';--f-old:'GT Ultra';--ui-size:15px;--sb-sub-size:15px;--sb-title-size:17px;--ui-weight:400;
--bg:#f5f4ef;--fg:#1f1f1e;--mut:#77756d;--card:#fff;--line:#e3e1d8}
body.dark{--bg:#1b1b1a;--fg:#ecebe5;--mut:#9a988f;--card:#262624;--line:#363633}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:400 15px/1.4 'Adobe Clean';padding:24px;transition:background .2s,color .2s}
h1{font:400 28px 'GT Ultra';margin:0 0 4px}.sub{color:var(--mut);margin:0 0 18px}
.panel{display:flex;flex-wrap:wrap;gap:18px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin-bottom:18px;font-size:13px}
.panel label{display:flex;gap:8px;align-items:center}.panel button,.tabs button{font:inherit;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:8px;padding:5px 12px;cursor:pointer}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}.tabs button.on{background:var(--fg);color:var(--bg)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:18px}@media(max-width:1100px){.cols{grid-template-columns:1fr}}
.col>h2{font:500 13px 'Adobe Clean';color:var(--mut);text-transform:uppercase;letter-spacing:.06em;margin:0 0 8px}
.app{display:flex;height:520px;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--bg)}
.sb{width:210px;padding:16px 12px;border-right:1px solid var(--line);background:var(--card);overflow:hidden}
.sb h3{margin:0 0 4px;font-weight:400;letter-spacing:-.01em;font-size:var(--sb-title-size)}
.sb div.it{height:32px;display:flex;align-items:center;padding:0 10px;border-radius:8px;font-size:var(--sb-sub-size);letter-spacing:-.015em}
.sb div.it.on{background:var(--bg)}.sb .zone{margin-bottom:26px}
.main{flex:1;padding:22px 26px;overflow:hidden}
.main h2.t{margin:0 0 12px;font-weight:400;font-size:26px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px}
.card b{font-weight:500}.mut{color:var(--mut);font-size:13px}.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.pill{border:1px solid var(--line);border-radius:99px;padding:2px 10px;font-size:12px}
.bar{height:8px;border-radius:9px;background:var(--line);overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;background:var(--fg)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.tile{aspect-ratio:4/3;background:var(--line);border-radius:10px;display:flex;align-items:end;padding:8px;font-size:13px}
/* AVANT = tout GT Ultra */
.old,.old *{font-family:'GT Ultra' !important}
/* APRÈS : rôles */
.new .ui{font-family:var(--f-ui);font-weight:var(--ui-weight)}
.new .sb h3,.new .t,.new .ttl{font-family:var(--f-title) !important}
.new .num{font-family:var(--f-num) !important}
.new .sb .it,.new .main,.new .card,.new .pill,.new .mut,.new .tile{font-family:var(--f-ui)}
.new .main h2.t{font-family:var(--f-title)}
.new .num,.old .num{font-variant-numeric:normal}
.leg{margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;font-size:13px}
.leg div{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px}.leg b{display:block;font-size:12px;color:var(--mut);margin-bottom:4px;font-weight:500}
</style>
<h1>Adobe Clean sur ZenRay Progress</h1>
<p class="sub">Avant : tout en GT Ultra. Après : Adobe Clean quasi partout, GT Ultra gardé pour les titres, les nombres et les titres de section de la sidebar. 5 November 2026.</p>
<div class="panel">
<label>Police interface <select id="fui"><option>Adobe Clean</option><option>GT Ultra</option><option>Inter</option></select></label>
<label>Taille UI <input type="range" min="13" max="18" value="15" id="sz"><span id="szv">15</span> px</label>
<label>Graisse <input type="range" min="300" max="500" step="50" value="400" id="wt"><span id="wtv">400</span></label>
<label>Titre sidebar <input type="range" min="14" max="22" value="17" id="stt"><span id="sttv">17</span> px</label>
<button id="dk">Clair / sombre</button>
<button id="cp">Copier les valeurs</button>
</div>
<div class="tabs" id="tabs"></div>
<div class="cols">
<div class="col"><h2>Avant</h2><div class="app old" id="a-old"></div></div>
<div class="col"><h2>Après</h2><div class="app new" id="a-new"></div></div>
</div>
<div class="leg">
<div><b>Adobe Clean 400</b>sidebar sous-sections, boutons, labels, paragraphes, champs, tableaux, pastilles.</div>
<div><b>GT Ultra 400</b>titres de page, titres de section sidebar, tous les nombres (dates, heures, montants, compteurs).</div>
<div><b>Inchangés</b>Literata pour le corps éditorial, AnthropicMono pour le code.</div>
<div><b>Paramètres existants</b>--zr-police-sans, --sb-ui-font, --sb-title-font, --zr-police-gallery-title dans fonts.css.</div>
</div>
<script>
const S={
Plan:{t:'Plan',zone:0,body:`<div class="card"><div class="row"><b>Production du matin</b><span class="pill"><span class="num">9:00</span> à <span class="num">12:00</span></span></div><div class="mut">Prospecter puis produire</div></div><div class="card"><div class="row"><b>Japonais</b><span class="pill"><span class="num">1 h 15</span></span></div><div class="mut">Drill et conversation</div></div><div class="card"><div class="row"><b>Sport</b><span class="pill"><span class="num">17:00</span></span></div><div class="bar"><i style="width:60%"></i></div></div>`},
Freelance:{t:'Freelance',zone:1,body:`<div class="card"><div class="row"><b>Studio candidatures du jour</b><span class="num" style="font-size:22px">12 / 50</span></div><div class="bar"><i style="width:24%"></i></div></div><div class="card"><div class="row"><b>Eidos-Montréal</b><span class="pill">Contacté</span></div><div class="mut">VFX Artist · <span class="num">4 November 2026</span></div></div><div class="card"><div class="row"><b>Sunblink</b><span class="pill">À envoyer</span></div><div class="mut">Environment Gameplay Designer</div></div>`},
'Créer':{t:'Créer',zone:2,body:`<div class="grid"><div class="tile">Films</div><div class="tile">Photos</div><div class="tile">Audio</div><div class="tile">Séries</div><div class="tile">Archives</div><div class="tile">Notes</div></div>`},
Progression:{t:'Progression',zone:3,body:`<div class="card"><div class="row"><b>Objectif du mois</b><span class="num" style="font-size:22px">10 000 €</span></div><div class="bar"><i style="width:35%"></i></div><div class="mut">Atteint : <span class="num">3 500 €</span></div></div><div class="card"><b>Japonais</b><div class="mut">Leçon <span class="num">106</span> acquise, drill du jour terminé</div></div>`},
Assets:{t:'Assets',zone:4,body:`<div class="card"><div class="row"><b>zenray-edit</b><span class="pill">archivé</span></div><div class="mut"><span class="num">62</span> designs · mis à jour <span class="num">5 November 2026</span></div></div><div class="card"><div class="row"><b>zenray-progress</b><span class="pill">publié</span></div><div class="mut">Synthèse HTML à jour</div></div>`},
'Abonnement Max':{t:'Abonnement Max',zone:5,body:`<div class="card"><div class="row"><b>Quota de la semaine</b><span class="num" style="font-size:22px">68 %</span></div><div class="bar"><i style="width:68%"></i></div><div class="mut">Renouvellement le <span class="num">9 November</span></div></div>`},
Sport:{t:'Sport',zone:6,body:`<div class="card"><div class="row"><b>Pompes</b><span class="num">4 × 20</span></div><div class="mut">Séance du <span class="num">5 November 2026</span></div></div><div class="card"><div class="row"><b>Série</b><span class="num" style="font-size:22px">19 jours</span></div><div class="mut">Régularité avant intensité</div></div>`},
Notes:{t:'Notes',zone:7,body:`<div class="card"><b>Idées de la semaine</b><div class="mut">Écrire le prochain post, relire la lettre pour Sunblink.</div></div><div class="card"><b>Japon</b><div class="mut">Carte de restaurant, phrases à drill.</div></div>`}};
const zones=[['Create',['Plan','Freelance','Créer','Progression','Assets','Abonnement Max','Sport','Notes']],['Learn',['Japanese']],['Système',['Archives','Drive','Index']]];
let cur='Plan';
function app(el){el.innerHTML='';const sb=document.createElement('div');sb.className='sb';
zones.forEach(([z,items])=>{const d=document.createElement('div');d.className='zone';d.innerHTML='<h3>'+z+'</h3>'+items.map(i=>'<div class="it'+(i===cur?' on':'')+'">'+i+'</div>').join('');sb.appendChild(d)});
const m=document.createElement('div');m.className='main';const s=S[cur];m.innerHTML='<h2 class="t">'+s.t+'</h2>'+s.body;el.append(sb,m)}
function render(){app(document.getElementById('a-old'));app(document.getElementById('a-new'))}
const tabs=document.getElementById('tabs');Object.keys(S).forEach(k=>{const b=document.createElement('button');b.textContent=k;b.onclick=()=>{cur=k;[...tabs.children].forEach(c=>c.classList.toggle('on',c===b));render()};if(k===cur)b.className='on';tabs.appendChild(b)});
const r=document.documentElement.style;
fui.onchange=()=>{r.setProperty('--f-ui',"'"+fui.value+"'")};
sz.oninput=()=>{r.setProperty('--ui-size',sz.value+'px');r.setProperty('--sb-sub-size',sz.value+'px');szv.textContent=sz.value;document.querySelectorAll('.new .main').forEach(e=>e.style.fontSize=sz.value+'px')};
wt.oninput=()=>{r.setProperty('--ui-weight',wt.value);wtv.textContent=wt.value;document.querySelectorAll('.new .sb .it,.new .main').forEach(e=>e.style.fontWeight=wt.value)};
stt.oninput=()=>{r.setProperty('--sb-title-size',stt.value+'px');sttv.textContent=stt.value};
dk.onclick=()=>document.body.classList.toggle('dark');
cp.onclick=()=>{const t=`--zr-police-sans: '${fui.value}'; --sb-ui-font: '${fui.value}'; --sb-ui-size: ${sz.value}px; --sb-ui-weight: ${wt.value}; --sb-title-size: ${stt.value}px; titres, nombres et titres de section: GT Ultra`;navigator.clipboard.writeText(t).then(()=>cp.textContent='Copié').catch(()=>prompt('Valeurs',t))};
render();
</script></html>