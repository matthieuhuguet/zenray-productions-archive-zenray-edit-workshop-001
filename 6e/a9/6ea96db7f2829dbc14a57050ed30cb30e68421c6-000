    gap: 6px;
    flex-wrap: wrap;
  }

  .f-badge {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    color: rgba(235, 235, 245, 0.72);
  }

  /* Fenêtre ZenRayProgress simulée */
  .zrp-window {
    display: grid;
    grid-template-columns: 188px 1fr;
