    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(50, 215, 75, 0.12);
    border: 1px solid rgba(50, 215, 75, 0.28);
    color: #7EE28E;
    font-size: 11.5px;
  }

  .cloud-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #32D74B;
  }

  .hda-controls-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .ctrl-col {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ctrl-label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: rgba(235, 235, 245, 0.62);
  }

  .ctrl-val {
