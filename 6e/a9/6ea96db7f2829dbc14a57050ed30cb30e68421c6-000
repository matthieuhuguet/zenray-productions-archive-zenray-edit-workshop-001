          <th>Catégorie</th>
          <th>Apple Books (Livres)</th>
          <th>Google Play Livres</th>
          <th>Intégration ZenRay Books (<span class="code-path">zenray-progress</span>)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>1. Cloud & Architecture Create/Books</strong></td>
          <td>Bibliothèque iCloud Drive synchronisée, collections, états (En cours, À lire, Terminé), import PDF/EPUB par glisser-déposer.</td>
          <td>Upload cloud personnel (<span class="num">1000</span>+ fichiers EPUB/PDF jusqu'à <span class="num">100</span> Mo), reprise exacte de la page sur web et mobile.</td>
          <td>Tous les livres vivent dans <span class="code-path">Create &gt; Books</span> (<span class="code-path">zenray-data:pages/Books/</span>, <span class="num">5</span> livres déjà en ligne dont <em>The Win Without Pitching Manifesto</em>) et s'affichent directement dans l'app <strong>Books</strong> de la barre latérale gauche.</td>
        </tr>
        <tr>
          <td><strong>2. Typographie & Mise en page</strong></td>
          <td>Menu <span class="code-path">Aa</span> : choix de police, taille du corps, texte gras, espacement des lignes, espacement des mots/caractères, justification forcée, marges.</td>
          <td>Police (Literata, Sans, Serif), taille du corps, interlignage (<span class="num">3</span> paliers + curseur), alignement justifié ou gauche, zoom page scannée.</td>
          <td>Trio système (<span class="code-path">AnthropicSerif 350</span> pour le corps, <span class="code-path">AnthropicSerif 400</span> pour tous les nombres, <span class="code-path">InterVariable 400</span> pour l'UI) + curseurs HDA continus (corps, interlignage, largeur <span class="code-path">ch</span>, marges).</td>
        </tr>
        <tr>
          <td><strong>3. Thèmes & Confort Visuel</strong></td>
          <td>Thèmes <em>Original, Calme (Quiet), Papier, Audacieux, Sépia</em> ; bascule Nuit auto ; <strong>Guide de lecture (Line Guide)</strong> pour isoler la ligne lue.</td>
          <td>Thèmes Clair, Sépia, Sombre, Noir OLED ; <strong>Night Light (Éclairage nocturne ambré)</strong> progressif anti-lumière bleue ; luminosité dédiée.</td>
          <td><span class="num">5</span> thèmes (<em>Papier Ivoire, Sépia Chaud, Calme Quiet, Nuit Sombre, Noir OLED</em>) + curseur <strong>Night Light Ambre</strong> (<span class="num">0</span> à <span class="num">45%</span>) + <strong>Guide de ligne</strong> focalisé.</td>
        </tr>
        <tr>
          <td><strong>4. Modes de lecture & Navigation</strong></td>
          <td>Simple page, Double page (<span class="num">2</span> colonnes), Défilement vertical continu ; TOC hiérarchique ; grille de miniatures ; flèche retour après saut de lien.</td>
          <td>Mode pages fluides (Flowing text) ou Pages d'origine (Scanned pages PDF) ; barre de progression bas de page avec chapitre, % et pages restantes.</td>
          <td>Bascule instantanée <em>1 Page / Double Page / Scroll continu</em>, lecteur natif EPUB + PDF vectoriel/scanné, TOC + miniatures, et sauvegarde automatique dans <span class="code-path">pages/Books/.zrbooks-state.json</span>.</td>
        </tr>
        <tr>
          <td><strong>5. Annotations, Étude & Recherche</strong></td>
          <td>Surlignage <span class="num">5</span> couleurs + soulignement, notes attachées, <strong>Cartes d'étude (Study Cards / Flashcards)</strong>, recherche plein texte, partage de citation.</td>
          <td>Surlignage <span class="num">4</span> couleurs + notes avec <strong>synchronisation automatique vers un document Google Docs dédié</strong> par livre ; recherche plein texte.</td>
          <td>Surlignages <span class="num">5</span> couleurs + notes + <strong>Flashcards d'étude</strong> + export/sync automatique en Markdown vers <span class="code-path">Create/Notes</span> + recherche plein texte instantanée.</td>
        </tr>
        <tr>
          <td><strong>6. Dictionnaire, Traduction & Objectifs</strong></td>
          <td>Définir (dictionnaire), Traduire, Wikipédia, Lecture vocale, et <strong>Objectifs de lecture</strong> (minutes/jour + série quotidienne + livres/an).</td>
          <td>Dictionnaire hors-ligne/en-ligne au clic, Google Translate intégré, recherche Wikipédia/Web, et <strong>Read Aloud (TTS)</strong> avec suivi du mot lu.</td>
          <td>Bulle de sélection avec <strong>Dictionnaire + Traduction FR/EN/JP (furigana) + Wikipédia + Voix TTS</strong>, et compteur d'objectif quotidien (<span class="num">20</span> min/jour, série en jours).</td>
        </tr>
      </tbody>
    </table>
  </section>

<script>
  let currentDesign = 'A';
  let currentTheme = 'paper';
  let currentFont = 'serif';

  const THEMES = {
    paper: { bg: '#FAF7F0', el: '#F3EFE6', fg: '#1C1B18', muted: '#706D65', hair: 'rgba(28, 27, 24, 0.09)' },
    sepia: { bg: '#F4ECD8', el: '#EAE0C8', fg: '#2B241B', muted: '#7A6C58', hair: 'rgba(43, 36, 27, 0.11)' },
    quiet: { bg: '#3C3D42', el: '#333438', fg: '#E6E4DF', muted: '#A6A49E', hair: 'rgba(255, 255, 255, 0.10)' },
    night: { bg: '#18191C', el: '#202226', fg: '#E8E6E1', muted: '#8E8D88', hair: 'rgba(255, 255, 255, 0.09)' },
    oled:  { bg: '#050506', el: '#101113', fg: '#DFDDD7', muted: '#7C7B76', hair: 'rgba(255, 255, 255, 0.08)' }
  };

  function selectDesign(letter) {
    currentDesign = letter;
    document.getElementById('valDesign').textContent = letter;
    ['A', 'B', 'C'].forEach((k) => {
      document.getElementById('card' + k).classList.toggle('selected', k === letter);
      document.getElementById('btn' + k).classList.toggle('active', k === letter);
    });
  }

  function setVar(name, val, labelId) {
    document.documentElement.style.setProperty(name, val);
    if (labelId) document.getElementById(labelId).textContent = val;
  }

  function setAmber(val) {
    document.documentElement.style.setProperty('--night-light-amber', val);
    document.getElementById('valAmber').textContent = Math.round(Number(val) * 100) + '%';
  }

  function setTheme(key) {
    currentTheme = key;
    const t = THEMES[key];
    document.documentElement.style.setProperty('--paper-bg', t.bg);
    document.documentElement.style.setProperty('--paper-elevated', t.el);
    document.documentElement.style.setProperty('--paper-fg', t.fg);
    document.documentElement.style.setProperty('--paper-muted', t.muted);
    document.documentElement.style.setProperty('--paper-hairline', t.hair);
    ['Paper', 'Sepia', 'Quiet', 'Night', 'Oled'].forEach((id) => {
      document.getElementById('th' + id).classList.toggle('active', id.toLowerCase() === key);
    });
  }

  function setFont(key) {
    currentFont = key;
    const map = {
      serif: "'AnthropicSerif', 'Hiragino Mincho ProN W3', serif",
      sans: "'InterVariable', 'Hiragino Sans W4', sans-serif",
      georgia: "Georgia, 'Hiragino Mincho ProN W3', serif"
    };
    document.documentElement.style.setProperty('--book-font-family', map[key]);
    document.getElementById('fnSerif').classList.toggle('active', key === 'serif');
    document.getElementById('fnSans').classList.toggle('active', key === 'sans');
    document.getElementById('fnGeorgia').classList.toggle('active', key === 'georgia');
  }

  function copyChoice() {
    const cs = getComputedStyle(document.documentElement);
    const payload = [
      'Design Books choisi : ' + currentDesign,
      'theme=' + currentTheme,
      'font=' + currentFont,
      'fontSize=' + cs.getPropertyValue('--book-font-size').trim(),
      'lineHeight=' + cs.getPropertyValue('--book-line-height').trim(),
      'measure=' + cs.getPropertyValue('--book-measure').trim(),
      'pad=' + cs.getPropertyValue('--page-pad').trim(),
      'radius=' + cs.getPropertyValue('--ui-radius').trim(),
      'nightLight=' + document.getElementById('valAmber').textContent
    ].join(' | ');
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(payload);
    }
    const btn = document.getElementById('copyBtn');
    btn.textContent = 'Copié : ' + payload;
    setTimeout(() => { btn.textContent = 'Copier le choix + valeurs pour le prompt'; }, 2400);
  }
</script>
</body>
</html>
