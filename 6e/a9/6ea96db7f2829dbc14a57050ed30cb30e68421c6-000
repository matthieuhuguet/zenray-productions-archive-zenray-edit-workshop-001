  /* Barre HDA supérieure */
  .hda-header {
    max-width: 1480px;
    margin: 0 auto 20px;
    background: rgba(22, 23, 26, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hda-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hda-title-group {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hda-title {
    font-family: var(--zr-police-serif);
    font-weight: var(--zr-poids-serif);
    font-size: 21px;
    color: #F6F6F8;
