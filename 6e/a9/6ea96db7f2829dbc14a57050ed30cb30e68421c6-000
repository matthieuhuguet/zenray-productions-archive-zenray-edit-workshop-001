  .nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 7px;
    color: rgba(235, 235, 245, 0.58);
    font-size: 12px;
  }

  .nav-item.active {
    background: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
  }

  .nav-sub {
    margin-left: 14px;
    padding-left: 8px;
    border-left: 1px solid rgba(255, 255, 255, 0.10);
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 2px;
    margin-bottom: 4px;
  }

  .nav-sub-item {
    font-size: 11px;
    color: rgba(235, 235, 245, 0.50);
    padding: 3px 6px;
    border-radius: 5px;
    display: flex;
    justify-content: space-between;
  }

  .nav-sub-item.cloud-source {
    color: #7EE28E;
    background: rgba(50, 215, 75, 0.09);
  }

  /* Zone principale Books */
  .books-workspace {
    display: flex;
    flex-direction: column;
    background: var(--paper-bg);
    color: var(--paper-fg);
    position: relative;
  }

  /* Barre supérieure Books minimaliste */
  .books-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--paper-hairline);
    font-size: 12px;
  }

  .topbar-left, .topbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .book-crumb {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--paper-muted);
  }

  .book-crumb strong {
    color: var(--paper-fg);
    font-weight: var(--zr-poids-sans);
  }

  .tool-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: 7px;
    border: 1px solid var(--paper-hairline);
    background: transparent;
    color: var(--paper-fg);
    font-size: 11.5px;
  }

  .tool-pill.active-tool {
    background: var(--paper-fg);
    color: var(--paper-bg);
  }

  /* Bandeau Bibliothèque Create/Books (5 livres réels) */
  .create-shelf-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    padding: 10px 20px;
    background: var(--paper-elevated);
    border-bottom: 1px solid var(--paper-hairline);
  }

  .shelf-book {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 9px;
    border-radius: 8px;
    border: 1px solid transparent;
  }

  .shelf-book.reading {
    background: var(--paper-bg);
    border-color: var(--paper-hairline);
  }

  .book-spine {
    width: 24px;
    height: 34px;
    border-radius: 3px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--zr-police-serif);
    font-size: 10px;
    color: #FFFFFF;
  }

  .shelf-meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .shelf-title {
    font-size: 11.5px;
    color: var(--paper-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shelf-sub {
    font-size: 10.5px;
    color: var(--paper-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Corps de lecture : Double page (Design A) */
  .spread-stage {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    padding: var(--page-pad) 34px;
    gap: 32px;
    align-items: start;
  }

  .spread-divider {
    background: var(--paper-hairline);
    height: 100%;
  }

  .book-page {
    max-width: var(--book-measure);
    margin: 0 auto;
    font-family: var(--book-font-family);
    font-weight: var(--zr-poids-serif);
    font-size: var(--book-font-size);
    line-height: var(--book-line-height);
    color: var(--paper-fg);
  }

  .chapter-kicker {
    font-family: var(--zr-police-sans);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper-muted);
    margin-bottom: 6px;
  }

  .chapter-heading {
    font-family: var(--zr-police-serif);
    font-weight: var(--zr-poids-serif);
    font-size: calc(var(--book-font-size) * 1.42);
    line-height: 1.25;
    margin-bottom: 14px;
    color: var(--paper-fg);
  }

  .book-page p {
    margin-bottom: 12px;
    text-align: justify;
  }

  .hl-amber {
    background: rgba(245, 196, 66, 0.34);
    border-bottom: 1.5px solid rgba(217, 155, 22, 0.75);
    padding: 0 2px;
    border-radius: 2px;
  }

  .hl-green {
    background: rgba(82, 196, 112, 0.25);
    border-bottom: 1.5px solid rgba(46, 160, 78, 0.70);
    padding: 0 2px;
    border-radius: 2px;
  }

  .hl-blue {
    background: rgba(74, 158, 255, 0.24);
    border-bottom: 1.5px solid rgba(45, 126, 224, 0.70);
    padding: 0 2px;
    border-radius: 2px;
  }

  /* Popover Aa Typo flottant dans Design A */
  .aa-popover {
    margin-top: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    background: var(--paper-elevated);
    border: 1px solid var(--paper-hairline);
    font-family: var(--zr-police-sans);
    font-size: 11.5px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .aa-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .theme-dots {
    display: flex;
    gap: 6px;
  }

  .t-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.22);
    display: inline-block;
  }

  /* Pied de page de progression */
  .books-footer {
    padding: 9px 20px;
    border-top: 1px solid var(--paper-hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--paper-muted);
    gap: 14px;
  }

  .progress-track {
    flex: 1;
    height: 3px;
    background: var(--paper-hairline);
    border-radius: 999px;
    overflow: hidden;
    max-width: 360px;
  }

  .progress-fill {
    height: 100%;
    background: var(--paper-fg);
    border-radius: 999px;
  }

  /* Design B : Liseuse Focus Sans Chrome + Line Guide + Popover Sélection */
  .focus-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px 28px;
    position: relative;
  }

  .floating-hud-pill {
    position: absolute;
    top: 14px;
    right: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper-elevated);
    border: 1px solid var(--paper-hairline);
    font-size: 11.5px;
    color: var(--paper-fg);
  }

  .floating-book-pill {
    position: absolute;
    top: 14px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper-elevated);
    border: 1px solid var(--paper-hairline);
    font-size: 11.5px;
    color: var(--paper-muted);
  }

  .dimmed-paragraph {
    opacity: 0.34;
    transition: opacity 150ms ease;
  }

  .line-guide-active-box {
    padding: 10px 14px;
    margin: 6px -14px 12px;
    border-left: 2px solid var(--paper-fg);
    background: var(--paper-elevated);
    border-radius: 0 8px 8px 0;
  }

  .selection-toolbar {
    margin: 8px 0 14px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #17181C;
    color: #F4F4F6;
    font-family: var(--zr-police-sans);
    font-size: 11.5px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .sel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .swatch-row {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .hl-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    display: inline-block;
  }

  .dict-card {
    padding-top: 7px;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: rgba(235, 235, 245, 0.82);
    font-size: 11px;
  }

  /* Design C : Studio d'Étude Split-View */
  .split-study-stage {
    flex: 1;
    display: grid;
    grid-template-columns: 1.55fr 1px 1fr;
    align-items: stretch;
  }

  .study-reader-pane {
    padding: var(--page-pad) 32px;
  }

  .study-notes-pane {
    padding: 18px 20px;
    background: var(--paper-elevated);
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--zr-police-sans);
    font-size: 12px;
  }

  .study-tabs {
    display: flex;
    gap: 6px;
    border-bottom: 1px solid var(--paper-hairline);
    padding-bottom: 9px;
    flex-wrap: wrap;
  }

  .note-entry {
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--paper-bg);
    border: 1px solid var(--paper-hairline);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .note-quote {
    font-family: var(--zr-police-serif);
    font-size: 13px;
    color: var(--paper-fg);
  }

  .note-comment {
    font-size: 11.5px;
    color: var(--paper-muted);
  }

  .flashcard-preview {
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px dashed var(--paper-hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11.5px;
  }

  /* Tableau exhaustif des features Apple Books + Google Play Livres */
  .research-matrix {
    max-width: 1480px;
    margin: 26px auto 0;
    background: #141518;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 20px;
  }

  .matrix-title {
    font-family: var(--zr-police-serif);
    font-weight: var(--zr-poids-serif);
    font-size: 19px;
    margin-bottom: 12px;
    color: #F4F4F6;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }

  .matrix-table th, .matrix-table td {
    text-align: left;
    padding: 9px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    vertical-align: top;
  }

  .matrix-table th {
    color: rgba(235, 235, 245, 0.56);
    font-weight: var(--zr-poids-sans);
  }

  .code-path {
    font-family: var(--zr-police-mono);
    font-size: 11px;
    color: #9CDCFE;
  }
</style>
